{
  "name": "mmtvl-roku",
  "private": true,
  "description": "MMTVL Live TV for Roku (sideloaded in developer mode)",
  "license": "MIT",
  "scripts": {
    "build": "node tools/probe-assets.mjs && bsc --project bsconfig.json",
    "build:release": "node tools/roku.mjs build-release",
    "lint": "bslint --project bsconfig.json && bslint --project bsconfig.test.json && bslint --project bsconfig.local.json",
    "test:local": "node tools/roku.mjs test-local",
    "deploy": "node tools/roku.mjs deploy",
    "test": "node tools/roku.mjs test",
    "console": "node tools/roku.mjs console",
    "test:tools": "node --test tools/",
    "version": "node tools/roku.mjs version",
    "nightly": "node tools/roku.mjs nightly",
    "deploy:nightly": "node tools/roku.mjs deploy-nightly",
    "publish:nightly": "node tools/roku.mjs publish-nightly"
  },
  "devDependencies": {
    "@rokucommunity/bslint": "0.8.47",
    "brighterscript": "0.73.8",
    "brs-node": "2.7.0",
    "roku-deploy": "3.18.4",
    "rooibos-roku": "5.17.0"
  }
}
