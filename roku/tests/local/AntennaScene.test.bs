' The scene's antenna decisions, as pure functions (M12 step 21's QA fixes): the retry in place (D35), the player's
' content and refusal for each switch value (D24, D25), the merge off the render thread and its two keys (D37), the
' guide-file gates (D38, security L-1), the lineup answered before any download (D36), the run's leftovers
' (security L-2), a failed tuner's channels kept (D41) and the guide's settings (security L-3).
namespace AntennaSceneTests

    ' --- D35: the retry never changes the screen ---

    sub test_theRetryReplaysInPlaceAndNeverChangesTheScreen(t as object)
        current = { id: "antenna:5.1", url: "http://10.0.0.9:5004/auto/v5.1" }
        fresh = { id: "antenna:5.1", url: "http://10.0.0.12:5004/auto/v5.1" }
        retry = { id: "antenna:5.1", minSerial: 7 }
        for each screen in ["player", "guide"]
            t.assertEqual(PlayerSession.retryAction(retry, current, true, fresh, screen, 7), { replay: true, keep: false, channelID: "antenna:5.1", screen: "" }, screen)
        end for
        cases = [
            [invalid, current, true, fresh, "nothing to retry"],
            [retry, current, false, fresh, "it plays again by itself"],
            [retry, invalid, true, fresh, "nothing playing"],
            [retry, { id: "antenna:7.1" }, true, fresh, "another channel since"],
            [retry, current, true, invalid, "the lineup no longer has it"],
            [retry, current, true, { id: "antenna:7.1" }, "another channel's copy"]
        ]
        for each item in cases
            made = PlayerSession.retryAction(item[0], item[1], item[2], item[3], "guide", 9)
            t.assertFalse(made.replay, item[4])
            t.assertFalse(made.keep, item[4])
            t.assertEqual(made.screen, "", item[4])
        end for
    end sub

    ' D43: a lineup answer from a run that started before the diagnosis (its search can't have seen the new address)
    ' keeps the retry waiting, and doesn't use it up; the run asked for, or a later one, retries.
    sub test_theRetryWaitsForTheRunItAskedFor(t as object)
        current = { id: "antenna:5.1" }
        fresh = { id: "antenna:5.1" }
        retry = { id: "antenna:5.1", minSerial: 7 }
        older = PlayerSession.retryAction(retry, current, true, fresh, "player", 6)
        t.assertFalse(older.replay)
        t.assertTrue(older.keep)
        t.assertTrue(PlayerSession.retryAction(retry, current, true, invalid, "player", 6).keep, "even when the old run's lineup lacks it")
        t.assertTrue(PlayerSession.retryAction(retry, current, true, fresh, "player", 7).replay)
        t.assertTrue(PlayerSession.retryAction(retry, current, true, fresh, "player", 8).replay)
    end sub

    ' D44: under Settings the retry waits (no unprompted audio behind Settings); closeSettings runs it.
    sub test_theRetryWaitsWhileSettingsShows(t as object)
        current = { id: "antenna:5.1" }
        fresh = { id: "antenna:5.1" }
        retry = { id: "antenna:5.1", minSerial: 7 }
        underSettings = PlayerSession.retryAction(retry, current, true, fresh, "settings", 7)
        t.assertFalse(underSettings.replay)
        t.assertTrue(underSettings.keep)
        t.assertEqual(underSettings.screen, "")
        ' closeSettings passes the retry's own minSerial, on the screen it returned to.
        t.assertTrue(PlayerSession.retryAction(retry, current, true, fresh, "guide", retry.minSerial).replay)
        t.assertFalse(PlayerSession.retryAction(retry, { id: "antenna:7.1" }, true, fresh, "guide", retry.minSerial).keep, "another channel by then: dropped")
    end sub

    ' Round 2: what follows a PlaylistTask that ended or was given up, and a stopped one.
    sub test_aMergeThatWaitedStartsAfterAnyTaskEnds(t as object)
        t.assertEqual(Lineup.afterTask(true, 3, 3, false), "merge", "the watchdog with a merge pending: a merge starts")
        t.assertEqual(Lineup.afterTask(false, 2, 3, true), "merge", "a newer antenna part than the task had")
        t.assertEqual(Lineup.afterTask(false, -1, 3, false), "merge", "after a stopped merge")
        t.assertEqual(Lineup.afterTask(false, 3, 3, true), "load")
        t.assertEqual(Lineup.afterTask(false, 3, 3, false), "")
        t.assertTrue(Lineup.launchWaits(true, false))
        t.assertTrue(Lineup.launchWaits(false, true))
        t.assertFalse(Lineup.launchWaits(false, false))
        ' A stop clears the pending merge (the launch never waits for one that won't come).
        t.assertEqual(Lineup.afterStop(false, 3), { mergePending: false, taskRevision: 3 })
        t.assertEqual(Lineup.afterStop(true, 3), { mergePending: false, taskRevision: -1 })
        t.assertFalse(Lineup.launchWaits(false, Lineup.afterStop(true, 3).mergePending))
    end sub

    ' --- D24, D25: the player's content for each switch value ---

    sub test_antennaContentFollowsTheSwitches(t as object)
        antenna = { id: "antenna:5.1", antenna: true }
        t.assertEqual(PlayerSession.antennaContent(antenna, { playRawTS: true, streamFormat: "" }), { refusal: "", streamFormat: "", certificates: false }, "D25's default: unset")
        t.assertEqual(PlayerSession.antennaContent(antenna, { playRawTS: true, streamFormat: "mkv" }), { refusal: "", streamFormat: "mkv", certificates: false })
        t.assertEqual(PlayerSession.antennaContent(antenna, { playRawTS: false, streamFormat: "" }).refusal, "This Roku can't play antenna channels", "D24 off")
        ' Playlist channels: HLS with the CA bundle, whatever the switches.
        playlist = { id: "name:news" }
        t.assertEqual(PlayerSession.antennaContent(playlist, { playRawTS: false, streamFormat: "mkv" }), { refusal: "", streamFormat: "hls", certificates: true })
        ' The scene's refusal (every tuner held) comes first.
        held = { id: "antenna:5.1", antenna: true, refusal: "Both antenna tuners are in use" }
        t.assertEqual(PlayerSession.antennaContent(held, { playRawTS: false, streamFormat: "" }).refusal, "Both antenna tuners are in use")
    end sub

    ' --- D37: the merge and its keys ---

    sub test_theMergePutsTheAntennaAfterThePlaylist(t as object)
        playlist = { channels: [{ id: "id:a", number: 1 }, { id: "id:b", number: 2 }], matchFields: [{ id: "id:a" }, { id: "id:b" }], teamFields: [{ id: "id:a" }, { id: "id:b" }] }
        antenna = { channels: [{ id: "antenna:5.1", number: 1 }], matchFields: [{ id: "antenna:5.1" }], teamFields: [{ id: "antenna:5.1" }] }
        merged = Lineup.mergeParts(playlist, antenna)
        t.assertEqual(merged.playlistCount, 2)
        t.assertEqual(AntennaSceneTests.ids(merged.channels), ["id:a", "id:b", "antenna:5.1"])
        t.assertEqual(merged.channels[2].number, 3, "numbered after the playlist's")
        t.assertEqual(antenna.channels[0].number, 1, "the antenna part isn't changed")
        t.assertEqual(AntennaSceneTests.ids(merged.matchFields), ["id:a", "id:b", "antenna:5.1"])
        t.assertEqual(AntennaSceneTests.ids(merged.teamFields), ["id:a", "id:b", "antenna:5.1"])
        ' A merge-only run takes the playlist's part back out of the merged lists.
        part = Lineup.playlistPart(merged, merged.playlistCount)
        t.assertEqual(AntennaSceneTests.ids(part.channels), ["id:a", "id:b"])
        t.assertEqual(AntennaSceneTests.ids(part.matchFields), ["id:a", "id:b"])
        again = Lineup.mergeParts(part, { channels: [{ id: "antenna:7.1" }] })
        t.assertEqual(AntennaSceneTests.ids(again.channels), ["id:a", "id:b", "antenna:7.1"])
        t.assertEqual(Lineup.mergeParts({}, antenna).playlistCount, 0)
        t.assertEqual(Lineup.mergeParts(invalid, invalid).channels, [])
        t.assertEqual(Lineup.playlistPart(merged, 99).channels.Count(), 3, "a count past the end")
    end sub

    ' A tuner's new address (or tuner count) merges, without a rematch; a new channel or name also rematches.
    sub test_aNewURLMergesWithoutARematch(t as object)
        before = [AntennaSceneTests.channel("5.1", "WAGA-HD", "10.0.0.9", 2)]
        moved = [AntennaSceneTests.channel("5.1", "WAGA-HD", "10.0.0.12", 2)]
        old = AntennaLineup.setKeys(before)
        t.assertEqual(Lineup.antennaChange(old, AntennaLineup.setKeys(moved)), { merge: true, rematch: false }, "a new address")
        t.assertEqual(Lineup.antennaChange(old, AntennaLineup.setKeys([AntennaSceneTests.channel("5.1", "WAGA-HD", "10.0.0.9", 4)])), { merge: true, rematch: false }, "a new tuner count")
        t.assertEqual(Lineup.antennaChange(old, AntennaLineup.setKeys(before)), { merge: false, rematch: false }, "the same")
        renamed = [AntennaSceneTests.channel("5.1", "FOX 5", "10.0.0.9", 2)]
        t.assertEqual(Lineup.antennaChange(old, AntennaLineup.setKeys(renamed)), { merge: true, rematch: true })
        t.assertEqual(Lineup.antennaChange({ matchKey: "", payloadKey: "" }, AntennaLineup.setKeys([])), { merge: false, rematch: false }, "none before, none now")
        t.assertEqual(Len(old.matchKey), 40)
        t.assertEqual(Instr(1, old.payloadKey, "10.0.0.9"), 0, "a hash, not the address")
    end sub

    ' --- D38, security L-1: the guide file's gates ---

    sub test_guideRunsWaitForAnAntennaTaskThatMayWriteTheGuide(t as object)
        t.assertTrue(GuideRuns.antennaBusy(true, invalid), "downloading")
        t.assertFalse(GuideRuns.antennaBusy(false, invalid))
        t.assertTrue(GuideRuns.antennaBusy(false, { alive: true, wantedGuide: true }), "given up on, still alive, asked for the guide")
        t.assertFalse(GuideRuns.antennaBusy(false, { alive: false, wantedGuide: true }), "stopped")
        t.assertFalse(GuideRuns.antennaBusy(false, { alive: true, wantedGuide: false }), "never asked for the guide")
        t.assertTrue(GuideRuns.antennaMayDownload(false, false, invalid))
        t.assertFalse(GuideRuns.antennaMayDownload(true, false, invalid), "a guide run reads the file")
        t.assertFalse(GuideRuns.antennaMayDownload(false, true, invalid), "a guide run given up on")
        t.assertFalse(GuideRuns.antennaMayDownload(false, false, { alive: true, wantedGuide: false }), "an antenna task given up on")
        t.assertTrue(GuideRuns.antennaMayDownload(false, false, { alive: false, wantedGuide: true }))
    end sub

    ' --- D36: the lineup first; security L-2: the leftovers ---

    sub test_theLineupAnswersBeforeTheGuideDownloads(t as object)
        io = AntennaSceneTests.network()
        sink = AntennaSceneTests.recorder(io)
        finished = AntennaLineup.refreshRun(io, AntennaSceneTests.config(), { typed: "10.0.0.9", mpeg2: true, guide: true, manual: false, guideHours: 36, previous: [] }, sink)
        t.assertTrue(finished)
        t.assertEqual(io.events, ["lineup", "download", "done", "cleanup+part"], "the .part only after this run's download")
        t.assertEqual(sink.answer.channels.Count(), 1)
        t.assertEqual(sink.answer.devices, [{ name: "HDHomeRun CONNECT", model: "HDHR4-2US", tunerCount: 2, channelCount: 1 }])
        t.assertEqual(Len(sink.answer.payloadKey), 40)
        t.assertTrue(sink.guide.ok, "the download got the run's tuners and the guide window")
        ' Not due: no download, the run still ends.
        io = AntennaSceneTests.network()
        io.files = { hasFile: true, time: io.clock - 7200, due: io.clock + 3600 }
        AntennaLineup.refreshRun(io, AntennaSceneTests.config(), { typed: "10.0.0.9", guide: true, manual: false, previous: [] }, AntennaSceneTests.recorder(io))
        t.assertEqual(io.events, ["lineup", "done", "cleanup"])
        ' No guide asked for: none.
        io = AntennaSceneTests.network()
        AntennaLineup.refreshRun(io, AntennaSceneTests.config(), { typed: "10.0.0.9", guide: false, previous: [] }, AntennaSceneTests.recorder(io))
        t.assertEqual(io.events, ["lineup", "done", "cleanup"])
    end sub

    ' A crash part way (after a discover.json body was written) still cleans up and answers.
    sub test_aCrashStillDeletesTheRunsLeftovers(t as object)
        io = AntennaSceneTests.network()
        io.throwOnLineup = true
        sink = AntennaSceneTests.recorder(io)
        finished = AntennaLineup.refreshRun(io, AntennaSceneTests.config(), { typed: "10.0.0.9", guide: true, previous: [] }, sink)
        t.assertFalse(finished)
        t.assertEqual(io.events, ["failed", "cleanup"], "no download: the shared .part is left alone")
        t.assertEqual(io.written, {}, "the body the fake wrote is gone")
    end sub

    ' D41 (MMTVL's AntennaSource): a tuner that answered but whose lineup.json couldn't be read keeps its channels.
    sub test_aTunerWhoseLineupFailsKeepsItsChannels(t as object)
        previous = [AntennaSceneTests.channel("5.1", "WAGA-HD", "10.0.0.9", 2), AntennaSceneTests.channel("7.1", "WSB", "10.0.0.11", 2)]
        io = AntennaSceneTests.network()
        io.lineupText = invalid
        sink = AntennaSceneTests.recorder(io)
        AntennaLineup.refreshRun(io, AntennaSceneTests.config(), { typed: "10.0.0.9", guide: false, previous: previous }, sink)
        t.assertEqual(AntennaSceneTests.ids(sink.answer.channels), ["antenna:5.1"], "its own channels only, not another tuner's")
        t.assertEqual(sink.answer.lineupFailed, 1)
        t.assertEqual(sink.answer.devices[0].channelCount, 1)
        ' A readable lineup's channel wins over a kept one; the result is in number order.
        kept = AntennaLineup.withKept([AntennaSceneTests.channel("2.1", "NEW", "10.0.0.11", 2), AntennaSceneTests.channel("5.1", "FRESH", "10.0.0.11", 2)], previous, ["10.0.0.9"], 1)
        t.assertEqual(kept.kept, 0, "5.1 came from a readable lineup")
        kept = AntennaLineup.withKept([AntennaSceneTests.channel("9.1", "NEW", "10.0.0.11", 2)], previous, ["10.0.0.9"], 1)
        t.assertEqual(AntennaSceneTests.ids(kept.channels), ["antenna:5.1", "antenna:9.1"])
        t.assertEqual(kept.channels[1].number, 2)
        t.assertEqual(AntennaLineup.withKept([], previous, [], 1).channels, [], "nothing failed")
    end sub

    ' D40: a channel whose lineup entry names no codec says so, for the MPEG-2 hint.
    sub test_anUnlabelledCodecIsMarked(t as object)
        entries = [{ guideNumber: "5.1", guideName: "A", videoCodec: "H264", url: "http://10.0.0.9:5004/auto/v5.1", tags: [] }, { guideNumber: "5.2", guideName: "B", videoCodec: invalid, url: "http://10.0.0.9:5004/auto/v5.2", tags: [] }]
        made = AntennaLineup.channels([{ device: AntennaSceneTests.device(), entries: entries }], 1).channels
        t.assertFalse(made[0].codecUnknown)
        t.assertTrue(made[1].codecUnknown)
    end sub

    ' --- security L-3: the guide gets only what it reads ---

    sub test_theGuidesSettingsNeverCarryTheTunerAddress(t as object)
        settings = SettingsStore.defaultSettings()
        settings.antennaAddress = "192.168.1.20"
        settings.channelLogos = false
        t.assertEqual(SettingsStore.guideSettings(settings), { channelLogos: false })
        t.assertEqual(SettingsStore.guideSettings(invalid), { channelLogos: true })
        t.assertEqual(Instr(1, FormatJson(SettingsStore.guideSettings(settings)), "192.168"), 0)
    end sub

    ' --- helpers ---

    function channel(number as string, name as string, host as string, tuners as integer) as object
        return { id: "antenna:" + number, number: 1, name: name, group: "Antenna", url: "http://" + host + ":5004/auto/v" + number, source: "antenna", guideNumber: number, tunerCount: tuners, codecUnknown: false }
    end function

    function device() as object
        return { id: "1234ABCD", name: "HDHomeRun CONNECT", model: "HDHR4-2US", tunerCount: 2, host: "10.0.0.9", baseURL: "http://10.0.0.9", lineupURL: "http://10.0.0.9/lineup.json" }
    end function

    function config() as object
        return { broadcast: false, byName: false, nameNeedsPeer: true }
    end function

    ' A fake io: a tuner at 10.0.0.9 (the runs type its address, so no broadcast is needed); its get writes a fake
    ' "body" that cleanup must remove; events records the order of the run's steps.
    function network() as object
        q = Chr(34)
        return {
            events: [], written: {}, clock: 1791200000, files: { hasFile: false }, throwOnLineup: false,
            lineupText: "[{" + q + "GuideNumber" + q + ":" + q + "5.1" + q + "," + q + "GuideName" + q + ":" + q + "WAGA-HD" + q + "," + q + "URL" + q + ":" + q + "http://10.0.0.9:5004/auto/v5.1" + q + "}]",
            ownAddresses: function() as object
                return ["10.0.0.2"]
            end function,
            broadcast: function(requestHex as string, targets as object, waitMs as integer) as object
                m.events.Push("broadcast " + requestHex + " " + targets.Count().ToStr() + " " + waitMs.ToStr())
                return []
            end function,
            get: function(url as string, maxBytes as dynamic, timeoutMs as dynamic) as object
                m.written["tmp:/body"] = url + " " + FormatJson([maxBytes, timeoutMs])
                if url = "http://10.0.0.9/discover.json"
                    return { ok: true, code: 200, peer: "", text: FormatJson({ FriendlyName: "HDHomeRun CONNECT", ModelNumber: "HDHR4-2US", DeviceID: "1234ABCD", DeviceAuth: "FAKEauthONE1111", BaseURL: "http://10.0.0.9", LineupURL: "http://10.0.0.9/lineup.json", TunerCount: 2 }) }
                end if
                if url = "http://10.0.0.9/lineup.json"
                    if m.throwOnLineup then throw "crash"
                    if m.lineupText = invalid then return { ok: false, code: 500, peer: "", text: "" }
                    return { ok: true, code: 200, peer: "", text: m.lineupText }
                end if
                return { ok: false, code: 0, peer: "", text: "" }
            end function,
            now: function() as dynamic
                return m.clock
            end function,
            guideFiles: function() as object
                return m.files
            end function,
            downloadGuide: function(devices as object, hours as dynamic) as object
                m.events.Push("download")
                return { ran: true, ok: devices.Count() = 1 and hours = 36, message: "" }
            end function,
            cleanup: sub(downloaded as boolean)
                m.written = {}
                if downloaded then m.events.Push("cleanup+part") else m.events.Push("cleanup")
            end sub,
            log: sub(level as string, text as string)
                m.lastLog = level + ": " + text
            end sub
        }
    end function

    ' What AntennaTask's sink does, recorded.
    function recorder(io as object) as object
        return {
            io: io, answer: invalid, guide: invalid,
            lineup: sub(answer as object)
                m.answer = answer
                m.io.events.Push("lineup")
            end sub,
            done: sub(guide as object)
                m.guide = guide
                m.io.events.Push("done")
            end sub,
            failed: sub()
                m.io.events.Push("failed")
            end sub
        }
    end function

    function ids(list as object) as object
        result = []
        for each item in list
            result.Push(item.id)
        end for
        return result
    end function

end namespace
