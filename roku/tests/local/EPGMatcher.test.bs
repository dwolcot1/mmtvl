' MMTVL's EPGMatcherTests (MMTVLTests/EPGMatcherTests.swift), the 14 cases, plus the fold table checked against
' MMTVL's own normalize (support/EPGFoldFixtures.bs, generated by tools/gen-epg-fold.swift).
namespace EPGMatcherTests

    sub test_normalization(t as object)
        t.assertEqual(EPGMatcher.normalize("FanDuel Sports Network Detroit HD"), EPGMatcher.normalize("FanDuel Sports Network Detroit"))
        t.assertEqual(EPGMatcher.normalize("Tel" + Chr(233) + " 5"), EPGMatcher.normalize("Tele 5"))
        t.assertEqual(EPGMatcher.normalize("A&E"), EPGMatcher.normalize("A and E"))
        t.assertEqual(EPGMatcher.normalize("NBC Sports Bay Area+"), EPGMatcher.normalize("NBC Sports Bay Area Plus"))
        t.assertTrue(EPGMatcher.normalize("NBC Sports Bay Area+") <> EPGMatcher.normalize("NBC Sports Bay Area HD"), "plus isn't HD")
    end sub

    sub test_idMatchIgnoresCase(t as object)
        nba = EPGMatcherTests.channel("NBA TV", "NBATV.us", invalid)
        result = EPGMatcher.matchOne([nba], [EPGMatcherTests.epg("nbatv.us", ["Something else"])], {})
        t.assertEqual(result, EPGMatcherTests.pairs([nba.id, "nbatv.us"]))
    end sub

    sub test_nameFallbackWhenIDDoesNotMatch(t as object)
        nfl = EPGMatcherTests.channel("NFL Network", "nflnetwork.us", "NFL Network")
        result = EPGMatcher.matchOne([nfl], [EPGMatcherTests.epg("NFL.Network.HD.us2", ["NFL Network HD"])], {})
        t.assertEqual(result, EPGMatcherTests.pairs([nfl.id, "nfl.network.hd.us2"]))
    end sub

    sub test_noMatchIsAbsent(t as object)
        result = EPGMatcher.matchOne([EPGMatcherTests.channel("FanDuel Sports Network Indiana", invalid, invalid)], [EPGMatcherTests.epg("x", ["ESPN"])], {})
        t.assertEqual(result.Count(), 0)
    end sub

    sub test_firstEPGChannelWithTheSameNameWins(t as object)
        espn = EPGMatcherTests.channel("ESPN", invalid, invalid)
        result = EPGMatcher.matchOne([espn], [EPGMatcherTests.epg("ESPN.first", ["ESPN"]), EPGMatcherTests.epg("ESPN.second", ["ESPN HD"])], {})
        t.assertEqual(result, EPGMatcherTests.pairs([espn.id, "espn.first"]))
    end sub

    sub test_plusAndAmpersand(t as object)
        plus = EPGMatcherTests.channel("NBC Sports Bay Area+", invalid, invalid)
        ae = EPGMatcherTests.channel("A&E", invalid, invalid)
        result = EPGMatcher.matchOne([plus, ae], [
            EPGMatcherTests.epg("NBC.Sports.Bay.Area.HD.us2", ["NBC Sports Bay Area HD"]),
            EPGMatcherTests.epg("NBC.Sports.Bay.Area.Plus.us2", ["NBC Sports Bay Area Plus"]),
            EPGMatcherTests.epg("AE.us2", ["A and E"])
        ], {})
        t.assertEqual(result[plus.id], "nbc.sports.bay.area.plus.us2")
        t.assertEqual(result[ae.id], "ae.us2")
    end sub

    sub test_overrides(t as object)
        guide = [
            EPGMatcherTests.epg("nbatv.us", ["NBA TV"]),
            EPGMatcherTests.epg("Marquee.Sports.Network.HD.us2", ["Marquee Sports Network HD"]),
            EPGMatcherTests.epg("CBS.Sports.Network.HD.us2", ["CBS Sports Network HD"]),
            EPGMatcherTests.epg("CBS.News.us", ["CBS"])
        ]
        ' A name key wins over a tvg-id match.
        nba = EPGMatcherTests.channel("NBA TV", "nbatv.us", invalid)
        t.assertEqual(EPGMatcher.matchOne([nba], guide, EPGMatcherTests.pairs(["NBA TV", "marquee.sports.network.hd.us2"]))[nba.id], "marquee.sports.network.hd.us2", "name key")

        ' A tvg-id key works; keys and values are case-insensitive.
        cbs = EPGMatcherTests.channel("CBS", "cbssportsnetworkusa.us", invalid)
        t.assertEqual(EPGMatcher.matchOne([cbs], guide, EPGMatcherTests.pairs(["CBSSPORTSNETWORKUSA.US", "CBS.Sports.Network.HD.us2"]))[cbs.id], "cbs.sports.network.hd.us2", "tvg-id key")
        marquee = EPGMatcherTests.channel("Marquee Network", invalid, invalid)
        t.assertEqual(EPGMatcher.matchOne([marquee], guide, EPGMatcherTests.pairs(["marquee NETWORK", "MARQUEE.Sports.Network.HD.US2"]))[marquee.id], "marquee.sports.network.hd.us2", "any case")

        ' A target missing from the guide falls through to the normal rules.
        t.assertEqual(EPGMatcher.matchOne([nba], guide, EPGMatcherTests.pairs(["NBA TV", "Gone.us2"]))[nba.id], "nbatv.us", "missing target")
    end sub

    sub test_noFuzzyMatching(t as object)
        redZone = EPGMatcherTests.channel("Red Zone", invalid, invalid)
        cbs = EPGMatcherTests.channel("CBS", invalid, invalid)
        result = EPGMatcher.matchOne([redZone, cbs], [EPGMatcherTests.epg("Red.TV.rs", ["Red TV"]), EPGMatcherTests.epg("CBS.News.us", ["CBS News"])], {})
        t.assertInvalid(result[redZone.id], "Red Zone")
        t.assertInvalid(result[cbs.id], "CBS")
    end sub

    ' --- Several guides (M6b L3) ---

    sub test_emptyOverrideMeansNoGuide(t as object)
        nba = EPGMatcherTests.channel("NBA TV", "nbatv.us", invalid)
        guide = [EPGMatcherTests.epg("nbatv.us", ["NBA TV"])]
        t.assertEqual(EPGMatcher.matchOne([nba], guide, EPGMatcherTests.pairs(["NBA TV", ""])).Count(), 0, "by name")
        t.assertEqual(EPGMatcher.matchOne([nba], guide, EPGMatcherTests.pairs(["NBATV.us", ""])).Count(), 0, "by tvg-id")
    end sub

    sub test_idInALowerGuideBeatsANameInAHigherOne(t as object)
        nba = EPGMatcherTests.channel("NBA TV", "nbatv.us", invalid)
        result = EPGMatcher.match([nba], [
            EPGMatcherTests.source("one", [EPGMatcherTests.epg("NBA.TV.HD.us2", ["NBA TV"])]),
            EPGMatcherTests.source("two", [EPGMatcherTests.epg("nbatv.us", ["Something"])])
        ], {})
        t.assertEqual(result[nba.id], { guide: 1, sourceID: "two", epgID: "nbatv.us" })
    end sub

    sub test_sameRuleHigherGuideWins(t as object)
        espn = EPGMatcherTests.channel("ESPN", invalid, invalid)
        byName = EPGMatcher.match([espn], [EPGMatcherTests.source("one", [EPGMatcherTests.epg("ESPN.one", ["ESPN"])]), EPGMatcherTests.source("two", [EPGMatcherTests.epg("ESPN.two", ["ESPN"])])], {})
        t.assertEqual(byName[espn.id], { guide: 0, sourceID: "one", epgID: "espn.one" }, "by name")

        nba = EPGMatcherTests.channel("NBA TV", "nbatv.us", invalid)
        byID = EPGMatcher.match([nba], [EPGMatcherTests.source("one", [EPGMatcherTests.epg("nbatv.us", [])]), EPGMatcherTests.source("two", [EPGMatcherTests.epg("nbatv.us", [])])], {})
        t.assertEqual(byID[nba.id], { guide: 0, sourceID: "one", epgID: "nbatv.us" }, "by id")
    end sub

    sub test_overrideTargetInTheSecondGuide(t as object)
        redZone = EPGMatcherTests.channel("Red Zone", invalid, invalid)
        result = EPGMatcher.match([redZone], [
            EPGMatcherTests.source("one", [EPGMatcherTests.epg("ESPN.one", ["ESPN"])]),
            EPGMatcherTests.source("two", [EPGMatcherTests.epg("NFL.RedZone.us", ["NFL RedZone"])])
        ], EPGMatcherTests.pairs(["Red Zone", "NFL.RedZone.us"]))
        t.assertEqual(result[redZone.id], { guide: 1, sourceID: "two", epgID: "nfl.redzone.us" })
    end sub

    sub test_tokens(t as object)
        t.assertEqual(EPGMatcher.tokens("NBC Sports Bay Area+ HD"), ["nbc", "sports", "bay", "area", "plus"])
        t.assertEqual(EPGMatcher.tokens("NBA TV TV"), ["nba", "tv"])
        t.assertEqual(EPGMatcher.normalize("NBA TV TV"), "nbatvtv")
    end sub

    ' --- M7j L12 ---

    ' An antenna channel's override is under its id ("antenna:5.1"), which wins over one under its name (names
    ' repeat on the tuner); a playlist channel's key is its name, as before.
    sub test_overrideKeyComesBeforeName(t as object)
        antenna = { id: "antenna:5.1", number: 9, name: "WYGA-CD", group: "Antenna", tvgID: invalid, tvgName: invalid }
        other = { id: "antenna:26.1", number: 10, name: "WYGA-CD", group: "Antenna", tvgID: invalid, tvgName: invalid }
        guide = [EPGMatcherTests.epg("by.id", ["Something"]), EPGMatcherTests.epg("by.name", ["Else"])]
        overrides = EPGMatcherTests.pairs(["ANTENNA:5.1", "BY.ID", "wyga-cd", "by.name"])
        result = EPGMatcher.matchOne([antenna, other], guide, overrides)
        t.assertEqual(result, EPGMatcherTests.pairs([antenna.id, "by.id", other.id, "by.name"]))

        playlist = EPGMatcherTests.channel("NBA TV", "nbatv.us", invalid)
        t.assertEqual(EPGMatcher.overrideKey(playlist), "NBA TV")
        t.assertEqual(EPGMatcher.matchOne([playlist], guide, EPGMatcherTests.pairs(["nba tv", "by.id"])), EPGMatcherTests.pairs([playlist.id, "by.id"]))
    end sub

    ' --- Beyond the Swift cases ---

    ' Diacritics, ß, ligatures and non-Latin letters fold as Foundation folds them; punctuation outside ASCII
    ' separates.
    sub test_foldsLikeFoundation(t as object)
        t.assertEqual(EPGMatcher.normalize(Chr(209) + "and" + Chr(250) + " Deportes UHD"), "nandudeportes", "Ñandú")
        t.assertEqual(EPGMatcher.normalize("Stra" + Chr(223) + "e 4K"), "strasse", "ß")
        t.assertEqual(EPGMatcher.normalize("Mom" + Chr(8217) + "s " + Chr(8212) + " TV"), "momstv", "curly apostrophe and dash")
        t.assertEqual(EPGMatcher.normalize(Chr(64257) + "lm"), "film", "fi ligature")
        t.assertEqual(EPGMatcher.normalize(Chr(1056) + Chr(1054) + Chr(1057) + Chr(1057) + Chr(1048) + Chr(1071) + " 1"), Chr(1088) + Chr(1086) + Chr(1089) + Chr(1089) + Chr(1080) + Chr(1103) + "1", "Cyrillic")
        t.assertEqual(EPGMatcher.normalize("e" + Chr(769) + "t" + Chr(233)), "ete", "a combining accent")
        t.assertEqual(EPGMatcher.normalize("HD | FHD | 4K"), "", "only dropped words")
        t.assertEqual(EPGMatcher.normalize("hd4k"), "hd4k", "dropped only as whole words")
    end sub

    ' normalize("x" + c + "y") for every sampled code point equals MMTVL's (support/EPGFoldFixtures.bs).
    sub test_foldTableMatchesMMTVLsNormalize(t as object)
        expected = {}
        table = EPGFoldFixtures.expected()
        cursor = 1
        while cursor <= Len(table)
            code = Val(Mid(table, cursor, 4), 16)
            count = Val(Mid(table, cursor + 4, 1), 10)
            out = ""
            for i = 0 to count - 1
                out += Chr(Val(Mid(table, cursor + 5 + i * 4, 4), 16))
            end for
            expected[code.ToStr()] = out
            cursor += 5 + count * 4
        end while
        skipped = {}
        contextual = EPGFoldFixtures.contextual()
        for i = 1 to Len(contextual) step 4
            skipped[Val(Mid(contextual, i, 4), 16).ToStr()] = true
        end for
        n = EPGMatcher.newNormalizer()
        checked = 0
        wrong = []
        for code = 128 to 65535
            if EPGMatcherTests.isSample(code) and not skipped.DoesExist(code.ToStr())
                want = expected[code.ToStr()]
                if want = invalid then want = Chr(code)
                got = EPGMatcher.normalize("x" + Chr(code) + "y", n)
                if got <> "x" + want + "y" and wrong.Count() < 10 then wrong.Push("U+" + EPGMatcherTests.hex(code) + ": " + got)
                checked++
            end if
        end for
        t.assertEqual(wrong, [], "differences")
        t.assertTrue(checked > 10000, "checked " + checked.ToStr())
    end sub

    ' --- Helpers ---

    ' As the generator samples: U+0080–U+052F, U+1E00–U+1EFF, every 7th elsewhere, no surrogates.
    function isSample(code as integer) as boolean
        if code >= 55296 and code <= 57343 then return false
        return code <= 1327 or (code >= 7680 and code <= 7935) or code mod 7 = 0
    end function

    function hex(code as integer) as string
        text = StrI(code, 16)
        while Len(text) < 4
            text = "0" + text
        end while
        return UCase(text)
    end function

    ' MMTVL's test channel: id "name:" + the lowercased name.
    function channel(name as string, tvgID as dynamic, tvgName as dynamic) as object
        return { id: "name:" + Unicode.lower(name), number: 1, name: name, group: "G", tvgID: tvgID, tvgName: tvgName, url: "https://cdn/x.m3u8" }
    end function

    function epg(id as string, names as object) as object
        return { id: Unicode.lower(id), names: names }
    end function

    function source(sourceID as string, channels as object) as object
        return { sourceID: sourceID, channels: channels }
    end function

    ' A case-sensitive AA from [key, value, key, value, …].
    function pairs(items as object) as object
        result = {}
        result.SetModeCaseSensitive()
        for i = 0 to items.Count() - 1 step 2
            result[items[i]] = items[i + 1]
        end for
        return result
    end function

end namespace
