' Settings' pages (M12 step 13): SettingsStatus.make and SettingsPages, ported from MMTVL's SettingsModelTests where
' they apply (rootListsCategories, pageWithoutPlaylistOnlyPastes, pageWithPlaylistAndTwoGuides, playlistGuideIsAnInfoRow,
' guideSourceRowOnlyWithAChoice, unusedPastedGuideIsOffAndKeepsItsPage, noGuideExplainsHowToAddOne, noAddRowAtTheLimit,
' channelsSection, groupsPage, hiddenChannelsPage, guidePage, removeConfirmFocusesCancelFirst,
' channelUpRowTogglesTheDirection, aboutShowsTheVersionAndBuild), plus the Roku's Device page (L7), the registry
' warning (L5) and the URL display rule (M6b L2: never a whole URL). Off-device.
namespace SettingsPageTests

    ' --- the root ---

    sub test_rootListsTheCategories(t as object)
        model = SettingsStatus.make(SettingsPageTests.fixture({}))
        list = SettingsPages.sections("root", model)
        t.assertEqual(SettingsPages.actionIDs(list), ["liveTV", "remoteInput", "device", "import", "about"])
        liveTV = SettingsPages.rowWithID(list, "liveTV")
        t.assertEqual(liveTV.value, "3 Channels")
        t.assertTrue(liveTV.disclosure)
        t.assertEqual(liveTV.action, { type: "push", page: "liveTV" })
        t.assertEqual(liveTV.description, "The playlist, antenna and guides, channel groups, hidden channels and teams.", "the frame's text")
        t.assertEqual(SettingsPages.rowWithID(list, "device").value, "Roku Express")
        t.assertEqual(SettingsPages.rowWithID(list, "about").value, "1.0")
        t.assertEqual(SettingsPages.rowWithID(list, "remoteInput").value, "")
        t.assertEqual(SettingsPages.pageTitle("root", model), "Settings")
        for each id in SettingsPages.actionIDs(list)
            t.assertTrue(SettingsPages.description(list, id) <> "", id + " has a description")
        end for
    end sub

    sub test_rootSaysNotSetUpWithoutAPlaylist(t as object)
        input = SettingsPageTests.fixture({})
        input.store.source = ""
        input.channels = []
        model = SettingsStatus.make(input)
        t.assertEqual(SettingsPages.rowWithID(SettingsPages.sections("root", model), "liveTV").value, "Not Set Up")
        input = SettingsPageTests.fixture({})
        input.channels = [SettingsPageTests.channel("id:a", 1, "A", "News")]
        t.assertEqual(SettingsPages.rowWithID(SettingsPages.sections("root", SettingsStatus.make(input)), "liveTV").value, "1 Channel")
    end sub

    ' --- Live TV ---

    ' MMTVL's pageWithoutPlaylistOnlyPastes (with the antenna off, as there): the keyboard row and the Antenna row,
    ' so the antenna can be turned back on.
    sub test_pageWithoutPlaylistOnlyHasTheKeyboardRow(t as object)
        input = SettingsPageTests.fixture({})
        input.store.source = ""
        input.store.guides = []
        input.store.settings.antennaEnabled = false
        input.channels = []
        input.antenna = { enabled: false }
        list = SettingsPages.sections("liveTV", SettingsStatus.make(input))
        t.assertEqual(SettingsPages.actionIDs(list), ["playlist.edit", "antenna"])
        t.assertEqual(SettingsPages.rowWithID(list, "antenna").value, "Off")
        edit = SettingsPages.rowWithID(list, "playlist.edit")
        t.assertEqual(edit.title, "Add Playlist URL…")
        t.assertEqual(edit.detail, "Type the M3U address on the Roku's keyboard")
        t.assertEqual(edit.action, { type: "editURL", field: "playlist" })
        t.assertInvalid(SettingsPages.rowWithID(list, "playlist.info"))
        t.assertInvalid(SettingsPages.rowWithID(list, "guide.add"), "no guides without a source")
    end sub

    sub test_pageWithPlaylistAndTwoGuides(t as object)
        input = SettingsPageTests.fixture({})
        ids = SettingsPageTests.cacheIDs(input.store.guides)
        input.guideStatuses[ids[0]] = { index: 1, host: "iptv.example", status: "OK, 2 channels matched", problem: "", matched: 2, programmes: 48210, fromPlaylist: false, stale: false }
        input.guideUpdated[ids[0]] = "6:12 PM"
        input.guideLoading = true
        model = SettingsStatus.make(input)
        list = SettingsPages.sections("liveTV", model)
        t.assertEqual(SettingsPages.actionIDs(list), ["playlist.edit", "guide." + ids[0], "guide." + ids[1], "guide.add", "antenna", "groups", "hiddenChannels", "teams", "refresh", "removeSource"])
        t.assertEqual(SettingsPageTests.sectionTitles(list), ["Playlist", "Guides", "Channels", ""], "MMTVL's sections; Manage has no title")
        info = SettingsPages.rowWithID(list, "playlist.info")
        t.assertEqual(info.title, "iptv.example")
        t.assertEqual(info.value, "3 Channels")
        t.assertEqual(info.detail, "Updated 6:12 PM")
        t.assertInvalid(info.action, "an info row")
        t.assertEqual(SettingsPages.rowWithID(list, "playlist.edit").title, "Change Playlist URL…")
        first = SettingsPages.rowWithID(list, "guide." + ids[0])
        t.assertEqual(first.title, "iptv.example " + Chr(183) + " guide.xml")
        t.assertEqual(first.value, "1")
        t.assertEqual(first.detail, "48,210 programmes " + Chr(183) + " 2 channels " + Chr(183) + " Updated 6:12 PM", "frame wjg72's line")
        t.assertTrue(first.disclosure)
        t.assertEqual(first.action, { type: "push", page: "guide:" + ids[0] })
        second = SettingsPages.rowWithID(list, "guide." + ids[1])
        t.assertEqual(second.value, "2")
        t.assertEqual(second.detail, "Loading…", "no result yet while a run goes")
        t.assertEqual(SettingsPages.rowWithID(list, "guide.add").detail, "Type an XMLTV address on the Roku's keyboard")
        guides = SettingsPageTests.section(list, "guides")
        t.assertEqual(guides.footer, "Guide data for 2 of 3 channels. A channel uses the first guide in this list that has it.")
        manage = SettingsPageTests.section(list, "manage")
        t.assertEqual(manage.footer, "Addresses are kept on this Roku and never shown in full.", "frame wjg72")
        t.assertEqual(SettingsPages.rowWithID(list, "refresh").action, { type: "refresh" })
        t.assertEqual(SettingsPages.rowWithID(list, "removeSource").action, { type: "push", page: "confirmRemoveSource" })
    end sub

    ' Done-when (SettingsPageTests cover the URL display rule): hosts only, plus a guide file's name (M6b L2);
    ' never a scheme, a user, a port, a query, a token or another part of the path, anywhere in the model.
    sub test_urlsAreNeverShownWhole(t as object)
        input = SettingsPageTests.fixture({})
        input.store.source = "http://user:secret@IPTV.example:8080/get.php?username=me&password=pw&type=m3u_plus"
        input.store.guides = ["https://epg.example/a/b/sports.xml.gz?token=abc123", "https://tv.example/api/xmltv?u=me&p=pw", "http://guide.example/listings/"]
        input.playlistGuideURLs = ["https://named.example/x/epg.xml?k=secret"]
        model = SettingsStatus.make(input)
        list = SettingsPages.sections("liveTV", model)
        t.assertEqual(SettingsPages.rowWithID(list, "playlist.info").title, "iptv.example", "the host, lowercased")
        ids = SettingsPageTests.cacheIDs(input.store.guides)
        t.assertEqual(SettingsPages.rowWithID(list, "guide." + ids[0]).title, "epg.example " + Chr(183) + " sports.xml.gz")
        t.assertEqual(SettingsPages.rowWithID(list, "guide." + ids[1]).title, "tv.example", "no guide file name: the host only")
        t.assertEqual(SettingsPages.rowWithID(list, "guide." + ids[2]).title, "guide.example")
        t.assertEqual(SettingsPages.pageTitle("guide:" + ids[0], model), "epg.example " + Chr(183) + " sports.xml.gz")
        text = FormatJson(model)
        for each page in ["root", "liveTV", "guide:" + ids[0], "groups", "hiddenChannels", "device", "import", "about"]
            text += FormatJson(SettingsPages.sections(page, model)) + SettingsPages.pageTitle(page, model)
        end for
        for each piece in ["://", "secret", "username", "password", "token", "abc123", "8080", "get.php", "xmltv?", "u=me", "/a/b", "listings", "named.example", "k="]
            t.assertEqual(Instr(1, text, piece), 0, "no " + piece)
        end for
        refused = SettingsPageTests.fixture({})
        refused.store.source = "http://bad host.example/x.m3u"
        t.assertEqual(SettingsStatus.make(refused).playlist.host, "Playlist", "a host Log.host won't read shows MMTVL's Playlist")
    end sub

    sub test_guideSourceRowOnlyWithAChoice(t as object)
        input = SettingsPageTests.fixture({})
        list = SettingsPages.sections("liveTV", SettingsStatus.make(input))
        t.assertInvalid(SettingsPages.rowWithID(list, "guideSource"), "the playlist names no guide")
        input.playlistGuideURLs = ["https://iptv.example/epg.xml"]
        list = SettingsPages.sections("liveTV", SettingsStatus.make(input))
        row = SettingsPages.rowWithID(list, "guideSource")
        t.assertEqual(row.value, "Added Guides")
        t.assertEqual(row.detail, "")
        t.assertEqual(row.description, "Use the guide the playlist names, or the guides you added. The guides you added are kept either way.")
        t.assertEqual(row.action, { type: "toggle", setting: "usePlaylistGuide" })
        input.store.settings = SettingsEdits.settingToggled(input.store.settings, "usePlaylistGuide")
        t.assertEqual(SettingsPages.rowWithID(SettingsPages.sections("liveTV", SettingsStatus.make(input)), "guideSource").value, "Playlist")
        input.store.guides = []
        t.assertInvalid(SettingsPages.rowWithID(SettingsPages.sections("liveTV", SettingsStatus.make(input)), "guideSource"), "no guide added")
    end sub

    sub test_unusedTypedGuideIsOffAndKeepsItsPage(t as object)
        input = SettingsPageTests.fixture({})
        input.store.guides = ["https://epg.example/us2.xml.gz"]
        input.store.settings.usePlaylistGuide = true
        input.playlistGuideURLs = ["https://iptv.example/epg.xml"]
        model = SettingsStatus.make(input)
        list = SettingsPages.sections("liveTV", model)
        named = SettingsPages.rowWithID(list, "guide." + GuideSources.cacheID("https://iptv.example/epg.xml"))
        t.assertEqual(named.value, "From Playlist")
        t.assertInvalid(named.action)
        t.assertFalse(named.disclosure)
        id = GuideSources.cacheID("https://epg.example/us2.xml.gz")
        unused = SettingsPages.rowWithID(list, "guide." + id)
        t.assertEqual(unused.value, "Off")
        t.assertTrue(unused.dimmed)
        t.assertEqual(unused.detail, "Not in use (kept)")
        t.assertEqual(unused.action, { type: "push", page: "guide:" + id })
        t.assertTrue(SettingsPages.rowWithID(SettingsPages.sections("guide:" + id, model), "guidePage.remove") <> invalid)
    end sub

    sub test_playlistGuideIsAnInfoRow(t as object)
        input = SettingsPageTests.fixture({})
        input.store.guides = []
        input.playlistGuideURLs = ["https://guide.example/epg.xml"]
        list = SettingsPages.sections("liveTV", SettingsStatus.make(input))
        t.assertEqual(SettingsPages.actionIDs(list), ["playlist.edit", "guide.add", "antenna", "groups", "hiddenChannels", "teams", "refresh", "removeSource"])
        row = SettingsPages.rowWithID(list, "guide." + GuideSources.cacheID("https://guide.example/epg.xml"))
        t.assertEqual(row.value, "From Playlist")
        t.assertEqual(row.detail, "Not loaded yet")
        t.assertInvalid(row.action)
    end sub

    sub test_noGuideExplainsHowToAddOne(t as object)
        input = SettingsPageTests.fixture({})
        input.store.guides = []
        list = SettingsPages.sections("liveTV", SettingsStatus.make(input))
        t.assertEqual(SettingsPages.rowWithID(list, "guide.none").title, "No guide")
        t.assertEqual(SettingsPages.rowWithID(list, "guide.none").detail, "Type an XMLTV guide address below")
        t.assertTrue(SettingsPages.rowWithID(list, "guide.add") <> invalid)
    end sub

    sub test_noAddRowAtTheLimit(t as object)
        input = SettingsPageTests.fixture({})
        input.store.guides = ["https://a.example/1.xml", "https://a.example/2.xml", "https://a.example/3.xml", "https://a.example/4.xml", "https://a.example/5.xml", "https://a.example/6.xml"]
        list = SettingsPages.sections("liveTV", SettingsStatus.make(input))
        t.assertInvalid(SettingsPages.rowWithID(list, "guide.add"))
        t.assertEqual(SettingsPages.rowWithID(list, "guide." + GuideSources.cacheID("https://a.example/6.xml")).value, "6", "priority numbers 1 to 6")
    end sub

    ' A refused address shows on its own row (MMTVL's pasteMessage); the other keeps its hint.
    sub test_aRefusedAddressShowsOnItsRowOnly(t as object)
        model = SettingsStatus.make(SettingsPageTests.fixture({}))
        list = SettingsPages.sections("liveTV", model, { playlist: "", guide: "That guide is already added" })
        t.assertEqual(SettingsPages.rowWithID(list, "guide.add").detail, "That guide is already added")
        t.assertEqual(SettingsPages.rowWithID(list, "playlist.edit").detail, "Type the M3U address on the Roku's keyboard")
    end sub

    sub test_guideLines(t as object)
        dot = " " + Chr(183) + " "
        ok = { status: "OK, 398 channels matched", problem: "", matched: 398, programmes: 48210 }
        t.assertEqual(SettingsStatus.guideLine(ok, "6:12 PM", false, true), "48,210 programmes" + dot + "398 channels" + dot + "Updated 6:12 PM", "frame wjg72")
        t.assertEqual(SettingsStatus.guideLine(ok, invalid, false, true), "48,210 programmes" + dot + "398 channels")
        one = { status: "OK, 1 channel matched", problem: "", matched: 1, programmes: 1 }
        t.assertEqual(SettingsStatus.guideLine(one, "", true, true), "1 programme" + dot + "1 channel", "a run going doesn't hide the last result")
        cut = { status: "OK, 1,234 channels matched (guide shortened)", problem: "", matched: 1234, programmes: 25000 }
        t.assertEqual(SettingsStatus.guideLine(cut, "9:00 AM", false, true), "25,000 programmes" + dot + "1,234 channels (guide shortened)" + dot + "Updated 9:00 AM")
        noCount = { status: "OK, 3 channels matched", problem: "", matched: 3 }
        t.assertEqual(SettingsStatus.guideLine(noCount, "", false, true), "0 programmes" + dot + "3 channels", "a row without a count reads 0")
        gzip = { status: "Can't read .gz on this Roku", problem: "gzip", matched: 0 }
        t.assertEqual(SettingsStatus.guideLine(gzip, "6:12 PM", false, true), "Can't read .gz on this Roku")
        failed = { status: "Failed: epg.example", problem: "failed", matched: 12, stale: true }
        t.assertEqual(SettingsStatus.guideLine(failed, "6:12 PM", false, true), "Failed: epg.example")
        t.assertEqual(SettingsStatus.guideLine(invalid, "", true, true), "Loading…")
        t.assertEqual(SettingsStatus.guideLine(invalid, "", false, true), "Not loaded yet")
        t.assertEqual(SettingsStatus.guideLine(ok, "6:12 PM", false, false), "Not in use (kept)")
    end sub

    sub test_playlistLines(t as object)
        t.assertEqual(SettingsStatus.playlistLine({ loading: true, status: "", updated: "6:12 PM" }), "Loading…")
        t.assertEqual(SettingsStatus.playlistLine({ loading: false, status: "Couldn't load the playlist (iptv.example)", updated: "6:12 PM" }), "Couldn't load the playlist (iptv.example)")
        t.assertEqual(SettingsStatus.playlistLine({ loading: false, status: "", updated: "6:12 PM" }), "Updated 6:12 PM")
        t.assertEqual(SettingsStatus.playlistLine({ loading: false, status: "", updated: "" }), "")
        t.assertEqual(SettingsStatus.playlistLine(invalid), "")
    end sub

    sub test_counts(t as object)
        t.assertEqual(SettingsStatus.grouped(0), "0")
        t.assertEqual(SettingsStatus.grouped(999), "999")
        t.assertEqual(SettingsStatus.grouped(1000), "1,000")
        t.assertEqual(SettingsStatus.grouped(48210), "48,210")
        t.assertEqual(SettingsStatus.grouped(1234567), "1,234,567")
        t.assertEqual(SettingsStatus.countText(1, "Channel", "Channels"), "1 Channel")
        t.assertEqual(SettingsStatus.countText(424, "Channel", "Channels"), "424 Channels")
    end sub

    ' --- Channels ---

    sub test_channelsSection(t as object)
        input = SettingsPageTests.fixture({})
        list = SettingsPages.sections("liveTV", SettingsStatus.make(input))
        t.assertEqual(SettingsPages.rowWithID(list, "groups").value, "All Shown")
        t.assertEqual(SettingsPages.rowWithID(list, "hiddenChannels").value, "None")
        t.assertEqual(SettingsPageTests.section(list, "channels").footer, "To favorite, hide or match one channel: in the guide, press * on it.")
        input.store.prefs.hiddenGroups = ["Sports"]
        input.store.prefs.hiddenChannels = ["id:a", "id:b", "id:gone"]
        list = SettingsPages.sections("liveTV", SettingsStatus.make(input))
        t.assertEqual(SettingsPages.rowWithID(list, "groups").value, "1 Hidden")
        t.assertEqual(SettingsPages.rowWithID(list, "hiddenChannels").value, "2", "ids the playlist doesn't have aren't counted")
    end sub

    sub test_groupsPage(t as object)
        input = SettingsPageTests.fixture({})
        input.store.prefs.hiddenGroups = ["Sports"]
        model = SettingsStatus.make(input)
        list = SettingsPages.sections("groups", model)
        t.assertEqual(SettingsPages.pageTitle("groups", model), "Groups")
        t.assertEqual(SettingsPages.actionIDs(list), ["group.News", "group.Sports"], "playlist order")
        news = SettingsPages.rowWithID(list, "group.News")
        t.assertEqual([news.value, news.detail, news.dimmed], ["Shown", "2 channels", false])
        sports = SettingsPages.rowWithID(list, "group.Sports")
        t.assertEqual([sports.value, sports.detail, sports.dimmed], ["Hidden", "1 channel", true])
        t.assertEqual(sports.action, { type: "toggleGroupHidden", name: "Sports" })
        t.assertEqual(list[0].footer, "Hidden groups and their channels don't show in the guide or when changing channels.")
    end sub

    sub test_hiddenChannelsPage(t as object)
        input = SettingsPageTests.fixture({})
        input.store.prefs.hiddenChannels = ["id:c", "id:a"]
        list = SettingsPages.sections("hiddenChannels", SettingsStatus.make(input))
        t.assertEqual(SettingsPages.actionIDs(list), ["hidden.id:a", "hidden.id:c"], "playlist order")
        row = SettingsPages.rowWithID(list, "hidden.id:a")
        t.assertEqual([row.title, row.value, row.detail], ["101  Alpha", "Show", "News"])
        t.assertEqual(row.action, { type: "unhideChannel", id: "id:a" })
        input.store.prefs.hiddenChannels = []
        list = SettingsPages.sections("hiddenChannels", SettingsStatus.make(input))
        t.assertEqual(SettingsPages.actionIDs(list), [])
        t.assertEqual(SettingsPages.rowWithID(list, "hidden.none").title, "No hidden channels")
        t.assertEqual(list[0].footer, "Select a channel to show it again.")
    end sub

    ' --- one guide ---

    sub test_guidePage(t as object)
        input = SettingsPageTests.fixture({})
        ids = SettingsPageTests.cacheIDs(input.store.guides)
        input.guideStatuses[ids[0]] = { status: "Can't read .gz on this Roku", problem: "gzip", matched: 0 }
        model = SettingsStatus.make(input)
        page = "guide:" + ids[0]
        list = SettingsPages.sections(page, model)
        t.assertEqual(SettingsPages.pageTitle(page, model), "iptv.example " + Chr(183) + " guide.xml")
        t.assertEqual(SettingsPages.rowWithID(list, "guidePage.status").detail, "Can't read .gz on this Roku")
        t.assertEqual(SettingsPages.actionIDs(list), ["guidePage.moveDown", "guidePage.remove"])
        t.assertEqual(SettingsPages.rowWithID(list, "guidePage.moveDown").action, { type: "moveGuide", id: ids[0], step: 1 })
        t.assertEqual(SettingsPages.rowWithID(list, "guidePage.remove").action, { type: "removeGuide", id: ids[0] })
        t.assertEqual(list[0].footer, "When two guides have the same channel, the higher one wins.")
        t.assertEqual(SettingsPages.actionIDs(SettingsPages.sections("guide:" + ids[1], model)), ["guidePage.moveUp", "guidePage.remove"])
        t.assertEqual(SettingsPages.sections("guide:gone", model), [], "an id no longer listed shows nothing")
        t.assertEqual(SettingsPages.pageTitle("guide:gone", model), "Guide")
    end sub

    sub test_removeConfirmHasCancelFirst(t as object)
        model = SettingsStatus.make(SettingsPageTests.fixture({}))
        list = SettingsPages.sections("confirmRemoveSource", model)
        t.assertEqual(SettingsPages.actionIDs(list), ["confirm.cancel", "confirm.remove"])
        t.assertEqual(SettingsPages.rowWithID(list, "confirm.cancel").action, { type: "pop" })
        t.assertEqual(SettingsPages.rowWithID(list, "confirm.remove").action, { type: "removeSource" })
        t.assertEqual(SettingsPages.pageTitle("confirmRemoveSource", model), "Remove Live TV Source?")
    end sub

    ' --- Remote & Input ---

    sub test_channelUpRowTogglesTheDirection(t as object)
        input = SettingsPageTests.fixture({})
        list = SettingsPages.sections("remoteInput", SettingsStatus.make(input))
        t.assertEqual(SettingsPages.actionIDs(list), ["channelUp"])
        row = SettingsPages.rowWithID(list, "channelUp")
        t.assertEqual(row.value, "Up the List")
        t.assertEqual(row.detail, "")
        t.assertEqual(Left(row.description, 27), "Changes channel in Live TV.")
        t.assertEqual(row.action, { type: "toggle", setting: "channelUpMovesUpList" })
        input.store.settings = SettingsEdits.settingToggled(input.store.settings, "channelUpMovesUpList")
        t.assertEqual(SettingsPages.rowWithID(SettingsPages.sections("remoteInput", SettingsStatus.make(input)), "channelUp").value, "Higher Number")
    end sub

    ' --- Device (L7, frame B94oz) ---

    sub test_deviceShowsWhatCapabilitiesDecides(t as object)
        model = SettingsStatus.make(SettingsPageTests.fixture({}))
        list = SettingsPages.sections("device", model)
        t.assertEqual(SettingsPageTests.sectionTitles(list), ["This Roku", "Features"])
        dot = " " + Chr(183) + " "
        t.assertEqual(SettingsPages.rowWithID(list, "device.model").value, "Roku Express" + dot + "Roku OS 15.0")
        t.assertEqual(SettingsPages.rowWithID(list, "device.memory").value, "512 MB" + dot + "Low")
        t.assertEqual(SettingsPages.rowWithID(list, "device.guideWindow").value, "24 Hours")
        logos = SettingsPages.rowWithID(list, "device.channelLogos")
        t.assertEqual(logos.value, "On")
        t.assertEqual(logos.action, { type: "toggle", setting: "channelLogos" })
        t.assertEqual(logos.description, "Shows channel logos in the guide and the banner. On at first. On a Low Roku (see Memory above), logos can slow the guide: turn them off if it feels slow.")
        t.assertEqual(SettingsPages.rowWithID(list, "device.compressedGuides").value, "On: Up to 2 MB")
        t.assertEqual(SettingsPages.rowWithID(list, "device.mpeg2").value, "Off: No MPEG-2")
        t.assertEqual(SettingsPages.rowWithID(list, "device.ac3").value, "On")
        t.assertEqual(SettingsPages.actionIDs(list), ["device.channelLogos"], "only Channel Logos is a switch")
        t.assertEqual(list[0].footer, "")
        t.assertFalse(list[0].warning)
    end sub

    ' Tester feedback on build 5: every row takes focus, info rows included, in display order.
    sub test_everyRowIsFocusable(t as object)
        model = SettingsStatus.make(SettingsPageTests.fixture({}))
        device = SettingsPages.sections("device", model)
        t.assertEqual(SettingsPages.focusableIDs(device), ["device.model", "device.memory", "device.guideWindow", "device.channelLogos", "device.compressedGuides", "device.mpeg2", "device.ac3"])
        liveTV = SettingsPages.sections("liveTV", model)
        ids = SettingsPageTests.cacheIDs(SettingsPageTests.fixture({}).store.guides)
        t.assertEqual(SettingsPages.focusableIDs(liveTV), ["playlist.info", "playlist.edit", "guide." + ids[0], "guide." + ids[1], "guide.add", "antenna", "groups", "hiddenChannels", "teams", "refresh", "removeSource"])
        t.assertEqual(SettingsPages.focusableIDs(SettingsPages.sections("about", model)), ["about.version", "about.build"])
        t.assertEqual(SettingsPages.focusableIDs([]), [])
    end sub

    ' A focused info row's band: its description, else the info-only line; an action row without one stays "".
    sub test_anInfoRowsBandSaysItsInformationOnly(t as object)
        model = SettingsStatus.make(SettingsPageTests.fixture({}))
        device = SettingsPages.sections("device", model)
        t.assertEqual(SettingsPages.infoOnlyDescription, "Information only: nothing to change here.")
        for each id in ["device.model", "device.memory", "device.guideWindow", "device.compressedGuides", "device.mpeg2", "device.ac3"]
            t.assertEqual(SettingsPages.description(device, id), "Information only: nothing to change here.", id)
        end for
        t.assertEqual(Left(SettingsPages.description(device, "device.channelLogos"), 26), "Shows channel logos in the", "an action row's own")
        t.assertEqual(SettingsPages.description(SettingsPages.sections("about", model), "about.build"), SettingsPages.infoOnlyDescription)
        ' An info row with a description of its own keeps it.
        own = [SettingsPages.newSection("s", "", [SettingsPages.newRow({ id: "info", title: "Info", description: "Its own words." })], "")]
        t.assertEqual(SettingsPages.description(own, "info"), "Its own words.")
        groups = SettingsPages.sections("groups", model)
        first = SettingsPages.actionIDs(groups)[0]
        t.assertEqual(SettingsPages.description(groups, first), "", "an action row without a description")
        t.assertEqual(SettingsPages.description(device, "gone"), "", "no row")
        t.assertEqual(SettingsPages.description(device, invalid), "", "no focus")
    end sub

    sub test_aHighRokusFeatures(t as object)
        input = SettingsPageTests.fixture({})
        input.caps = Capabilities.detect(CapabilitiesTests.device({ mpeg2: true }), CapabilitiesTests.monitor(1024))
        input.store.settings.channelLogos = false
        list = SettingsPages.sections("device", SettingsStatus.make(input))
        dot = " " + Chr(183) + " "
        t.assertEqual(SettingsPages.rowWithID(list, "device.model").value, "Roku Ultra" + dot + "Roku OS 15.1")
        t.assertEqual(SettingsPages.rowWithID(list, "device.memory").value, "1,024 MB" + dot + "High")
        t.assertEqual(SettingsPages.rowWithID(list, "device.guideWindow").value, "36 Hours")
        t.assertEqual(SettingsPages.rowWithID(list, "device.channelLogos").value, "Off")
        t.assertEqual(SettingsPages.rowWithID(list, "device.compressedGuides").value, "On")
        t.assertEqual(SettingsPages.rowWithID(list, "device.mpeg2").value, "On")
        t.assertEqual(SettingsPages.rowWithID(list, "device.ac3").value, "Off: No AC-3")
        unknown = SettingsStatus.deviceOf(invalid)
        t.assertEqual([unknown.modelName, unknown.memory, unknown.os], ["Roku", "Unknown", ""])
    end sub

    ' Step 22 (D45, D46): after memory alerts the page says what went and why; the switch keeps the saved choice.
    sub test_memoryAlertsShowOnTheDevicePage(t as object)
        input = SettingsPageTests.fixture({})
        input.memoryRelief = MemoryRelief.apply(MemoryRelief.newState(), MemoryRelief.appAlert({ memoryUsagePercent: 86 }, invalid, true)).state
        list = SettingsPages.sections("device", SettingsStatus.make(input))
        window = SettingsPages.rowWithID(list, "device.guideWindow")
        t.assertEqual(window.value, "12 Hours: Low Memory")
        t.assertEqual(window.detail, "Shorter until MMTVL Live TV opens again")
        logos = SettingsPages.rowWithID(list, "device.channelLogos")
        t.assertEqual(logos.value, "Off: Low Memory")
        t.assertEqual(logos.description, "This Roku ran low on memory, so logos are off until MMTVL Live TV opens again. This switch keeps your choice for next time.")
        t.assertEqual(logos.action, { type: "toggle", setting: "channelLogos" })
        input.store.settings.channelLogos = false
        t.assertEqual(SettingsPages.rowWithID(SettingsPages.sections("device", SettingsStatus.make(input)), "device.channelLogos").value, "Off", "turned off by hand: plain Off")
        input.store.settings.channelLogos = true
        input.memoryRelief = MemoryRelief.apply(MemoryRelief.newState(), MemoryRelief.appAlert({ memoryUsagePercent: 81 }, invalid, true)).state
        list = SettingsPages.sections("device", SettingsStatus.make(input))
        t.assertEqual(SettingsPages.rowWithID(list, "device.guideWindow").value, "24 Hours", "80 %: the window stays")
        t.assertEqual(SettingsPages.rowWithID(list, "device.guideWindow").detail, "")
        t.assertEqual(SettingsPages.rowWithID(list, "device.channelLogos").value, "Off: Low Memory")
        input.memoryRelief = MemoryRelief.newState()
        list = SettingsPages.sections("device", SettingsStatus.make(input))
        t.assertEqual(SettingsPages.rowWithID(list, "device.guideWindow").value, "24 Hours")
        t.assertEqual(SettingsPages.rowWithID(list, "device.channelLogos").value, "On")
    end sub

    ' Step 22 (D56): the Device texts for each class: Low by memory, Low by its 720p UI only, Low with an unknown
    ' limit, and High.
    sub test_theDeviceTextsForEachClass(t as object)
        dot = " " + Chr(183) + " "
        cases = [
            { name: "Low by memory", device: {}, limit: 512, memory: "512 MB" + dot + "Low", window: "24 Hours", compressed: "On: Up to 2 MB" },
            { name: "Low by its 720p UI", device: { ui: { name: "HD", width: 1280, height: 720 } }, limit: 2048, memory: "2,048 MB" + dot + "Low (720p UI)", window: "24 Hours", compressed: "On: Up to 2 MB" },
            { name: "Low, limit unknown", device: {}, limit: invalid, memory: "Unknown" + dot + "Low", window: "24 Hours", compressed: "On: Up to 2 MB" },
            { name: "High", device: {}, limit: 1024, memory: "1,024 MB" + dot + "High", window: "36 Hours", compressed: "On" }
        ]
        for each spec in cases
            input = SettingsPageTests.fixture({})
            monitor = invalid
            if spec.limit <> invalid then monitor = CapabilitiesTests.monitor(spec.limit)
            input.caps = Capabilities.detect(CapabilitiesTests.device(spec.device), monitor)
            list = SettingsPages.sections("device", SettingsStatus.make(input))
            t.assertEqual(SettingsPages.rowWithID(list, "device.memory").value, spec.memory, spec.name)
            t.assertEqual(SettingsPages.rowWithID(list, "device.guideWindow").value, spec.window, spec.name)
            t.assertEqual(SettingsPages.rowWithID(list, "device.compressedGuides").value, spec.compressed, spec.name)
            t.assertEqual(SettingsPages.rowWithID(list, "device.channelLogos").value, "On", spec.name + ": logos on everywhere (L7 as amended)")
            t.assertEqual(SettingsPages.rowWithID(list, "device.channelLogos").description, SettingsPages.channelLogosDescription, spec.name)
            t.assertEqual(LowMemoryNotice.shouldShow(input.caps, {}, input.store.settings), spec.name <> "High", spec.name + ": the notice on Low Rokus only")
        end for
    end sub

    ' L5: under 4 KB left, Settings → Device warns.
    sub test_lowRegistrySpaceWarnsOnTheDevicePage(t as object)
        input = SettingsPageTests.fixture({})
        input.store = SettingsStore.load(SettingsStoreTests.fakeRegistry(3000))
        list = SettingsPages.sections("device", SettingsStatus.make(input))
        t.assertTrue(list[0].warning)
        t.assertEqual(list[0].footer, "This Roku is almost out of room for settings (3,000 bytes left). Guide matches aren't saved until some favorites, hidden channels or guide matches are removed.")
    end sub

    ' --- Import, About ---

    sub test_importAndAboutPages(t as object)
        model = SettingsStatus.make(SettingsPageTests.fixture({}))
        importList = SettingsPages.sections("import", model)
        t.assertEqual(SettingsPages.actionIDs(importList), [], "text only")
        t.assertEqual(SettingsPages.rowWithID(importList, "import.run").detail, "python3 -I scripts/roku-export-settings.py")
        about = SettingsPages.sections("about", model)
        t.assertEqual(SettingsPages.rowWithID(about, "about.version").value, "1.0")
        t.assertEqual(SettingsPages.rowWithID(about, "about.build").value, "7")
        t.assertEqual(SettingsPages.actionIDs(about), [])
        t.assertEqual(SettingsPages.pageTitle("import", model), "Import from MMTVL")
        t.assertEqual(SettingsPages.pageTitle("about", model), "About")
        t.assertEqual(SettingsPages.sections("nowhere", model), [])
    end sub

    ' Done-when, off-device: every change goes through SettingsStore and is there after a relaunch (a new load
    ' from the same registry).
    sub test_changesSurviveARelaunch(t as object)
        registry = SettingsStoreTests.fakeRegistry(30000)
        store = SettingsStore.load(registry)
        checked = SettingsEdits.checkURL("  https://iptv.example/get.php?u=me  ")
        t.assertTrue(SettingsStore.save(store, "source", checked.url).ok)
        added = SettingsEdits.addGuide(store.guides, "https://epg.example/a.xml")
        t.assertTrue(SettingsStore.save(store, "guides", added.guides).ok)
        added = SettingsEdits.addGuide(store.guides, "https://epg.example/b.xml.gz")
        t.assertTrue(SettingsStore.save(store, "guides", added.guides).ok)
        moved = SettingsEdits.moveGuide(store.guides, GuideSources.cacheID("https://epg.example/b.xml.gz"), -1)
        t.assertTrue(SettingsStore.save(store, "guides", moved).ok)
        t.assertTrue(SettingsStore.save(store, "prefs", SettingsEdits.groupToggled(store.prefs, "Sports")).ok)
        for each name in ["channelUpMovesUpList", "usePlaylistGuide", "channelLogos"]
            t.assertTrue(SettingsStore.save(store, "settings", SettingsEdits.settingToggled(store.settings, name)).ok)
        end for
        relaunched = SettingsStore.load(registry)
        t.assertEqual(relaunched.source, "https://iptv.example/get.php?u=me")
        t.assertEqual(relaunched.guides, ["https://epg.example/b.xml.gz", "https://epg.example/a.xml"])
        t.assertEqual(relaunched.prefs.hiddenGroups, ["Sports"])
        t.assertFalse(relaunched.settings.channelUpMovesUpList)
        t.assertTrue(relaunched.settings.usePlaylistGuide)
        t.assertFalse(relaunched.settings.channelLogos)
        input = SettingsPageTests.fixture({})
        input.store = relaunched
        list = SettingsPages.sections("liveTV", SettingsStatus.make(input))
        t.assertEqual(SettingsPages.rowWithID(list, "guide." + GuideSources.cacheID("https://epg.example/b.xml.gz")).value, "1")
    end sub

    ' A refused save keeps the old value and says why (the scene shows the message on the page).
    sub test_aRefusedSaveKeepsTheOldValue(t as object)
        registry = SettingsStoreTests.fakeRegistry(30000)
        store = SettingsStore.load(registry)
        registry.space = 10
        result = SettingsStore.save(store, "guides", ["https://epg.example/a-long-enough-guide-address.xml"])
        t.assertFalse(result.ok)
        t.assertEqual(result.message, SettingsStore.tooLargeMessage)
        t.assertEqual(store.guides, [])
    end sub

    ' QA of step 13: with the playlist's guide in use, its url-tvg guide shows host and file, never its query.
    sub test_urlsAreNeverShownWholeWithThePlaylistsGuide(t as object)
        input = SettingsPageTests.fixture({})
        input.store.settings.usePlaylistGuide = true
        input.playlistGuideURLs = ["https://named.example/x/epg.xml?k=secret"]
        model = SettingsStatus.make(input)
        list = SettingsPages.sections("liveTV", model)
        named = SettingsPages.rowWithID(list, "guide." + GuideSources.cacheID("https://named.example/x/epg.xml?k=secret"))
        t.assertEqual(named.title, "named.example " + Chr(183) + " epg.xml")
        t.assertEqual(named.value, "From Playlist")
        t.assertEqual(SettingsPages.rowWithID(list, "guideSource").value, "Playlist")
        text = FormatJson(model)
        pages = ["root", "liveTV", "groups", "hiddenChannels", "device", "import", "about"]
        for each guide in model.guides
            pages.Push("guide:" + guide.id)
        end for
        for each page in pages
            text += FormatJson(SettingsPages.sections(page, model)) + SettingsPages.pageTitle(page, model)
        end for
        for each piece in ["k=", "secret", "://", "/x/", "username", "password"]
            t.assertEqual(Instr(1, text, piece), 0, "no " + piece)
        end for
    end sub

    ' QA 6: with inflate off (GuideSources.inflateEnabled), Compressed Guides says so on every class.
    sub test_compressedGuidesOffWhenInflateIsOff(t as object)
        input = SettingsPageTests.fixture({})
        input.inflateEnabled = false
        t.assertEqual(SettingsPages.rowWithID(SettingsPages.sections("device", SettingsStatus.make(input)), "device.compressedGuides").value, "Off: Can't read .gz")
        input.caps = Capabilities.detect(CapabilitiesTests.device({ mpeg2: true }), CapabilitiesTests.monitor(1024))
        t.assertEqual(SettingsPages.rowWithID(SettingsPages.sections("device", SettingsStatus.make(input)), "device.compressedGuides").value, "Off: Can't read .gz", "High too")
        input.inflateEnabled = GuideSources.inflateEnabled
        t.assertEqual(SettingsPages.rowWithID(SettingsPages.sections("device", SettingsStatus.make(input)), "device.compressedGuides").value, "On", "the app's own setting")
        t.assertEqual(SettingsStatus.deviceOf(invalid, false).compressed, "Off: Can't read .gz")
    end sub

    ' A Roku with memory to spare that is Low only for its 720p UI says why (classReason).
    sub test_lowOnlyFor720pSaysSo(t as object)
        dot = " " + Chr(183) + " "
        input = SettingsPageTests.fixture({})
        input.caps = Capabilities.detect(CapabilitiesTests.device({ ui: { name: "HD", width: 1280, height: 720 } }), CapabilitiesTests.monitor(1024))
        t.assertEqual(SettingsPages.rowWithID(SettingsPages.sections("device", SettingsStatus.make(input)), "device.memory").value, "1,024 MB" + dot + "Low (720p UI)")
        input.caps = Capabilities.detect(CapabilitiesTests.device({ ui: { name: "HD", width: 1280, height: 720 } }), CapabilitiesTests.monitor(512))
        t.assertEqual(SettingsPages.rowWithID(SettingsPages.sections("device", SettingsStatus.make(input)), "device.memory").value, "512 MB" + dot + "Low", "low on memory too: the memory says it")
        input.caps = Capabilities.detect(CapabilitiesTests.device({}), CapabilitiesTests.monitor(1024))
        t.assertEqual(SettingsPages.rowWithID(SettingsPages.sections("device", SettingsStatus.make(input)), "device.memory").value, "1,024 MB" + dot + "High")
    end sub

    ' --- fixtures ---

    ' A store with a playlist and two typed guides, three channels in two groups, a Low Roku, version 1.0 build 7.
    ' --- Antenna (step 21; MMTVL's SettingsModelTests liveTVPageHasAnAntennaRow, antennaOnlyPageHasGuidesPreviewAndRefresh,
    ' antennaPageShowsTunersAndGuide, antennaOffShowsOffAndHidesTheTunerRows, useAntennaTogglesTheSetting) ---

    sub test_liveTVPageHasAnAntennaRow(t as object)
        ' Without a playlist: a tuner found sets Live TV up; the Channels section shows with the Antenna row.
        input = SettingsPageTests.antennaFixture()
        model = SettingsStatus.make(input)
        t.assertTrue(model.hasLiveSource, "a tuner counts as set up")
        t.assertEqual(SettingsPages.rowWithID(SettingsPages.sections("root", model), "liveTV").value, "3 Channels")
        list = SettingsPages.sections("liveTV", model)
        t.assertEqual(SettingsPageTests.rowIDs(SettingsPageTests.section(list, "channels")), ["antenna", "groups", "hiddenChannels", "teams"])
        row = SettingsPages.rowWithID(list, "antenna")
        t.assertEqual(row.title, "Antenna")
        t.assertEqual(row.value, "1 Tuner " + Chr(183) + " 3 Channels")
        t.assertEqual(row.description, "Channels from an HDHomeRun tuner on your network.")
        t.assertEqual(row.action, { type: "push", page: "antenna" })
        t.assertTrue(row.disclosure)
        ' Searching, then nothing found: no tuner yet, so the Channels section only.
        input.antenna = { enabled: true, searching: true, devices: [] }
        input.channels = []
        model = SettingsStatus.make(input)
        t.assertFalse(model.hasLiveSource)
        t.assertEqual(SettingsPages.rowWithID(SettingsPages.sections("root", model), "liveTV").value, "Not Set Up")
        list = SettingsPages.sections("liveTV", model)
        t.assertEqual(SettingsPages.rowWithID(list, "antenna").value, "Searching" + Chr(8230))
        t.assertEqual(SettingsPageTests.sectionIDs(list), ["playlist", "channels"])
        input.antenna.searching = false
        t.assertEqual(SettingsPages.rowWithID(SettingsPages.sections("liveTV", SettingsStatus.make(input)), "antenna").value, "No Tuner Found")
        ' With a playlist: the row leads Channels.
        withPlaylist = SettingsPageTests.fixture({ antenna: SettingsPageTests.antennaInput() })
        list = SettingsPages.sections("liveTV", SettingsStatus.make(withPlaylist))
        t.assertEqual(SettingsPageTests.rowIDs(SettingsPageTests.section(list, "channels")), ["antenna", "groups", "hiddenChannels", "teams"])
        t.assertEqual(SettingsPageTests.sectionIDs(list), ["playlist", "guides", "channels", "manage"])
    end sub

    ' A tuner alone: the guides and Refresh Now (MMTVL's wording); only Remove is the playlist's.
    sub test_antennaOnlyPageHasGuidesAndRefresh(t as object)
        list = SettingsPages.sections("liveTV", SettingsStatus.make(SettingsPageTests.antennaFixture()))
        t.assertEqual(SettingsPageTests.sectionIDs(list), ["playlist", "guides", "channels", "manage"])
        t.assertEqual(SettingsPages.actionIDs(list), ["playlist.edit", "guide.add", "antenna", "groups", "hiddenChannels", "teams", "refresh"])
        t.assertInvalid(SettingsPages.rowWithID(list, "removeSource"))
        t.assertEqual(SettingsPageTests.section(list, "guides").footer, "A channel uses the first guide in this list that has it.", "the count is the playlist's")
        t.assertEqual(SettingsPages.rowWithID(list, "refresh").description, "Reads the tuner's channels and downloads the guides again now.")
    end sub

    sub test_antennaPageShowsTunersAndGuide(t as object)
        input = SettingsPageTests.antennaFixture()
        input.antenna.leftOut = 2
        model = SettingsStatus.make(input)
        list = SettingsPages.sections("antenna", model)
        t.assertEqual(SettingsPages.pageTitle("antenna", model), "Antenna")
        t.assertEqual(SettingsPageTests.sectionTitles(list), ["Antenna", "Tuners", "Guide"])
        t.assertEqual(SettingsPages.actionIDs(list), ["antenna.enabled", "antenna.find", "antenna.address", "antenna.guide"])
        use = SettingsPages.rowWithID(list, "antenna.enabled")
        t.assertEqual(use.title, "Use Antenna")
        t.assertEqual(use.value, "On")
        t.assertEqual(use.action, { type: "toggle", setting: "antennaEnabled" })
        t.assertEqual(use.description, "Finds HDHomeRun tuners on your network and adds their channels to Live TV's Antenna group.")
        tuner = SettingsPages.rowWithID(list, "antenna.tuner.0")
        t.assertEqual(tuner.title, "HDHomeRun FLEX 4K")
        t.assertEqual(tuner.value, "2 tuners")
        t.assertEqual(tuner.detail, "HDFX-4K " + Chr(183) + " 3 channels")
        t.assertInvalid(tuner.action)
        find = SettingsPages.rowWithID(list, "antenna.find")
        t.assertEqual(find.title, "Find Tuners")
        t.assertEqual(find.detail, "")
        t.assertEqual(find.action, { type: "findTuners" })
        t.assertEqual(find.description, "Looks for HDHomeRun tuners on your network again.")
        address = SettingsPages.rowWithID(list, "antenna.address")
        t.assertEqual(address.value, "None")
        t.assertEqual(address.action, { type: "editURL", field: "antennaAddress" })
        guide = SettingsPages.rowWithID(list, "antenna.guide")
        t.assertEqual(guide.title, "Guide from SiliconDust")
        t.assertEqual(guide.value, "On")
        t.assertEqual(guide.action, { type: "toggle", setting: "antennaGuide" })
        status = SettingsPages.rowWithID(list, "antenna.guide.status")
        t.assertEqual(status.detail, "1,234 programmes " + Chr(183) + " 2 of 3 channels " + Chr(183) + " Updated 9:12 AM")
        t.assertInvalid(status.action)
        t.assertEqual(SettingsPageTests.section(list, "antennaTuners").footer, "Channels come from the tuner's lineup. To find them again after moving the antenna, scan for channels on the tuner's own page or in MMTVL. 2 protected channels can't play and are left out.")
        ' The lineup can't be read: the tuner row says so.
        input.antenna.lineupFailed = 1
        input.antenna.leftOut = 0
        failed = SettingsPages.sections("antenna", SettingsStatus.make(input))
        t.assertEqual(SettingsPages.rowWithID(failed, "antenna.tuner.0").detail, "HDFX-4K " + Chr(183) + " The antenna tuner isn't answering")
        ' L6: no DeviceID or address on any page (the model has none to show).
        for each page in ["root", "liveTV", "antenna", "device"]
            for each part in SettingsPages.sections(page, model)
                for each text in [part.footer, part.title]
                    t.assertFalse(SettingsPageTests.leaks(text), page + " section")
                end for
                for each row in part.rows
                    for each text in [row.id, row.title, row.value, row.detail, row.description]
                        t.assertFalse(SettingsPageTests.leaks(text), page + " " + row.id)
                    end for
                end for
            end for
        end for
    end sub

    sub test_antennaOffShowsOffAndHidesTheTunerRows(t as object)
        input = SettingsPageTests.antennaFixture()
        input.antenna.enabled = false
        list = SettingsPages.sections("antenna", SettingsStatus.make(input))
        t.assertEqual(SettingsPageTests.sectionIDs(list), ["antenna"])
        t.assertEqual(SettingsPages.actionIDs(list), ["antenna.enabled"])
        t.assertEqual(SettingsPages.rowWithID(list, "antenna.enabled").value, "Off")
        t.assertEqual(SettingsPages.rowWithID(SettingsPages.sections("liveTV", SettingsStatus.make(input)), "antenna").value, "Off")
    end sub

    ' The guide's status lines, Find Tuners' result, the typed address's problems.
    sub test_antennaGuideAndAddressLines(t as object)
        input = SettingsPageTests.antennaFixture()
        cases = [
            [{ loading: true }, "Loading" + Chr(8230)],
            [{ outcome: { ran: true, ok: false, message: "Server error (HTTP 503)" } }, "Failed: Server error (HTTP 503)"],
            [{ row: { status: "Not loaded yet", problem: "notLoaded", matched: 0, programmes: 0 } }, "Not loaded yet"],
            [{ row: { status: "Too large for this Roku", problem: "tooLarge", matched: 0, programmes: 0 } }, "Too large for this Roku"],
            [{}, "Not loaded yet"]
        ]
        for each item in cases
            input.antenna.guide = item[0]
            t.assertEqual(SettingsPages.rowWithID(SettingsPages.sections("antenna", SettingsStatus.make(input)), "antenna.guide.status").detail, item[1])
        end for
        input.antenna.guideOn = false
        t.assertEqual(SettingsPages.rowWithID(SettingsPages.sections("antenna", SettingsStatus.make(input)), "antenna.guide.status").detail, "Off")
        input.antenna.findLine = "Found 1 tuner"
        t.assertEqual(SettingsPages.rowWithID(SettingsPages.sections("antenna", SettingsStatus.make(input)), "antenna.find").detail, "Found 1 tuner")
        input.antenna.searching = true
        t.assertEqual(SettingsPages.rowWithID(SettingsPages.sections("antenna", SettingsStatus.make(input)), "antenna.find").detail, "Searching" + Chr(8230))
        input.antenna.searching = false
        input.antenna.devices = []
        input.antenna.findLine = ""
        t.assertEqual(SettingsPages.rowWithID(SettingsPages.sections("antenna", SettingsStatus.make(input)), "antenna.find").detail, "No HDHomeRun found on this network")
        input.antenna.addressSet = true
        for each item in [["noAnswer", "No tuner answered at that address"], ["notTuner", "That address isn't an HDHomeRun tuner"], ["", "Only if Find Tuners doesn't find it"]]
            input.antenna.typedProblem = item[0]
            row = SettingsPages.rowWithID(SettingsPages.sections("antenna", SettingsStatus.make(input)), "antenna.address")
            t.assertEqual(row.value, "Set")
            t.assertEqual(row.detail, item[1])
        end for
        ' A refused typed address shows on its row until the next push or pop.
        row = SettingsPages.rowWithID(SettingsPages.sections("antenna", SettingsStatus.make(input), { antennaAddress: "Type the tuner's IP address on your network, like 192.168.1.20" }), "antenna.address")
        t.assertEqual(row.detail, "Type the tuner's IP address on your network, like 192.168.1.20")
    end sub

    ' The plan's Settings → Device line when MPEG-2 channels are hidden; D26's switch off reads H.264 only.
    sub test_deviceSaysWhenMPEG2ChannelsAreHidden(t as object)
        input = SettingsPageTests.antennaFixture()
        input.antenna.mpeg2Hidden = 4
        row = SettingsPages.rowWithID(SettingsPages.sections("device", SettingsStatus.make(input)), "device.mpeg2")
        t.assertEqual(row.value, "Off: No MPEG-2")
        t.assertEqual(row.detail, "Some antenna channels need MPEG-2, which this Roku can't play")
        t.assertTrue(Instr(1, SettingsPageTests.section(SettingsPages.sections("antenna", SettingsStatus.make(input)), "antennaTuners").footer, "Some antenna channels need MPEG-2, which this Roku can't play") > 0)
        input.antenna.mpeg2Hidden = 0
        input.caps.mpeg2 = true
        t.assertEqual(SettingsPages.rowWithID(SettingsPages.sections("device", SettingsStatus.make(input)), "device.mpeg2").detail, "")
        t.assertEqual(SettingsPages.rowWithID(SettingsPages.sections("device", SettingsStatus.make(input)), "device.mpeg2").value, "On")
        input.antennaPlaysMPEG2 = false
        t.assertEqual(SettingsPages.rowWithID(SettingsPages.sections("device", SettingsStatus.make(input)), "device.mpeg2").value, "Off: H.264 Only")
    end sub

    function antennaInput() as object
        return { enabled: true, guideOn: true, searching: false, devices: [{ name: "HDHomeRun FLEX 4K", model: "HDFX-4K", tunerCount: 2, channelCount: 3 }], channelCount: 3, leftOut: 0, mpeg2Hidden: 0, lineupFailed: 0, typedProblem: "", addressSet: false, findLine: "", guide: { row: { status: "OK, 2 channels matched", problem: "", matched: 2, programmes: 1234 }, outcome: invalid, updated: "9:12 AM", loading: false } }
    end function

    ' No playlist, one tuner with three channels.
    function antennaFixture() as object
        input = SettingsPageTests.fixture({ antenna: SettingsPageTests.antennaInput() })
        input.store.source = ""
        input.store.guides = []
        input.channels = [
            { id: "antenna:2.1", number: 1, name: "WSB-HD", group: "Antenna", url: "http://10.0.0.9:5004/auto/v2.1", source: "antenna", guideNumber: "2.1", tunerCount: 2 },
            { id: "antenna:5.1", number: 2, name: "WAGA-HD", group: "Antenna", url: "http://10.0.0.9:5004/auto/v5.1", source: "antenna", guideNumber: "5.1", tunerCount: 2 },
            { id: "antenna:11.1", number: 3, name: "WXIA-TV", group: "Antenna", url: "http://10.0.0.9:5004/auto/v11.1", source: "antenna", guideNumber: "11.1", tunerCount: 2 }
        ]
        input.playlistChannelCount = 0
        return input
    end function

    function leaks(text as dynamic) as boolean
        if not SettingsStatus.isText(text) then return false
        return Instr(1, text, "10.0.0.9") > 0 or Instr(1, text, "SECRETID") > 0 or Instr(1, text, "://") > 0
    end function

    function rowIDs(found as dynamic) as object
        result = []
        if found = invalid then return result
        for each row in found.rows
            result.Push(row.id)
        end for
        return result
    end function

    function sectionIDs(list as object) as object
        result = []
        for each item in list
            result.Push(item.id)
        end for
        return result
    end function

    function fixture(overrides as object) as object
        store = SettingsStore.load(SettingsStoreTests.fakeRegistry(30000))
        store.source = "https://iptv.example/get.php?username=me&password=pw"
        store.guides = ["https://iptv.example/guide.xml", "https://tv.example/listings?k=1"]
        made = {
            store: store,
            channels: [SettingsPageTests.channel("id:a", 101, "Alpha", "News"), SettingsPageTests.channel("id:b", 102, "Bravo", "Sports"), SettingsPageTests.channel("id:c", 103, "Charlie", "News")],
            playlistGuideURLs: [],
            playlist: { loading: false, status: "", updated: "6:12 PM" },
            guideStatuses: {},
            guideUpdated: {},
            guideLoading: false,
            caps: { modelName: "Roku Express", model: "3930X", osVersion: "15.0.4.1234", memoryMB: 512, deviceClass: "Low", guideHours: 24, inflateMaxCompressedBytes: 2097152, mpeg2: false, ac3: true },
            version: "1.0",
            build: "7"
        }
        made.Append(overrides)
        return made
    end function

    function channel(id as string, number as integer, name as string, group as string) as object
        return { id: id, number: number, name: name, group: group, url: "https://iptv.example/live/me/pw/" + id + ".m3u8" }
    end function

    function cacheIDs(urls as object) as object
        result = []
        for each url in urls
            result.Push(GuideSources.cacheID(url))
        end for
        return result
    end function

    function section(list as object, id as string) as dynamic
        for each item in list
            if item.id = id then return item
        end for
        return invalid
    end function

    function sectionTitles(list as object) as object
        result = []
        for each item in list
            result.Push(item.title)
        end for
        return result
    end function

end namespace
