    ' Lines joined with LF; a backquote stands for a double quote.
    function joinLines(list as object) as string
        return list.Join(Chr(10)).Replace("`", Chr(34))
    end function

    ' MMTVL's M3UParserAttributeTests.manyAttributes, line for line (a backquote is a double quote).
    function manyAttributes() as string
        return M3UTests.joinLines([
            "#EXTM3U url-tvg=`https://a/x.xml.gz, https://b/y.xml` x-tvg-url=`ftp://c/z.xml,https://a/x.xml.gz` tvg-shift=`0`",
            "#EXTINF:-1 TVG-ID=`Upper.us` tvg-id=`lower.us` Group-Title=`Mixed Case`,Duplicate Keys",
            "http://s/1",
            "#EXTINF:0 tvg_id2=`a_b` tvg-logo=`https://l/x.png?a=1&b=2=3` tvg-name=`` group-title=``,Underscore, Digits & Empty",
            "http://s/2",
            "#EXTINF:-1 tvg-id=unquoted tvg-name='single' tvg-chno = `5` tvg-logo=`http://unterminated,No Closing Quote",
            "http://s/3",
            "#EXTINF:-1 a=`1`b=`2` x:tvg-country=`US` tvg.lang=`en`,Adjacent `Quoted` Name",
            "http://s/4",
            "#EXTINF:-1 tvg-name=`Café 🇺🇸 Ünïcode` tvg-name=`second` group-title=`Sports, Live`,Café `Name`, With Comma",
            "http://s/5",
            "#EXTINF:-1 tvg-name=`A \`B\` C` catchup=`default` catchup-days=`7`,Escaped Quotes",
            "http://s/6",
            "#EXTGRP:From EXTGRP",
            "#EXTINF:-1 tvg-id=`g`,tvg-id=`in-name` Comma Then Attribute",
            "http://s/7",
            "#EXTINF:-1 group-title=`Explicit` tvg-ID=`MiXeD`,",
            "http://s/8",
            "#EXTINF:-1  tvg-id=`  padded  `  ,  Padded Name  ",
            "   http://s/9   ",
            "#EXTINF:-1 tvg-name=`x`" + Chr(769) + " group-title=`G`,Combining Mark",
            "http://s/10"
        ])
    end function

    ' An entry as ChannelListTests builds one: group "G" and a live URL unless options say otherwise.
    function makeEntry(name as string, options as object) as object
        attributes = {}
        if options.extra <> invalid then attributes = options.extra
        if options.tvgID <> invalid then attributes["tvg-id"] = options.tvgID
        if options.tvgName <> invalid then attributes["tvg-name"] = options.tvgName
        group = "G"
        if options.DoesExist("group") then group = options.group
        url = "https://cdn/x/chunks.m3u8"
        if options.url <> invalid then url = options.url
        return { name: name, attributes: attributes, group: group, url: url }
    end function

    function pluck(list as object, key as string) as object
        values = []
        for each item in list
            values.Push(item[key])
        end for
        return values
    end function

    function entryURLs(playlist as object) as object
        return M3UTests.pluck(playlist.entries, "url")
    end function

    ' "" when both lists have the same items in the named fields, else the first difference:
    ' "<what> <index> <field>: expected …, got …" (or the counts).
    function firstDifference(actual as object, expected as object, what as string, fields as object) as string
        count = actual.Count()
        if expected.Count() < count then count = expected.Count()
        for i = 0 to count - 1
            for each key in fields
                if not LocalTest.same(actual[i][key], expected[i][key])
                    return what + " " + i.ToStr() + " " + key + ": expected " + LocalTest.describe(expected[i][key]) + ", got " + LocalTest.describe(actual[i][key])
                end if
            end for
            if actual[i].Count() <> expected[i].Count()
                return what + " " + i.ToStr() + ": expected fields " + FormatJson(expected[i].Keys()) + ", got " + FormatJson(actual[i].Keys())
            end if
        end for
        if actual.Count() <> expected.Count()
            return what + " count: expected " + expected.Count().ToStr() + ", got " + actual.Count().ToStr()
        end if
        return ""
    end function

end namespace
