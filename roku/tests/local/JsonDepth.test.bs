' JsonDepth (M12 step 24, security N-3, D56): the nesting check ImportBundle and HDHomeRun run before ParseJson.
' Off-device.
namespace JsonDepthTests

    sub test_depthCountsBracketsOutsideStrings(t as object)
        t.assertEqual(JsonDepth.ofText("", 3), 0)
        t.assertEqual(JsonDepth.ofText("1", 3), 0)
        t.assertEqual(JsonDepth.ofText("{}", 3), 1)
        t.assertEqual(JsonDepth.ofText("[{""a"":[1]}]", 3), 3)
        t.assertEqual(JsonDepth.ofText("{""a"":""[[[[{{{{""}", 3), 1, "brackets inside strings don't count")
        t.assertEqual(JsonDepth.ofText("{""a"":""\""[[[[""}", 3), 1, "an escaped quote stays in the string")
        t.assertEqual(JsonDepth.ofText("{""a"":""\\""}", 3), 1, "an escaped backslash ends before the quote")
        t.assertEqual(JsonDepth.ofText("{""é"":[""ü→""]}", 3), 2, "other characters don't change it")
        t.assertEqual(JsonDepth.ofText("]", 3), -1, "an unbalanced closer")
        t.assertEqual(JsonDepth.ofText("[[[[[[", 3), 4, "it stops once past the maximum")
    end sub

    sub test_fits(t as object)
        t.assertTrue(JsonDepth.fits("[[[1]]]", 3))
        t.assertFalse(JsonDepth.fits("[[[[1]]]]", 3))
        t.assertFalse(JsonDepth.fits("}{", 3), "unbalanced")
        t.assertFalse(JsonDepth.fits(invalid, 3))
        t.assertFalse(JsonDepth.fits(3, 3))
        t.assertTrue(JsonDepth.fits("", 3), "empty text nests nowhere (ParseJson then refuses it)")
    end sub

    ' The bytes form is ImportBundle.depthOf's (the step 14 tests in Import.test.bs).
    sub test_bytesAndTextAgree(t as object)
        for each text in ["[1,[2,[3]]]", "{""a"":""]""}", "[[[[[", "]"]
            bytes = CreateObject("roByteArray")
            bytes.FromAsciiString(text)
            t.assertEqual(JsonDepth.ofBytes(bytes, 3), JsonDepth.ofText(text, 3), text)
            t.assertEqual(ImportBundle.depthOf(bytes), JsonDepth.ofBytes(bytes, ImportBundle.maximumDepth), text)
        end for
    end sub

end namespace
