{
  "extends": "bsconfig.json",
  "files": [
    "manifest",
    "source/**/*",
    "components/**/*",
    "images/**/*",
    "data/**/*",
    {
      "src": "../MMTVL/IPTV/Teams/college-teams.json",
      "dest": "data/college-teams.json"
    },
    {
      "src": "tests/**/*.spec.bs",
      "dest": "source/tests"
    }
  ],
  "stagingDir": "out/test-staging",
  "outFile": "out/mmtvl-live-tv-test.zip",
  "plugins": [
    "rooibos-roku",
    "@rokucommunity/bslint"
  ],
  "rooibos": {
    "showOnlyFailures": false,
    "catchCrashes": true
  }
}
