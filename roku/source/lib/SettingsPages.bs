' Settings' pages (M12 step 13; frames LQwUy, wjg72, DEDBc and B94oz in design/roku-live-tv.pen, approved
' 2026-11-21): a port of MMTVL's SettingsModel+Pages (Settings/SettingsModel+Pages.swift: rootSections,
' remoteInputSections, aboutSections, liveTVSections, guidesSection, channelsSection, iptvGroupsSections,
' iptvHiddenChannelsSections, guideSourceSections, confirmRemoveIPTVSections) for the Roku: MMTVL's pages, wording
' and footers, with keyboard rows for the paste rows and no Preview on Home, plus the Roku-only Device, Import from
' MMTVL and About pages. Step 18: Live TV → My Teams (iptvTeamsSections, iptvLeagueSections,
' iptvConferenceSections): the leagues with their picked counts, a pro league's teams or a college league's
' conferences, a conference's teams, and the Matching switches. Pure functions over SettingsStatus.make's model, so
' no URL ever reaches a row. Uses SettingsStatus (countText), URLDisplay (separator) and TeamPicker (the team lists,
' over model.teamCatalog: TeamsTask's slim catalog, which SettingsScreen adds; invalid until it arrives).
'
' Pages are strings: "root", "liveTV", "guide:<cache id>", "groups", "hiddenChannels", "confirmRemoveSource",
' "remoteInput", "device", "import", "about", and (step 18) "teams", "teams:<league>", "teams:<league>:<conference>".
'   sections(page, model, messages) -> [{ id, title, rows, footer, warning }]: title and footer "" for none;
'     warning: the footer is a warning (warningText). messages { playlist, guide }: a refused URL's message, shown
'     as its row's detail (MMTVL's pasteMessage) until the next push or pop.
'   row: { id, title, value, detail, disclosure, dimmed, action, description }: value, detail and description ""
'     for none; action invalid for an info row (never focused), else one of
'       { type: "push", page }, { type: "pop" }
'       { type: "toggle", setting }        channelUpMovesUpList, usePlaylistGuide, channelLogos, teamMatchInitials,
'                                          teamMatchNicknames
'       { type: "toggleTeam", teamID }     add or remove a team (step 18)
'       { type: "editURL", field }         "playlist" or "guide": the scene opens the keyboard
'       { type: "moveGuide", id, step }, { type: "removeGuide", id }
'       { type: "toggleGroupHidden", name }, { type: "unhideChannel", id }
'       { type: "refresh" }, { type: "removeSource" }
'   pageTitle(page, model) -> the title over the columns.
'   focusableIDs(list) -> the ids of the rows with an action, in order; rowWithID(list, id) -> the row or invalid.
'   description(list, id) -> the band's text for a focused row ("" for none).
'   guidePage(id) -> "guide:<id>"; guideIDOf(page) -> the id, or "" when page isn't a guide's.
'
' Step 21: Live TV → Antenna ("antenna"): the Antenna row first in Channels (frame wjg72); with nothing set up,
' Channels with the Antenna row alone while the antenna is off, as MMTVL's liveTVSections. Actions
' { type: "findTuners" } and { type: "editURL", field: "antennaAddress" }; toggles antennaEnabled and antennaGuide.
' messages may carry antennaAddress (a refused typed address).
namespace SettingsPages

    const rootPage = "root"
    const liveTVPage = "liveTV"
    const guidePrefix = "guide:"
    const groupsPage = "groups"
    const hiddenChannelsPage = "hiddenChannels"
    const confirmRemovePage = "confirmRemoveSource"
    const remoteInputPage = "remoteInput"
    const devicePage = "device"
    const importPage = "import"
    const aboutPage = "about"
    const teamsPage = "teams"
    const teamsPrefix = "teams:"
    const antennaPage = "antenna"

    const playlistEditHint = "Type the M3U address on the Roku's keyboard"
    const guideEditHint = "Type an XMLTV address on the Roku's keyboard"
    const guideSourceDescription = "Use the guide the playlist names, or the guides you added. The guides you added are kept either way."
    ' Step 21: Settings → Device's MPEG-2 row (the plan's wording) and Settings → Antenna's footer.
    const mpeg2HiddenText = "Some antenna channels need MPEG-2, which this Roku can't play"
    const channelLogosDescription = "Shows channel logos in the guide and the banner. On at first. On Rokus with 512 MB or less, logos can slow the guide: turn them off if it feels slow."

    function sections(page as string, model as object, messages = invalid as dynamic) as object
        if page = SettingsPages.rootPage then return SettingsPages.rootSections(model)
        if page = SettingsPages.liveTVPage then return SettingsPages.liveTVSections(model, messages)
        if page = SettingsPages.groupsPage then return SettingsPages.groupsSections(model)
        if page = SettingsPages.hiddenChannelsPage then return SettingsPages.hiddenChannelsSections(model)
        if page = SettingsPages.confirmRemovePage then return SettingsPages.confirmRemoveSections()
        if page = SettingsPages.remoteInputPage then return SettingsPages.remoteInputSections(model)
        if page = SettingsPages.devicePage then return SettingsPages.deviceSections(model)
        if page = SettingsPages.importPage then return SettingsPages.importSections()
        if page = SettingsPages.aboutPage then return SettingsPages.aboutSections(model)
        if page = SettingsPages.teamsPage then return SettingsPages.teamsSections(model)
        if page = SettingsPages.antennaPage then return SettingsPages.antennaSections(model, messages)
        teamsAt = SettingsPages.teamsPlace(page)
        if teamsAt <> invalid
            if teamsAt.conference <> "" then return SettingsPages.conferenceSections(model, teamsAt.league, teamsAt.conference)
            return SettingsPages.leagueSections(model, teamsAt.league)
        end if
        guideID = SettingsPages.guideIDOf(page)
        if guideID <> "" then return SettingsPages.guideSections(model, guideID)
        return []
    end function

    function pageTitle(page as string, model as object) as string
        if page = SettingsPages.rootPage then return "Settings"
        if page = SettingsPages.liveTVPage then return "Live TV"
        if page = SettingsPages.groupsPage then return "Groups"
        if page = SettingsPages.hiddenChannelsPage then return "Hidden Channels"
        if page = SettingsPages.confirmRemovePage then return "Remove Live TV Source?"
        if page = SettingsPages.remoteInputPage then return "Remote & Input"
        if page = SettingsPages.devicePage then return "Device"
        if page = SettingsPages.importPage then return "Import from MMTVL"
        if page = SettingsPages.aboutPage then return "About"
        if page = SettingsPages.teamsPage then return "My Teams"
        if page = SettingsPages.antennaPage then return "Antenna"
        teamsAt = SettingsPages.teamsPlace(page)
        if teamsAt <> invalid
            if teamsAt.conference <> "" then return teamsAt.conference
            return TeamCatalog.leagueTitle(teamsAt.league)
        end if
        guideID = SettingsPages.guideIDOf(page)
        if guideID <> ""
            for each guide in model.guides
                if guide.id = guideID then return guide.label
            end for
            return "Guide"
        end if
        return ""
    end function

    function guidePage(id as string) as string
        return SettingsPages.guidePrefix + id
    end function

    function guideIDOf(page as string) as string
        prefix = SettingsPages.guidePrefix
        if Len(page) <= Len(prefix) or Left(page, Len(prefix)) <> prefix then return ""
        return Mid(page, Len(prefix) + 1)
    end function

    function focusableIDs(list as object) as object
        ids = []
        for each section in list
            for each item in section.rows
                if item.action <> invalid then ids.Push(item.id)
            end for
        end for
        return ids
    end function

    function rowWithID(list as object, id as dynamic) as dynamic
        if not SettingsStatus.isText(id) then return invalid
        for each section in list
            for each item in section.rows
                if item.id = id then return item
            end for
        end for
        return invalid
    end function

    function description(list as object, id as dynamic) as string
        found = SettingsPages.rowWithID(list, id)
        if found = invalid then return ""
        return found.description
    end function

    ' --- pages -----------------------------------------------------------------------------------------------

    ' M7g L6: categories only; each opens its page.
    function rootSections(model as object) as object
        liveValue = "Not Set Up"
        if model.hasLiveSource then liveValue = SettingsPages.channelCount(model.totalChannelCount)
        return [SettingsPages.newSection("categories", "", [
            SettingsPages.newRow({ id: "liveTV", title: "Live TV", value: liveValue, disclosure: true, action: SettingsPages.push(SettingsPages.liveTVPage), description: "The playlist, antenna and guides, channel groups, hidden channels and teams." }),
            SettingsPages.newRow({ id: "remoteInput", title: "Remote & Input", disclosure: true, action: SettingsPages.push(SettingsPages.remoteInputPage), description: "Which way Channel Up and Channel Down change channels." }),
            SettingsPages.newRow({ id: "device", title: "Device", value: model.device.modelName, disclosure: true, action: SettingsPages.push(SettingsPages.devicePage), description: "This Roku's model and memory, and the Live TV features that depend on them." }),
            SettingsPages.newRow({ id: "import", title: "Import from MMTVL", disclosure: true, action: SettingsPages.push(SettingsPages.importPage), description: "Bring the playlist, guides, favorites and other Live TV settings over from MMTVL on a Mac." }),
            SettingsPages.newRow({ id: "about", title: "About", value: model.version, disclosure: true, action: SettingsPages.push(SettingsPages.aboutPage), description: "The version and build of MMTVL Live TV." })
        ], "")]
    end function

    function remoteInputSections(model as object) as object
        direction = "Higher Number"
        if model.channelUpMovesUpList then direction = "Up the List"
        return [SettingsPages.newSection("input", "", [
            SettingsPages.newRow({ id: "channelUp", title: "Channel Up", value: direction, action: SettingsPages.toggle("channelUpMovesUpList"), description: "Changes channel in Live TV. Up the List moves up the list like the Up arrow; Higher Number goes to the next number." })
        ], "")]
    end function

    ' M4, M6b, M7f L4, on the Roku: keyboard rows replace the paste rows; no Preview on Home.
    function liveTVSections(model as object, messages as dynamic) as object
        playlist = model.playlist
        playlistRows = []
        if playlist.has
            playlistRows.Push(SettingsPages.newRow({ id: "playlist.info", title: playlist.host, value: SettingsPages.channelCount(playlist.channelCount), detail: playlist.line }))
        end if
        editTitle = "Add Playlist URL…"
        if playlist.has then editTitle = "Change Playlist URL…"
        playlistRows.Push(SettingsPages.newRow({ id: "playlist.edit", title: editTitle, detail: SettingsPages.messageOr(messages, "playlist", SettingsPages.playlistEditHint), action: { type: "editURL", field: "playlist" } }))
        list = [SettingsPages.newSection("playlist", "Playlist", playlistRows, "")]
        ' M7j L13, L14 (step 21): with nothing set up, the Antenna row alone while the antenna is off (so it can be
        ' turned back on), else the Channels section with it.
        if not model.hasLiveSource
            if not SettingsPages.antennaModel(model).enabled
                list.Push(SettingsPages.newSection("channels", "Channels", [SettingsPages.antennaRow(model)], ""))
            else
                list.Push(SettingsPages.channelsSection(model))
            end if
            return list
        end if
        list.Push(SettingsPages.guidesSection(model, messages))
        list.Push(SettingsPages.channelsSection(model))
        refreshText = "Downloads the playlist and the guides again now."
        if not playlist.has then refreshText = "Reads the tuner's channels and downloads the guides again now."
        manageRows = [SettingsPages.newRow({ id: "refresh", title: "Refresh Now", action: { type: "refresh" }, description: refreshText })]
        if playlist.has
            manageRows.Push(SettingsPages.newRow({ id: "removeSource", title: "Remove Live TV Source", disclosure: true, action: SettingsPages.push(SettingsPages.confirmRemovePage), description: "Forgets the playlist and guide addresses on this Roku." }))
        end if
        ' Frame wjg72's Manage footer.
        list.Push(SettingsPages.newSection("manage", "", manageRows, "Addresses are kept on this Roku and never shown in full."))
        return list
    end function

    ' M6b L1: the guides in priority order; typed ones open their own page.
    function guidesSection(model as object, messages as dynamic) as object
        rows = []
        ' M7f L4: a choice only when the playlist names a guide and one was added.
        if model.playlistNamesGuide and model.pastedGuideCount > 0
            source = "Added Guides"
            if model.usePlaylistGuide then source = "Playlist"
            rows.Push(SettingsPages.newRow({ id: "guideSource", title: "Guide Source", value: source, action: SettingsPages.toggle("usePlaylistGuide"), description: SettingsPages.guideSourceDescription }))
        end if
        for i = 0 to model.guides.Count() - 1
            guide = model.guides[i]
            spec = { id: "guide." + guide.id, title: guide.label, detail: guide.line, dimmed: not guide.inUse }
            if guide.fromPlaylist
                spec.value = "From Playlist"
            else
                if guide.inUse then spec.value = (i + 1).ToStr() else spec.value = "Off"
                spec.disclosure = true
                spec.action = SettingsPages.push(SettingsPages.guidePage(guide.id))
            end if
            rows.Push(SettingsPages.newRow(spec))
        end for
        if rows.Count() = 0
            rows.Push(SettingsPages.newRow({ id: "guide.none", title: "No guide", detail: "Type an XMLTV guide address below" }))
        end if
        if model.pastedGuideCount < SettingsStore.maximumGuides
            rows.Push(SettingsPages.newRow({ id: "guide.add", title: "Add Guide…", detail: SettingsPages.messageOr(messages, "guide", SettingsPages.guideEditHint), action: { type: "editURL", field: "guide" } }))
        end if
        count = ""
        if model.playlist.has then count = "Guide data for " + SettingsStatus.grouped(model.matchedChannelCount) + " of " + SettingsStatus.grouped(model.playlist.channelCount) + " channels. "
        return SettingsPages.newSection("guides", "Guides", rows, count + "A channel uses the first guide in this list that has it.")
    end function

    ' M6b L5: groups and hidden channels; favorites and single channels are managed from the guide.
    function channelsSection(model as object) as object
        hiddenGroups = 0
        for each group in model.groups
            if group.hidden then hiddenGroups += 1
        end for
        groupsValue = "All Shown"
        if hiddenGroups > 0 then groupsValue = hiddenGroups.ToStr() + " Hidden"
        hiddenValue = "None"
        if model.hiddenChannels.Count() > 0 then hiddenValue = SettingsStatus.grouped(model.hiddenChannels.Count())
        ' Step 21: the Antenna row first (frame wjg72 draws it). The footer is the frame's (step 20 brought Match
        ' Guide, so "match" is back).
        return SettingsPages.newSection("channels", "Channels", [
            SettingsPages.antennaRow(model),
            SettingsPages.newRow({ id: "groups", title: "Groups", value: groupsValue, disclosure: true, action: SettingsPages.push(SettingsPages.groupsPage), description: "Which groups show in the guide." }),
            SettingsPages.newRow({ id: "hiddenChannels", title: "Hidden Channels", value: hiddenValue, disclosure: true, action: SettingsPages.push(SettingsPages.hiddenChannelsPage), description: "Channels hidden from the guide." }),
            SettingsPages.newRow({ id: "teams", title: "My Teams", value: TeamPicker.teamCountLabel(SettingsPages.pickedTeams(model).Count()), disclosure: true, action: SettingsPages.push(SettingsPages.teamsPage), description: "Your teams' live and upcoming games, pro and college, in the guide's My Teams group." })
        ], "To favorite, hide or match one channel: in the guide, press * on it.")
    end function

    ' --- Antenna (step 21; MMTVL M7j L14, frame wjg72's row; no frame for the page, so MMTVL's wording) ---------

    ' Live TV → Antenna: "1 Tuner · 185 Channels", "Searching…", "No Tuner Found", "Off".
    function antennaRow(model as object) as object
        antenna = SettingsPages.antennaModel(model)
        value = "No Tuner Found"
        if not antenna.enabled
            value = "Off"
        else if antenna.devices.Count() > 0
            value = SettingsStatus.countText(antenna.devices.Count(), "Tuner", "Tuners") + " " + URLDisplay.separator() + " " + SettingsPages.channelCount(antenna.channelCount)
        else if antenna.searching
            value = "Searching…"
        end if
        return SettingsPages.newRow({ id: "antenna", title: "Antenna", value: value, disclosure: true, action: SettingsPages.push(SettingsPages.antennaPage), description: "Channels from an HDHomeRun tuner on your network." })
    end function

    ' Use Antenna; then the tuners (name, tuner count, model and channels: never an address or DeviceID), Find
    ' Tuners and the typed Address; then Guide from SiliconDust and its status. No channel scan on a Roku (the
    ' tuner's own page or MMTVL does that).
    function antennaSections(model as object, messages as dynamic) as object
        antenna = SettingsPages.antennaModel(model)
        list = [SettingsPages.newSection("antenna", "Antenna", [
            SettingsPages.newRow({ id: "antenna.enabled", title: "Use Antenna", value: SettingsPages.onOff(antenna.enabled), action: SettingsPages.toggle("antennaEnabled"), description: "Finds HDHomeRun tuners on your network and adds their channels to Live TV's Antenna group." })
        ], "")]
        if not antenna.enabled then return list
        rows = []
        for i = 0 to antenna.devices.Count() - 1
            device = antenna.devices[i]
            detail = device.model
            channels = antenna.lineupLine
            if channels = "" then channels = SettingsStatus.countText(device.channelCount, "channel", "channels")
            if detail <> "" then detail += " " + URLDisplay.separator() + " " + channels else detail = channels
            rows.Push(SettingsPages.newRow({ id: "antenna.tuner." + i.ToStr(), title: device.name, value: SettingsStatus.countText(device.tunerCount, "tuner", "tuners"), detail: detail }))
        end for
        findLine = antenna.findLine
        if antenna.searching
            findLine = "Searching…"
        else if findLine = "" and antenna.devices.Count() = 0
            findLine = "No HDHomeRun found on this network"
        end if
        rows.Push(SettingsPages.newRow({ id: "antenna.find", title: "Find Tuners", detail: findLine, action: { type: "findTuners" }, description: "Looks for HDHomeRun tuners on your network again." }))
        addressValue = "None"
        if antenna.addressSet then addressValue = "Set"
        addressDetail = antenna.addressLine
        if addressDetail = "" then addressDetail = "Only if Find Tuners doesn't find it"
        rows.Push(SettingsPages.newRow({ id: "antenna.address", title: "Address…", value: addressValue, detail: SettingsPages.messageOr(messages, "antennaAddress", addressDetail), action: { type: "editURL", field: "antennaAddress" }, description: "The tuner's IP address on your network, typed on the Roku's keyboard. It's kept on this Roku and never shown. Choose OK with nothing typed to forget it." }))
        footer = "Channels come from the tuner's lineup. To find them again after moving the antenna, scan for channels on the tuner's own page or in MMTVL."
        if antenna.leftOut = 1
            footer += " 1 protected channel can't play and is left out."
        else if antenna.leftOut > 1
            footer += " " + SettingsStatus.grouped(antenna.leftOut) + " protected channels can't play and are left out."
        end if
        if antenna.mpeg2Hidden > 0 then footer += " " + SettingsPages.mpeg2HiddenText
        list.Push(SettingsPages.newSection("antennaTuners", "Tuners", rows, footer))
        list.Push(SettingsPages.newSection("antennaGuide", "Guide", [
            SettingsPages.newRow({ id: "antenna.guide", title: "Guide from SiliconDust", value: SettingsPages.onOff(antenna.guideOn), action: SettingsPages.toggle("antennaGuide"), description: "Downloads 2 days of listings from SiliconDust (api.hdhomerun.com) about once a day, signed in with your tuner. Off: antenna channels use the guides you added." }),
            SettingsPages.newRow({ id: "antenna.guide.status", title: "Status", detail: antenna.guideLine })
        ], ""))
        return list
    end function

    ' SettingsStatus.antennaOf's model (its defaults when the model has none).
    function antennaModel(model as object) as object
        if type(model.antenna) = "roAssociativeArray" then return model.antenna
        return SettingsStatus.antennaOf(invalid)
    end function

    function onOff(flag as dynamic) as string
        if SettingsStatus.isTrue(flag) then return "On"
        return "Off"
    end function

    function groupsSections(model as object) as object
        rows = []
        for each group in model.groups
            shown = "Shown"
            if group.hidden then shown = "Hidden"
            rows.Push(SettingsPages.newRow({ id: "group." + group.name, title: group.name, value: shown, detail: SettingsStatus.countText(group.channelCount, "channel", "channels"), dimmed: group.hidden, action: { type: "toggleGroupHidden", name: group.name } }))
        end for
        return [SettingsPages.newSection("groups", "", rows, "Hidden groups and their channels don't show in the guide or when changing channels.")]
    end function

    function hiddenChannelsSections(model as object) as object
        rows = []
        for each channel in model.hiddenChannels
            rows.Push(SettingsPages.newRow({ id: "hidden." + channel.id, title: channel.number + "  " + channel.name, value: "Show", detail: channel.group, action: { type: "unhideChannel", id: channel.id } }))
        end for
        if rows.Count() = 0 then rows.Push(SettingsPages.newRow({ id: "hidden.none", title: "No hidden channels" }))
        return [SettingsPages.newSection("hiddenChannels", "", rows, "Select a channel to show it again.")]
    end function

    ' M6b: one typed guide; an id no longer listed (or a url-tvg guide) shows nothing.
    function guideSections(model as object, guideID as string) as object
        typed = []
        for each guide in model.guides
            if not guide.fromPlaylist then typed.Push(guide)
        end for
        index = -1
        for i = 0 to typed.Count() - 1
            if typed[i].id = guideID then index = i
        end for
        if index < 0 then return []
        rows = [SettingsPages.newRow({ id: "guidePage.status", title: "Status", detail: typed[index].line })]
        if index > 0 then rows.Push(SettingsPages.newRow({ id: "guidePage.moveUp", title: "Move Up", action: { type: "moveGuide", id: guideID, step: -1 } }))
        if index < typed.Count() - 1 then rows.Push(SettingsPages.newRow({ id: "guidePage.moveDown", title: "Move Down", action: { type: "moveGuide", id: guideID, step: 1 } }))
        rows.Push(SettingsPages.newRow({ id: "guidePage.remove", title: "Remove Guide", action: { type: "removeGuide", id: guideID } }))
        return [SettingsPages.newSection("guidePage", "", rows, "When two guides have the same channel, the higher one wins.")]
    end function

    ' Cancel first, as MMTVL's confirm pages.
    function confirmRemoveSections() as object
        return [SettingsPages.newSection("confirm", "", [
            SettingsPages.newRow({ id: "confirm.cancel", title: "Cancel", action: { type: "pop" } }),
            SettingsPages.newRow({ id: "confirm.remove", title: "Remove", action: { type: "removeSource" } })
        ], "Forgets the playlist and guide addresses and deletes the downloaded guides.")]
    end function

    ' --- My Teams (step 18; MMTVL M7f L13, M7l L13, M7m L29) -----------------------------------------------------

    ' Pro and College, one row per league with how many of its teams are picked; then Matching.
    function teamsSections(model as object) as object
        picked = SettingsPages.pickedTeams(model)
        pro = []
        college = []
        leagueRows = TeamPicker.items(TeamPicker.level("leagues", "", ""), SettingsPages.teamCatalog(model), picked)
        for each item in leagueRows
            league = item.open.league
            made = SettingsPages.newRow({ id: item.id, title: item.title, value: item.value, disclosure: true, action: SettingsPages.push(SettingsPages.teamsPrefix + league) })
            if TeamCatalog.isCollege(league) then college.Push(made) else pro.Push(made)
        end for
        initials = "Off"
        if SettingsStatus.isTrue(model.teamMatchInitials) then initials = "On"
        nicknames = "Off"
        if SettingsStatus.isTrue(model.teamMatchNicknames) then nicknames = "On"
        return [
            SettingsPages.newSection("leagues.pro", "Pro", pro, ""),
            SettingsPages.newSection("leagues.college", "College", college, "The guide's My Teams group shows your teams' live games, the channels showing them now, and their games in the next 3 days."),
            SettingsPages.newSection("matching", "Matching", [
                SettingsPages.newRow({ id: "teams.matchInitials", title: "Match Initials", value: initials, action: SettingsPages.toggle("teamMatchInitials"), description: "Games named with initials, such as ULM or BYU, count for your teams. Some initials are also pro teams' (BUF, MIA), so other games may show." }),
                SettingsPages.newRow({ id: "teams.matchNicknames", title: "Match Nicknames Alone", value: nicknames, action: SettingsPages.toggle("teamMatchNicknames"), description: "A game that names only a nickname, such as " + Chr(34) + "The Cougars meet the Bearcats" + Chr(34) + ", counts for your teams with that nickname, narrowed by the school or conference when the guide names one." })
            ], "Spelled-out names, such as Louisiana-Monroe or Brigham Young, always count.")
        ]
    end function

    ' A pro league's teams; a college league's conferences.
    function leagueSections(model as object, league as string) as object
        catalog = SettingsPages.teamCatalog(model)
        if catalog = invalid then return [SettingsPages.loadingSection(model)]
        picked = SettingsPages.pickedTeams(model)
        rows = TeamPicker.items(TeamPicker.level("league", league, ""), catalog, picked)
        if not TeamCatalog.isCollege(league) then return [SettingsPages.newSection("teams", "", SettingsPages.teamRows(rows), "Select a team to add or remove it.")]
        made = []
        for each item in rows
            made.Push(SettingsPages.newRow({ id: item.id, title: item.title, value: item.value, disclosure: true, action: SettingsPages.push(SettingsPages.teamsPrefix + league + ":" + item.open.conference) }))
        end for
        return [SettingsPages.newSection("conferences", "", made, "")]
    end function

    ' A college conference's teams.
    function conferenceSections(model as object, league as string, conference as string) as object
        catalog = SettingsPages.teamCatalog(model)
        if catalog = invalid then return [SettingsPages.loadingSection(model)]
        rows = TeamPicker.items(TeamPicker.level("conference", league, conference), catalog, SettingsPages.pickedTeams(model))
        return [SettingsPages.newSection("teams", "", SettingsPages.teamRows(rows), "Select a team to add or remove it.")]
    end function

    ' Settings' team rows: "On" when picked (MMTVL's Settings; the picker says "In My Teams").
    function teamRows(rows as object) as object
        made = []
        for each item in rows
            value = ""
            if item.checked then value = "On"
            made.Push(SettingsPages.newRow({ id: item.id, title: item.title, value: value, action: { type: "toggleTeam", teamID: item.teamID } }))
        end for
        return made
    end function

    ' Before TeamsTask's catalog arrives, or when it couldn't be made (model.teamCatalog { failed: true }; the next
    ' open of Settings asks again). No MMTVL counterpart: its catalog is always there.
    function loadingSection(model as object) as object
        failed = TeamPicker.isFailedCatalog(model.teamCatalog)
        return SettingsPages.newSection("teams", "", [SettingsPages.newRow({ id: "teams.loading", title: TeamPicker.catalogNote(failed) })], "")
    end function

    ' "teams:<league>" or "teams:<league>:<conference>" as { league, conference } ("" for none), else invalid. The
    ' league must be one of TeamCatalog's.
    function teamsPlace(page as string) as dynamic
        prefix = SettingsPages.teamsPrefix
        if Len(page) <= Len(prefix) or Left(page, Len(prefix)) <> prefix then return invalid
        rest = Mid(page, Len(prefix) + 1)
        colon = Instr(1, rest, ":")
        league = rest
        conference = ""
        if colon > 0
            league = Left(rest, colon - 1)
            conference = Mid(rest, colon + 1)
            if conference = "" then return invalid
        end if
        if not TeamCatalog.isLeague(league) then return invalid
        return { league: league, conference: conference }
    end function

    function pickedTeams(model as object) as object
        if type(model.teams) = "roArray" then return model.teams
        return []
    end function

    function teamCatalog(model as object) as dynamic
        catalog = model.teamCatalog
        if type(catalog) <> "roAssociativeArray" then return invalid
        if type(catalog.leagues) <> "roArray" then return invalid
        return catalog
    end function

    ' L7 (frame B94oz): this Roku, then each feature On or Off: <reason>, the guide window in hours. Only Channel
    ' Logos is a switch. L5: the warning when the registry has under 4 KB left.
    function deviceSections(model as object) as object
        device = model.device
        modelValue = device.modelName
        if device.os <> "" then modelValue += " " + URLDisplay.separator() + " " + device.os
        footer = ""
        if model.lowSpace
            footer = "This Roku is almost out of room for settings"
            if SettingsStatus.isNumber(model.spaceLeft) and model.spaceLeft >= 0 then footer += " (" + SettingsStatus.grouped(model.spaceLeft) + " bytes left)"
            footer += ". Guide matches aren't saved until some favorites, hidden channels or guide matches are removed."
        end if
        thisRoku = SettingsPages.newSection("thisRoku", "This Roku", [
            SettingsPages.newRow({ id: "device.model", title: "Model", value: modelValue }),
            SettingsPages.newRow({ id: "device.memory", title: "Memory", value: device.memory + " " + URLDisplay.separator() + " " + device.classLabel })
        ], footer)
        thisRoku.warning = model.lowSpace
        logos = "Off"
        if model.channelLogos then logos = "On"
        mpeg2 = "Off: No MPEG-2"
        if device.mpeg2 then mpeg2 = "On"
        ' Step 21 (D26): AntennaConfig.playMPEG2 off plays H.264 only, whatever the Roku decodes.
        if device.mpeg2 and SettingsStatus.isBoolean(device.mpeg2Switch) and not SettingsStatus.isTrue(device.mpeg2Switch) then mpeg2 = "Off: H.264 Only"
        mpeg2Detail = ""
        if SettingsPages.antennaModel(model).mpeg2Hidden > 0 then mpeg2Detail = SettingsPages.mpeg2HiddenText
        ac3 = "Off: No AC-3"
        if device.ac3 then ac3 = "On"
        features = SettingsPages.newSection("features", "Features", [
            SettingsPages.newRow({ id: "device.guideWindow", title: "Guide Window", value: device.guideHours.ToStr() + " Hours" }),
            SettingsPages.newRow({ id: "device.channelLogos", title: "Channel Logos", value: logos, action: SettingsPages.toggle("channelLogos"), description: SettingsPages.channelLogosDescription }),
            SettingsPages.newRow({ id: "device.compressedGuides", title: "Compressed Guides", value: device.compressed }),
            SettingsPages.newRow({ id: "device.mpeg2", title: "Antenna MPEG-2 Channels", value: mpeg2, detail: mpeg2Detail }),
            SettingsPages.newRow({ id: "device.ac3", title: "Dolby Digital", value: ac3 })
        ], "")
        return [thisRoku, features]
    end function

    ' L2: how to run the export script (step 14 builds the import). Text only.
    function importSections() as object
        return [SettingsPages.newSection("import", "On a Mac with MMTVL", [
            SettingsPages.newRow({ id: "import.run", title: "Run the export script", detail: "python3 -I scripts/roku-export-settings.py" }),
            SettingsPages.newRow({ id: "import.choose", title: "Choose this Roku", detail: "The script lists the Rokus on your network" }),
            SettingsPages.newRow({ id: "import.confirm", title: "Check and replace", detail: "This Roku shows what comes over: choose Replace Settings" })
        ], "Run it from MMTVL's folder, on the same network as this Roku. The playlist, guides, favorites, hidden channels and teams replace this Roku's; nothing is sent back to the Mac.")]
    end function

    ' M7c L28: the version and build. L8: in DEBUG builds a key sequence here opens the Probes screen (SettingsNav).
    function aboutSections(model as object) as object
        return [SettingsPages.newSection("about", "", [
            SettingsPages.newRow({ id: "about.version", title: "Version", value: model.version }),
            SettingsPages.newRow({ id: "about.build", title: "Build", value: model.build })
        ], "Settings are saved on this Roku.")]
    end function

    ' --- helpers ---------------------------------------------------------------------------------------------

    ' "1 Channel", "1,234 Channels".
    function channelCount(count as integer) as string
        return SettingsStatus.countText(count, "Channel", "Channels")
    end function

    function messageOr(messages as dynamic, field as string, fallback as string) as string
        if type(messages) = "roAssociativeArray"
            message = messages[field]
            if SettingsStatus.isText(message)
                if message <> "" then return message
            end if
        end if
        return fallback
    end function

    function push(page as string) as object
        return { type: "push", page: page }
    end function

    function toggle(setting as string) as object
        return { type: "toggle", setting: setting }
    end function

    function newSection(id as string, heading as string, rows as object, footer as string) as object
        return { id: id, title: heading, rows: rows, footer: footer, warning: false }
    end function

    ' A row from a partial spec: missing text fields are "", flags false, action invalid.
    function newRow(spec as object) as object
        made = { id: spec.id, title: "", value: "", detail: "", disclosure: false, dimmed: false, action: invalid, description: "" }
        for each field in ["title", "value", "detail", "description"]
            if SettingsStatus.isText(spec[field]) then made[field] = spec[field]
        end for
        for each field in ["disclosure", "dimmed"]
            if SettingsStatus.isTrue(spec[field]) then made[field] = true
        end for
        if type(spec.action) = "roAssociativeArray" then made.action = spec.action
        return made
    end function

end namespace
