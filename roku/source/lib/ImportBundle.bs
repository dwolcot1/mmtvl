' Import from MMTVL (M12 L2, step 14): the Roku half of scripts/roku-export-settings.py. Pure functions, no nodes;
' ImportTask fetches, MainScene shows the confirm screen (ImportConfirmView) and writes the store
' (SettingsStore.replaceAll).
'
'   parseContentID(text, ownAddresses = invalid) -> { ok, host, port, secret, reason }: the launch's contentId,
'     exactly "mmtvl-import:<IPv4>:<port>:<32 hex>", nothing before or after:
'       - the address a dotted quad (four decimal parts 0-255, no leading zeros) in 10/8, 172.16/12 or 192.168/16
'         (so never loopback, link-local, shared, public or a name), and not one of the Roku's own addresses
'         (ownAddresses: strings; invalid reads them from roDeviceInfo);
'       - the port decimal, 1-65535, no leading zero;
'       - the secret exactly 32 lowercase hex characters (the script's secrets.token_hex; uppercase is refused).
'     reason ("" when ok): "notImport" (another contentId), "badFormat", "badHost", "ownAddress", "badPort",
'     "badSecret". Never logged with the text.
'   checkRequest(request) -> the same verdict for { host, port, secret } (ImportTask checks what it was given).
'   url(request) -> "http://<host>:<port>/<secret>": for roUrlTransfer only; never logged, shown or kept.
'   readFile(path) -> { ok, bundle, reason }: the downloaded file, at most maximumBytes (64 KB) by its size on
'     disk, nested at most maximumDepth deep (checked on the bytes, before ParseJson), then decode's checks.
'   decode(text) -> { ok, bundle, reason }: ParseJson (in a try) and validate.
'   validate(value) -> { ok, bundle, reason }: bundle v1 exactly. Every field present with its type, no other
'     field; version 1 (an integer); playlistURL "" or an http(s) URL with a host Log.host shows, at most 2 KB;
'     guideURLs at most 6 such URLs; favorites, hiddenChannels, hiddenGroups, teams and recentChannelIDs arrays of
'     at most 500 strings of 1-256 characters; overrides an object of at most 500 entries, keys of 1-256
'     characters, values strings of at most 256; lastChannelID and lastGroup strings of at most 256; the six
'     settings booleans. Reasons: "notObject", "badVersion", "unknownField", "missing <field>", "bad <field>".
'   peerAllowed(peer, host) -> true when the transfer reports no address (unverified whether a Roku always does),
'     or the import's own address; a redirect to anything else is refused.
'   summaryRows(bundle, lastChannelLabel) -> [{ label, value }] for the confirm screen (frame NgJ0S): hosts and
'     counts, never a URL.
'   channelLabel(id, channel) -> "<number>  <name>" when the current playlist has the channel, else the id without
'     its "id:" or "name:" prefix; "None" for "".
'   message(reason) -> what the confirm screen says when the import can't be used.
'   handleKey(key, focused, buttonCount) -> { focused, choice }: Left/Right between the buttons, OK picks the
'     focused one (its index as text: "0", "1"), Back answers "back" (the scene treats it as Cancel, D49).
namespace ImportBundle

    const contentPrefix = "mmtvl-import:"
    const maximumBytes = 65536
    const maximumDepth = 3
    const fetchTimeoutSeconds = 15
    const version = 1
    const downloadPath = "tmp:/mmtvl-import.json"

    const title = "Import from MMTVL"
    const question = "Replace this Roku's Live TV settings with these from MMTVL?"
    const footnote = "Your current Live TV settings on this Roku are replaced. Nothing is sent back to the Mac."
    const loadingText = "Getting the settings from the Mac…"
    const replaceLabel = "Replace Settings"
    const cancelLabel = "Cancel"
    const okLabel = "OK"
    const noneValue = "None"

    function parseContentID(text as dynamic, ownAddresses = invalid as dynamic) as object
        if not SettingsStore.isString(text) then return ImportBundle.verdict("notImport")
        prefixLength = Len(ImportBundle.contentPrefix)
        if Left(text, prefixLength) <> ImportBundle.contentPrefix then return ImportBundle.verdict("notImport")
        ' "mmtvl-import:" + 15 + ":" + 5 + ":" + 32 at most.
        if Len(text) > prefixLength + 15 + 1 + 5 + 1 + 32 then return ImportBundle.verdict("badFormat")
        parts = Mid(text, prefixLength + 1).Split(":")
        if parts.Count() <> 3 then return ImportBundle.verdict("badFormat")
        return ImportBundle.checkParts(parts[0], parts[1], parts[2], ownAddresses)
    end function

    function checkRequest(request as dynamic, ownAddresses = invalid as dynamic) as object
        if type(request) <> "roAssociativeArray" then return ImportBundle.verdict("badFormat")
        port = request.port
        if SettingsStore.isNumber(port) then port = Int(port).ToStr()
        return ImportBundle.checkParts(request.host, port, request.secret, ownAddresses)
    end function

    function checkParts(host as dynamic, portText as dynamic, secret as dynamic, ownAddresses as dynamic) as object
        if not ImportBundle.isPrivateIPv4(host) then return ImportBundle.verdict("badHost")
        port = ImportBundle.portNumber(portText)
        if port = 0 then return ImportBundle.verdict("badPort")
        if not ImportBundle.isSecret(secret) then return ImportBundle.verdict("badSecret")
        own = ownAddresses
        if type(own) <> "roArray" then own = URLPolicy.deviceAddresses()
        for each address in own
            if SettingsStore.isString(address)
                if address = host then return ImportBundle.verdict("ownAddress")
            end if
        end for
        result = ImportBundle.verdict("")
        result.host = host
        result.port = port
        result.secret = secret
        return result
    end function

    function verdict(reason as string) as object
        return { ok: reason = "", host: "", port: 0, secret: "", reason: reason }
    end function

    ' A dotted quad (URLPolicy.parseDottedQuad: no leading zeros, 0-255) in RFC 1918 space.
    function isPrivateIPv4(text as dynamic) as boolean
        if not SettingsStore.isString(text) then return false
        if Len(text) < 7 or Len(text) > 15 then return false
        bytes = URLPolicy.parseDottedQuad(text)
        if bytes = invalid then return false
        return URLPolicy.isRFC1918(bytes)
    end function

    ' 1-65535 from 1-5 decimal digits with no leading zero, else 0.
    function portNumber(text as dynamic) as integer
        if not SettingsStore.isString(text) then return 0
        count = Len(text)
        if count < 1 or count > 5 then return 0
        if Left(text, 1) = "0" then return 0
        value = 0
        for i = 1 to count
            code = Asc(Mid(text, i, 1))
            if code < 48 or code > 57 then return 0
            value = value * 10 + (code - 48)
        end for
        if value > 65535 then return 0
        return value
    end function

    function isSecret(text as dynamic) as boolean
        if not SettingsStore.isString(text) then return false
        if Len(text) <> 32 then return false
        for i = 1 to 32
            code = Asc(Mid(text, i, 1))
            if not ((code >= 48 and code <= 57) or (code >= 97 and code <= 102)) then return false
        end for
        return true
    end function

    function url(request as object) as string
        return "http://" + request.host + ":" + request.port.ToStr() + "/" + request.secret
    end function

    function peerAllowed(peer as dynamic, host as string) as boolean
        if not SettingsStore.isString(peer) then return true
        if peer = "" then return true
        return peer = host
    end function

    ' --- reading and checking the bundle ----------------------------------------------------------------------

    function readFile(path as string) as object
        info = CreateObject("roFileSystem").Stat(path)
        if type(info) <> "roAssociativeArray" then return ImportBundle.decoded("noFile")
        if SettingsStore.isNumber(info.size)
            if info.size > ImportBundle.maximumBytes then return ImportBundle.decoded("tooLarge")
        end if
        bytes = CreateObject("roByteArray")
        if not bytes.ReadFile(path) then return ImportBundle.decoded("noFile")
        if bytes.Count() > ImportBundle.maximumBytes then return ImportBundle.decoded("tooLarge")
        if bytes.Count() = 0 then return ImportBundle.decoded("notJSON")
        if ImportBundle.depthOf(bytes) > ImportBundle.maximumDepth then return ImportBundle.decoded("tooDeep")
        return ImportBundle.decode(bytes.ToAsciiString())
    end function

    ' The deepest nesting of [ and { outside JSON strings (-1 for unbalanced closers), on the bytes, so a hostile
    ' file can't make ParseJson recurse deeply.
    function depthOf(bytes as object) as integer
        depth = 0
        deepest = 0
        inString = false
        escaped = false
        for i = 0 to bytes.Count() - 1
            b = bytes[i]
            if inString
                if escaped
                    escaped = false
                else if b = 92
                    escaped = true
                else if b = 34
                    inString = false
                end if
            else if b = 34
                inString = true
            else if b = 91 or b = 123
                depth = depth + 1
                if depth > deepest then deepest = depth
                if deepest > ImportBundle.maximumDepth then return deepest
            else if b = 93 or b = 125
                depth = depth - 1
                if depth < 0 then return -1
            end if
        end for
        return deepest
    end function

    function decode(text as dynamic) as object
        if not SettingsStore.isString(text) then return ImportBundle.decoded("notJSON")
        if Len(text) > ImportBundle.maximumBytes then return ImportBundle.decoded("tooLarge")
        parsed = SettingsStore.parse(text)
        if parsed = invalid then return ImportBundle.decoded("notJSON")
        return ImportBundle.validate(parsed)
    end function

    function decoded(reason as string) as object
        return { ok: false, bundle: invalid, reason: reason }
    end function

    function fields() as object
        return ["version", "playlistURL", "guideURLs", "usePlaylistGuide", "favorites", "hiddenChannels", "hiddenGroups", "teams", "overrides", "lastChannelID", "lastGroup", "recentChannelIDs", "channelUpMovesUpList", "teamMatchInitials", "teamMatchNicknames", "antennaEnabled", "antennaGuide"]
    end function

    function listFields() as object
        return ["favorites", "hiddenChannels", "hiddenGroups", "teams", "recentChannelIDs"]
    end function

    function booleanFields() as object
        return ["usePlaylistGuide", "channelUpMovesUpList", "teamMatchInitials", "teamMatchNicknames", "antennaEnabled", "antennaGuide"]
    end function

    function validate(value as dynamic) as object
        if type(value) <> "roAssociativeArray" then return ImportBundle.decoded("notObject")
        known = {}
        for each name in ImportBundle.fields()
            known[name] = true
        end for
        for each name in value
            if not SettingsStore.isString(name) then return ImportBundle.decoded("unknownField")
            if not known.DoesExist(name) then return ImportBundle.decoded("unknownField")
        end for
        for each name in ImportBundle.fields()
            if not value.DoesExist(name) then return ImportBundle.decoded("missing " + name)
        end for
        kind = LCase(type(value.version))
        if kind <> "integer" and kind <> "roint" and kind <> "rointeger" and kind <> "longinteger" and kind <> "rolonginteger" then return ImportBundle.decoded("badVersion")
        if value.version <> ImportBundle.version then return ImportBundle.decoded("badVersion")
        if not ImportBundle.isBundleURL(value.playlistURL, true) then return ImportBundle.decoded("bad playlistURL")
        if not ImportBundle.isURLList(value.guideURLs) then return ImportBundle.decoded("bad guideURLs")
        for each name in ImportBundle.listFields()
            if not ImportBundle.isIDList(value[name]) then return ImportBundle.decoded("bad " + name)
        end for
        if not ImportBundle.isOverrides(value.overrides) then return ImportBundle.decoded("bad overrides")
        for each name in ["lastChannelID", "lastGroup"]
            if not ImportBundle.isText(value[name], 0) then return ImportBundle.decoded("bad " + name)
        end for
        for each name in ImportBundle.booleanFields()
            if not SettingsStore.isBoolean(value[name]) then return ImportBundle.decoded("bad " + name)
        end for
        bundle = {}
        for each name in ImportBundle.fields()
            bundle[name] = value[name]
        end for
        return { ok: true, bundle: bundle, reason: "" }
    end function

    ' "" (when allowed) or http(s) with a host Log.host shows, at most 2 KB (URLPolicy.isWebURL).
    function isBundleURL(value as dynamic, allowEmpty as boolean) as boolean
        if not SettingsStore.isString(value) then return false
        if value = "" then return allowEmpty
        if Len(value) > SettingsStore.maximumURLLength then return false
        lower = LCase(value)
        if Left(lower, 7) <> "http://" and Left(lower, 8) <> "https://" then return false
        if not URLPolicy.isWebURL(value) then return false
        return Log.host(value) <> ""
    end function

    function isURLList(value as dynamic) as boolean
        if type(value) <> "roArray" then return false
        if value.Count() > SettingsStore.maximumGuides then return false
        for each item in value
            if not ImportBundle.isBundleURL(item, false) then return false
        end for
        return true
    end function

    function isIDList(value as dynamic) as boolean
        if type(value) <> "roArray" then return false
        if value.Count() > SettingsStore.maximumListEntries then return false
        for each item in value
            if not ImportBundle.isText(item, 1) then return false
        end for
        return true
    end function

    function isOverrides(value as dynamic) as boolean
        if type(value) <> "roAssociativeArray" then return false
        if value.Count() > SettingsStore.maximumListEntries then return false
        for each key in value
            ' brs-node iterates an empty key as invalid; a Roku as "". Both are refused.
            if not SettingsStore.isString(key) then return false
            if Len(key) < 1 or Len(key) > SettingsStore.maximumIDLength then return false
            if not ImportBundle.isText(value[key], 0) then return false
        end for
        return true
    end function

    ' A string of minimumLength to 256 characters.
    function isText(value as dynamic, minimumLength as integer) as boolean
        if not SettingsStore.isString(value) then return false
        return Len(value) >= minimumLength and Len(value) <= SettingsStore.maximumIDLength
    end function

    ' --- what the confirm screen shows ------------------------------------------------------------------------

    function summaryRows(bundle as object, lastChannelLabel as string) as object
        playlist = Log.host(bundle.playlistURL)
        if playlist = "" then playlist = ImportBundle.noneValue
        guides = ImportBundle.noneValue
        if bundle.guideURLs.Count() > 0
            hosts = []
            for each guideURL in bundle.guideURLs
                guideHost = Log.host(guideURL)
                if guideHost = "" then guideHost = "?"
                hosts.Push(guideHost)
            end for
            guides = bundle.guideURLs.Count().ToStr() + ": " + hosts.Join(", ")
        end if
        hiddenParts = []
        if bundle.hiddenChannels.Count() > 0 then hiddenParts.Push(ImportBundle.counted(bundle.hiddenChannels.Count(), "channel", "channels"))
        if bundle.hiddenGroups.Count() > 0 then hiddenParts.Push(ImportBundle.counted(bundle.hiddenGroups.Count(), "group", "groups"))
        hidden = ImportBundle.noneValue
        if hiddenParts.Count() > 0 then hidden = hiddenParts.Join(", ")
        matches = ImportBundle.noneValue
        if bundle.overrides.Count() > 0 then matches = bundle.overrides.Count().ToStr() + " set by hand"
        return [
            { label: "Playlist", value: playlist },
            { label: "Guides", value: guides },
            { label: "Favorites", value: ImportBundle.countOrNone(bundle.favorites.Count(), "channel", "channels") },
            { label: "Hidden", value: hidden },
            { label: "My Teams", value: ImportBundle.countOrNone(bundle.teams.Count(), "team", "teams") },
            { label: "Guide matches", value: matches },
            { label: "Last channel", value: lastChannelLabel }
        ]
    end function

    function counted(count as integer, one as string, many as string) as string
        if count = 1 then return "1 " + one
        return count.ToStr() + " " + many
    end function

    function countOrNone(count as integer, one as string, many as string) as string
        if count = 0 then return ImportBundle.noneValue
        return ImportBundle.counted(count, one, many)
    end function

    ' channel: the current playlist's channel with that id (invalid when it has none): number and name, as the
    ' guide shows them; else the id as written, without its kind.
    function channelLabel(id as dynamic, channel as dynamic, number = "" as string) as string
        if not SettingsStore.isString(id) then return ImportBundle.noneValue
        if id = "" then return ImportBundle.noneValue
        if type(channel) = "roAssociativeArray"
            if SettingsStore.isString(channel.name)
                if number = "" then return channel.name
                return number + "  " + channel.name
            end if
        end if
        if Left(id, 3) = "id:" then return Mid(id, 4)
        if Left(id, 5) = "name:" then return Mid(id, 6)
        return id
    end function

    function message(reason as string) as string
        if reason = "tooLarge" then return "The settings from the Mac are larger than this Roku accepts (64 KB). Remove some hidden channels, favorites or guide matches in MMTVL and run the export again."
        if reason = "network" or reason = "timeout" or reason = "http" or reason = "noFile" or reason = "start" then return "Couldn't get the settings from the Mac. Run the export script again; it waits 10 minutes."
        if reason = "peer" then return "The settings came from another address than the Mac's, so they weren't used."
        if reason = "saveFailed" then return "Couldn't save the settings on this Roku."
        return "The settings from the Mac couldn't be read, so nothing changed. Update MMTVL's export script and run it again."
    end function

    function handleKey(key as dynamic, focused as integer, buttonCount as integer) as object
        result = { focused: focused, choice: "" }
        if key = "left" and focused > 0
            result.focused = focused - 1
        else if key = "right" and focused < buttonCount - 1
            result.focused = focused + 1
        else if key = "OK" and focused >= 0 and focused < buttonCount
            result.choice = focused.ToStr()
        else if key = "back"
            result.choice = "back"
        end if
        return result
    end function

end namespace
