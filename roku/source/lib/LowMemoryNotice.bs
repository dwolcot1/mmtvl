' The low-memory notice (M12 L7 as amended 2026-11-21, D56; frame "Low-memory notice" in design/roku-live-tv.pen):
' on a Low-class Roku, the first time the app opens, a notice over whatever opens first names the features that
' are on and may strain the Roku, with OK and Open Settings (Settings → Device). Once either is chosen it never
' shows again: state.lowMemoryNoticeShown in the registry (SettingsStore, key "state", as L7 says). Pure functions,
' no nodes.
'
'   features() -> [{ id, title, setting }]: the features that may strain a Low Roku, each with the settings field
'     that turns it on. Steps 4 and 22 add theirs here; the notice lists only those that are on.
'   items(settings) -> [{ id, title, value: "On" }] for the features whose setting is true (a missing or mistyped
'     setting reads as on: every feature here defaults to on).
'   shouldShow(caps, state, settings) -> true on a Low Roku (Capabilities' deviceClass) whose state hasn't recorded
'     the notice, with at least one item to list (nothing on: nothing to warn about, and the notice stays due).
'   dismissedState(state) -> state with lowMemoryNoticeShown true (the other fields kept).
'   buttons() -> the button ids, left to right: "ok", "openSettings".
'   handleKey(key, focused) -> { focused, choice }: Left/Right move between the buttons (stopping at the ends), OK
'     picks the focused one, and Back answers OK (the orchestrator's decision, 2026-11-21: dismissed for good, and
'     the app never leaves, D49). choice is "" until a button is picked. Every other key does nothing.
namespace LowMemoryNotice

    const title = "This Roku has limited memory"
    const body = "If the guide or channels feel slow, turn these off in Settings → Device."
    const footnote = "Shown once, the first time MMTVL Live TV opens on this Roku."
    const okLabel = "OK"
    const settingsLabel = "Open Settings"
    const onValue = "On"

    function features() as object
        return [
            { id: "channelLogos", title: "Channel Logos", setting: "channelLogos" }
        ]
    end function

    function items(settings as dynamic) as object
        result = []
        for each feature in LowMemoryNotice.features()
            isOn = true
            if LCase(type(settings)) = "roassociativearray"
                value = settings[feature.setting]
                kind = LCase(type(value))
                if kind = "boolean" or kind = "roboolean" then isOn = value
            end if
            if isOn then result.Push({ id: feature.id, title: feature.title, value: LowMemoryNotice.onValue })
        end for
        return result
    end function

    function shouldShow(caps as dynamic, state as dynamic, settings as dynamic) as boolean
        if LCase(type(caps)) <> "roassociativearray" then return false
        if caps.deviceClass <> "Low" then return false
        if LCase(type(state)) = "roassociativearray"
            shown = state.lowMemoryNoticeShown
            kind = LCase(type(shown))
            if (kind = "boolean" or kind = "roboolean") and shown then return false
        end if
        return LowMemoryNotice.items(settings).Count() > 0
    end function

    function buttons() as object
        return ["ok", "openSettings"]
    end function

    function handleKey(key as dynamic, focused as integer) as object
        ids = LowMemoryNotice.buttons()
        result = { focused: focused, choice: "" }
        if key = "left" and focused > 0
            result.focused = focused - 1
        else if key = "right" and focused < ids.Count() - 1
            result.focused = focused + 1
        else if key = "OK" and focused >= 0 and focused < ids.Count()
            result.choice = ids[focused]
        else if key = "back"
            result.choice = "ok"
        end if
        return result
    end function

    function dismissedState(state as dynamic) as object
        result = {}
        if LCase(type(state)) = "roassociativearray"
            for each field in state
                result[field] = state[field]
            end for
        end if
        result["lowMemoryNoticeShown"] = true
        return result
    end function

end namespace
