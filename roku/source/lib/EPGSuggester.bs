' Match Guide's ranked suggestions (M12 step 20): a port of MMTVL's EPGSuggester.rank (MMTVL/IPTV/EPG/EPGSuggester.swift,
' M6b L7). Suggestions only: automatic matching stays exact (EPGMatcher). Pure functions, no nodes; MatchGuideTask
' runs it off the render thread. tests/fixtures/suggestions.golden.json, written by MMTVL's own code, is the contract.
'
'   rank(channel, sources, limit, normalizer) -> [{ guide, sourceID, epgID, name, score }], best first, at most limit
'     channel  { name, tvgName, tvgID } (M3U.makeChannels' fields; tvgName and tvgID may be invalid)
'     sources  [{ sourceID, channels: [{ id, names }] }] in priority order (EPGMatcher's shape; XMLTVScan's lists)
'     guide    the source's 0-based index; epgID the guide channel's id, lowercased (Unicode.lower)
'     name     the guide channel's first display-name, else its id
'     score    0…1 (a Double): the IDF weight of the tokens the guide channel shares with the channel, over the
'              channel's own weight. Only guide channels sharing a token are offered.
'   Ties: fewer extra tokens (the guide channel's tokens the channel hasn't got), then guide order, then id.
'   Tokens are EPGMatcher.tokens' (normalize's tokens, de-duplicated): every name's, plus the id's without its last
'   one ("nflnetwork.us" → "nflnetwork") when it has at least two.
'   idf(token) = ln(1 + N / df), N every guide channel of every source, df the guide channels that have the token
'   (at least 1).
'   ln(x) -> the natural log as a Double. BrightScript's Log is single precision, which would merge scores MMTVL
'     tells apart (and split some it ties), so the log is computed here in Doubles; sums run in sorted token order,
'     so equal token sets always give equal scores.
' Only the channel's own tokens get a document frequency, so nothing but the kept candidates outlives the pass.
'   suggestions(channel, matchData, limit, normalizer) (step 21) -> { suggestions, guideCount }: rank over Match
'     Guide's data, the antenna guide's first for antenna channels (below).
namespace EPGSuggester

    const ln2 = 0.6931471805599453#

    ' Step 21: Match Guide's suggestions for a channel over GuideFetch.matchData (MMTVL's guideMatchOptions): the
    ' pasted and playlist guides ranked (rank, at most limit); an antenna channel (id "antenna:…") gets the antenna
    ' guide's (matchData.antennaIndex) first, ranked on their own (at most limit); playlist channels never get the
    ' antenna guide's. Each suggestion's guide is its index in matchData.guides. { suggestions, guideCount }.
    function suggestions(channel as object, matchData as dynamic, limit as integer, normalizer = invalid as dynamic) as object
        pasted = []
        antennaSource = invalid
        antennaIndex = -1
        if type(matchData) = "roAssociativeArray"
            kind = LCase(type(matchData.antennaIndex))
            if kind = "integer" or kind = "roint" or kind = "rointeger" then antennaIndex = matchData.antennaIndex
            if type(matchData.guides) = "roArray"
                for i = 0 to matchData.guides.Count() - 1
                    list = matchData.guides[i]
                    if type(list) <> "roArray" then list = []
                    if i = antennaIndex then antennaSource = { sourceID: i.ToStr(), channels: list } else pasted.Push({ sourceID: i.ToStr(), channels: list })
                end for
            end if
        end if
        result = []
        isAntenna = false
        if EPGSuggester.isText(channel.id) then isAntenna = Left(channel.id, 8) = "antenna:"
        if antennaSource <> invalid and isAntenna
            for each suggestion in EPGSuggester.rank(channel, [antennaSource], limit, normalizer)
                suggestion.guide = antennaIndex
                result.Push(suggestion)
            end for
        end if
        result.Append(EPGSuggester.rank(channel, pasted, limit, normalizer))
        count = pasted.Count()
        if antennaSource <> invalid then count += 1
        return { suggestions: result, guideCount: count }
    end function

    function rank(channel as object, sources as object, limit as integer, normalizer = invalid as dynamic) as object
        n = normalizer
        if n = invalid then n = EPGMatcher.newNormalizer()
        names = []
        for each field in [channel.name, channel.tvgName]
            if EPGSuggester.isText(field) then names.Push(field)
        end for
        own = EPGSuggester.tokenSet(names, channel.tvgID, n)
        if own.Count() = 0 or limit <= 0 then return []
        ownTokens = own.Keys()
        ownTokens.Sort()
        frequency = EPGMatcher.newSet()
        for each token in ownTokens
            frequency[token] = 0
        end for

        found = []
        entryCount = 0
        for sourceIndex = 0 to sources.Count() - 1
            source = sources[sourceIndex]
            for each epg in source.channels
                entryCount += 1
                tokens = EPGSuggester.tokenSet(epg.names, epg.id, n)
                shared = []
                for each token in ownTokens
                    if tokens.DoesExist(token)
                        frequency[token] = frequency[token] + 1
                        shared.Push(token)
                    end if
                end for
                if shared.Count() > 0
                    shown = epg.id
                    if epg.names.Count() > 0 then shown = epg.names[0]
                    found.Push({ guide: sourceIndex, sourceID: source.sourceID, epgID: Unicode.lower(epg.id, n.nonASCII), name: shown, shared: shared, extra: tokens.Count() - shared.Count() })
                end if
            end for
        end for

        count# = entryCount
        weights = EPGMatcher.newSet()
        total# = 0
        for each token in ownTokens
            documents# = frequency[token]
            if documents# < 1 then documents# = 1
            weight# = EPGSuggester.ln(1# + count# / documents#)
            weights[token] = weight#
            total# = total# + weight#
        end for
        if total# <= 0 then return []

        best = []
        for each entry in found
            sum# = 0
            for each token in entry.shared
                sum# = sum# + weights[token]
            end for
            EPGSuggester.insert(best, { guide: entry.guide, sourceID: entry.sourceID, epgID: entry.epgID, name: entry.name, score: sum# / total#, extra: entry.extra }, limit)
        end for
        result = []
        for each entry in best
            result.Push({ guide: entry.guide, sourceID: entry.sourceID, epgID: entry.epgID, name: entry.name, score: entry.score })
        end for
        return result
    end function

    ' Puts candidate in its place in best (sorted, at most limit long); a candidate after the last place is dropped.
    sub insert(best as object, candidate as object, limit as integer)
        place = best.Count()
        while place > 0
            if not EPGSuggester.isBefore(candidate, best[place - 1]) then exit while
            place -= 1
        end while
        if place >= limit then return
        best.Push(candidate)
        index = best.Count() - 1
        while index > place
            best[index] = best[index - 1]
            index -= 1
        end while
        best[place] = candidate
        if best.Count() > limit then best.Pop()
    end sub

    ' MMTVL's order: score (higher first), extra tokens (fewer first), guide, then id.
    function isBefore(a as object, b as object) as boolean
        if a.score <> b.score then return a.score > b.score
        if a.extra <> b.extra then return a.extra < b.extra
        if a.guide <> b.guide then return a.guide < b.guide
        return a.epgID < b.epgID
    end function

    ' Tokens of every name, plus the id's without its last one (MMTVL's tokenSet), as a case-sensitive set.
    function tokenSet(names as dynamic, id as dynamic, n as object) as object
        set = EPGMatcher.newSet()
        if type(names) = "roArray"
            for each name in names
                if EPGSuggester.isText(name)
                    for each token in EPGMatcher.tokens(name, n)
                        set[token] = true
                    end for
                end if
            end for
        end if
        if EPGSuggester.isText(id)
            idTokens = EPGMatcher.tokens(id, n)
            if idTokens.Count() >= 2
                for i = 0 to idTokens.Count() - 2
                    set[idTokens[i]] = true
                end for
            end if
        end if
        return set
    end function

    ' ln(x) for x > 0 in Doubles: x = m × 2^k with m in [1, 2), then ln m = 2 atanh((m − 1)/(m + 1)) by its series
    ' (|s| ≤ 1/3, so 30 terms are past a Double's precision). Values under 1 are scaled up the same way.
    function ln(value as double) as double
        x# = value
        if x# <= 0 then return 0
        k = 0
        while x# >= 2#
            x# = x# / 2#
            k += 1
        end while
        while x# < 1#
            x# = x# * 2#
            k -= 1
        end while
        s# = (x# - 1#) / (x# + 1#)
        square# = s# * s#
        term# = s#
        series# = 0
        for i = 0 to 29
            series# = series# + term# / (2 * i + 1)
            term# = term# * square#
        end for
        return k * EPGSuggester.ln2 + 2# * series#
    end function

    function isText(value as dynamic) as boolean
        kind = LCase(type(value))
        return kind = "string" or kind = "rostring"
    end function

end namespace
