' Choose Teams (M12 step 18; MMTVL's TeamPicker, IPTV/Teams/TeamPicker.swift, M7l L12, and the lists of Settings →
' Live TV → My Teams, Settings/SettingsModel+Pages.swift iptvTeamsSections, iptvLeagueSections): leagues →
' conferences (college) → teams, over the slim catalog TeamsTask publishes. Pure functions, no nodes. Uses
' TeamCatalog (the leagues, their titles, isCollege), never its file reading.
'
'   slimCatalog(teams) -> catalog: what the picker and Settings need of TeamCatalog's teams (pro then college), made in
'     TeamsTask so the scene never reads the 382 KB college file:
'       { leagues: [{ league, title, college, teams: [{ id, name }], conferences: [{ name, teams: [{ id, name }] }] }],
'         count }
'     Leagues in TeamLeague order. A pro league's teams in catalog order (TeamCatalog.teams(in:)); a college league's
'     conferences as TeamCatalog.conferences(in:) (FBS before FCS, then standardLess), each conference's teams by
'     name (standardLess), and its teams list empty.
'   standardLess(a, b) -> Foundation's localizedStandardCompare(a, b) == .orderedAscending for catalog names:
'     ignoring case and Latin accents, digit runs by value; equal keys by the strings themselves.
'
'   The picker: state { path: [{ kind, league, conference, focus, first }] }, never empty; kind "leagues" (level 1),
'   "league" (a pro league's teams, or a college league's conferences) or "conference" (a college conference's teams).
'     open() -> state at level 1.
'     items(level, catalog, picked) -> the level's rows: [{ id, title, value, checked, teamID, open }]
'       leagues     "league.<league>", the league's title, value onCountLabel (picked teams in it; with no catalog yet,
'                   picked ids starting "<league>."), open { kind: "league", league }
'       college     "conference.<league>.<conference>", its name, onCountLabel, open { kind: "conference", … }
'       teams       "team.<id>", the team's name, value "In My Teams" and checked when picked, teamID
'       A league or conference whose teams the catalog doesn't have yet (catalog invalid) gives [].
'     handle(state, key, press, catalog, picked, visibleRows) -> { state, outcome, teamID }: LiveMenu.handle per
'       level: Up/Down move, clamped; Rewind/Fast Forward and channelup/channeldown a page (visibleRows); OK opens a
'       league or conference (focus on its first row) or toggles a team (outcome "toggle", teamID; the level and its
'       focus stay); Back and * go up a level, focused on the row just left, and from level 1 close (outcome
'       "close"); Left and Right do nothing (as LiveMenu). Releases and other keys: outcome "none". state comes back
'       new; the caller's is never changed.
'     pathText(state) -> the line under the title: "" at level 1, "NBA", "College Football › Big Ten".
'     hint(state) -> the key hint for the level (frame P9pORE draws the conference's teams: "OK: add or remove ·
'       Back: conferences").
'     isPicked(picked, id), pickedSet(picked): picked as an array or a set.
'     catalogNote(failed) -> "Loading teams…" or "Teams couldn't be loaded" (a list that needs the catalog);
'     isFailedCatalog(value) -> whether value is TeamsTask's failed answer passed on ({ failed: true }).
'     onCountLabel(count): "2 On", or "" for none (TeamPicker.onCountLabel); teamCountLabel(count): "None", "1 Team",
'     "3 Teams" (Settings → Live TV → My Teams).
namespace TeamPicker

    const title = "Choose Teams"
    const pickedValue = "In My Teams"

    function slimCatalog(teams as object) as object
        leagues = []
        count = 0
        for each league in TeamCatalog.leagues()
            college = TeamCatalog.isCollege(league)
            inLeague = []
            for each team in teams
                if team.league = league then inLeague.Push(team)
            end for
            count += inLeague.Count()
            entry = { league: league, title: TeamCatalog.leagueTitle(league), college: college, teams: [], conferences: [] }
            if college
                byConference = {}
                byConference.SetModeCaseSensitive()
                names = []
                for each team in inLeague
                    conference = team.conference
                    if not TeamPicker.isText(conference) then conference = ""
                    if not byConference.DoesExist(conference)
                        byConference[conference] = []
                        names.Push(conference)
                    end if
                    byConference[conference].Push({ id: team.id, name: team.name })
                end for
                for each name in TeamPicker.sortedBy(names, "conference")
                    entry.conferences.Push({ name: name, teams: TeamPicker.sortedBy(byConference[name], "name") })
                end for
            else
                for each team in inLeague
                    entry.teams.Push({ id: team.id, name: team.name })
                end for
            end if
            leagues.Push(entry)
        end for
        return { leagues: leagues, count: count }
    end function

    ' --- the picker ---

    function open() as object
        return { path: [TeamPicker.level("leagues", "", "")] }
    end function

    function level(kind as string, league as string, conference as string) as object
        return { kind: kind, league: league, conference: conference, focus: 0, first: 0 }
    end function

    function items(entry as object, catalog as dynamic, picked as dynamic) as object
        set = TeamPicker.pickedSet(picked)
        rows = []
        if entry.kind = "leagues"
            for each league in TeamCatalog.leagues()
                count = 0
                found = TeamPicker.leagueOf(catalog, league)
                if found = invalid
                    prefix = league + "."
                    for each id in set
                        if Left(id, Len(prefix)) = prefix then count++
                    end for
                else
                    count = TeamPicker.pickedIn(TeamPicker.teamsOfLeague(found), set)
                end if
                rows.Push(TeamPicker.row("league." + league, TeamCatalog.leagueTitle(league), TeamPicker.onCountLabel(count), { kind: "league", league: league, conference: "" }, ""))
            end for
            return rows
        end if
        found = TeamPicker.leagueOf(catalog, entry.league)
        if found = invalid then return rows
        if entry.kind = "league" and found.college
            for each conference in found.conferences
                rows.Push(TeamPicker.row("conference." + entry.league + "." + conference.name, conference.name, TeamPicker.onCountLabel(TeamPicker.pickedIn(conference.teams, set)), { kind: "conference", league: entry.league, conference: conference.name }, ""))
            end for
            return rows
        end if
        list = found.teams
        if entry.kind = "conference"
            list = []
            for each conference in found.conferences
                if conference.name = entry.conference then list = conference.teams
            end for
        end if
        for each team in list
            value = ""
            if set.DoesExist(team.id) then value = TeamPicker.pickedValue
            made = TeamPicker.row("team." + team.id, team.name, value, invalid, team.id)
            made.checked = value <> ""
            rows.Push(made)
        end for
        return rows
    end function

    function row(id as string, text as string, value as string, opens as dynamic, teamID as string) as object
        return { id: id, title: text, value: value, checked: false, teamID: teamID, open: opens }
    end function

    function handle(state as object, key as dynamic, press as dynamic, catalog as dynamic, picked as dynamic, visibleRows as integer) as object
        copied = TeamPicker.copyState(state)
        result = { state: copied, outcome: "none", teamID: "" }
        if press <> true or not TeamPicker.isText(key) then return result
        top = copied.path[copied.path.Count() - 1]
        rows = TeamPicker.items(top, catalog, picked)
        pageSize = visibleRows
        if pageSize < 1 then pageSize = 1
        stepSize = 0
        if key = "up"
            stepSize = -1
        else if key = "down"
            stepSize = 1
        else if key = "rewind" or key = "channelup"
            stepSize = -pageSize
        else if key = "fastforward" or key = "channeldown"
            stepSize = pageSize
        else if key = "OK"
            if top.focus < 0 or top.focus >= rows.Count() then return result
            chosen = rows[top.focus]
            if chosen.open <> invalid
                copied.path.Push(TeamPicker.level(chosen.open.kind, chosen.open.league, chosen.open.conference))
            else if chosen.teamID <> ""
                result.outcome = "toggle"
                result.teamID = chosen.teamID
            end if
            return result
        else if key = "back" or key = "options"
            if copied.path.Count() <= 1
                result.outcome = "close"
                return result
            end if
            copied.path.Pop()
            parent = copied.path[copied.path.Count() - 1]
            ' Focus on the league or conference just left (TeamPicker's openAction).
            leftID = "league." + top.league
            if top.kind = "conference" then leftID = "conference." + top.league + "." + top.conference
            parentRows = TeamPicker.items(parent, catalog, picked)
            for i = 0 to parentRows.Count() - 1
                if parentRows[i].id = leftID
                    parent.focus = i
                    exit for
                end if
            end for
            parent.first = TeamPicker.visibleStart(parent.first, parent.focus, parentRows.Count(), pageSize)
            return result
        end if
        if stepSize = 0 or rows.Count() = 0 then return result
        focused = top.focus + stepSize
        if focused < 0 then focused = 0
        if focused > rows.Count() - 1 then focused = rows.Count() - 1
        top.focus = focused
        top.first = TeamPicker.visibleStart(top.first, focused, rows.Count(), pageSize)
        return result
    end function

    function pathText(state as object) as string
        top = state.path[state.path.Count() - 1]
        if top.kind = "leagues" then return ""
        text = TeamCatalog.leagueTitle(top.league)
        if top.kind = "conference" then text = text + " " + Chr(8250) + " " + top.conference
        return text
    end function

    function hint(state as object) as string
        top = state.path[state.path.Count() - 1]
        dot = " " + Chr(183) + " "
        if top.kind = "leagues" then return "OK: open" + dot + "Back: close"
        if top.kind = "conference" then return "OK: add or remove" + dot + "Back: conferences"
        if TeamCatalog.isCollege(top.league) then return "OK: open" + dot + "Back: leagues"
        return "OK: add or remove" + dot + "Back: leagues"
    end function

    ' A new state: the path's levels copied, so the caller's never change.
    function copyState(state as dynamic) as object
        path = []
        if type(state) = "roAssociativeArray"
            if type(state.path) = "roArray"
                for each entry in state.path
                    copied = {}
                    copied.Append(entry)
                    path.Push(copied)
                end for
            end if
        end if
        if path.Count() = 0 then path.Push(TeamPicker.level("leagues", "", ""))
        return { path: path }
    end function

    ' GuideKeys.visibleStart (kept here so TeamsTask needn't load the guide's logic): the first row shown so that
    ' position is in view, moving as little as possible from first, clamped to 0...count - visible.
    function visibleStart(first as integer, position as integer, count as integer, visible as integer) as integer
        start = first
        if position < start then start = position
        if position >= start + visible then start = position - visible + 1
        highest = count - visible
        if highest < 0 then highest = 0
        if start > highest then start = highest
        if start < 0 then start = 0
        return start
    end function

    ' --- lists shared with Settings ---

    function leagueOf(catalog as dynamic, league as string) as dynamic
        if type(catalog) <> "roAssociativeArray" then return invalid
        if type(catalog.leagues) <> "roArray" then return invalid
        for each entry in catalog.leagues
            if entry.league = league then return entry
        end for
        return invalid
    end function

    ' Every team of a slim league entry (a college league's from all its conferences).
    function teamsOfLeague(entry as object) as object
        if not entry.college then return entry.teams
        all = []
        for each conference in entry.conferences
            all.Append(conference.teams)
        end for
        return all
    end function

    function pickedIn(teams as object, set as object) as integer
        count = 0
        for each team in teams
            if set.DoesExist(team.id) then count++
        end for
        return count
    end function

    ' What a list that needs the catalog says without it: "Loading teams…", or after a failure "Teams couldn't be
    ' loaded" (no MMTVL counterpart: its catalog is always there).
    ' { failed: true }: TeamsTask couldn't make the catalog.
    function isFailedCatalog(value as dynamic) as boolean
        if type(value) <> "roAssociativeArray" then return false
        kind = LCase(type(value.failed))
        if kind <> "boolean" and kind <> "roboolean" then return false
        return value.failed
    end function

    function catalogNote(failed as boolean) as string
        if failed then return "Teams couldn't be loaded"
        return "Loading teams" + Chr(8230)
    end function

    ' Settings → Live TV's My Teams value (SettingsModel.teamCountLabel): "None", "1 Team", "3 Teams".
    function teamCountLabel(count as integer) as string
        if count = 0 then return "None"
        if count = 1 then return "1 Team"
        return count.ToStr() + " Teams"
    end function

    function onCountLabel(count as integer) as string
        if count = 0 then return ""
        return count.ToStr() + " On"
    end function

    function pickedSet(picked as dynamic) as object
        if type(picked) = "roAssociativeArray" then return picked
        set = {}
        set.SetModeCaseSensitive()
        if type(picked) = "roArray"
            for each id in picked
                if TeamPicker.isText(id) then set[id] = true
            end for
        end if
        return set
    end function

    function isPicked(picked as dynamic, id as string) as boolean
        return TeamPicker.pickedSet(picked).DoesExist(id)
    end function

    ' --- order ---

    ' "Big Sky (FCS)", "FCS Independents" (TeamCatalog.isFCS).
    function isFCS(conference as string) as boolean
        suffix = " (FCS)"
        if Len(conference) >= Len(suffix) and Right(conference, Len(suffix)) = suffix then return true
        return Left(conference, 4) = "FCS "
    end function

    ' A stable merge sort: field "conference" sorts conference names (FBS first), "name" sorts { name } records.
    function sortedBy(list as object, field as string) as object
        if list.Count() <= 1 then return list
        middle = list.Count() \ 2
        firstHalf = []
        secondHalf = []
        for k = 0 to list.Count() - 1
            if k < middle then firstHalf.Push(list[k]) else secondHalf.Push(list[k])
        end for
        firstHalf = TeamPicker.sortedBy(firstHalf, field)
        secondHalf = TeamPicker.sortedBy(secondHalf, field)
        merged = []
        a = 0
        b = 0
        while a < firstHalf.Count() and b < secondHalf.Count()
            if TeamPicker.before(secondHalf[b], firstHalf[a], field)
                merged.Push(secondHalf[b])
                b++
            else
                merged.Push(firstHalf[a])
                a++
            end if
        end while
        while a < firstHalf.Count()
            merged.Push(firstHalf[a])
            a++
        end while
        while b < secondHalf.Count()
            merged.Push(secondHalf[b])
            b++
        end while
        return merged
    end function

    function before(x as object, y as object, field as string) as boolean
        if field = "conference"
            fcsX = TeamPicker.isFCS(x)
            fcsY = TeamPicker.isFCS(y)
            if fcsX <> fcsY then return not fcsX
            return TeamPicker.standardLess(x, y)
        end if
        return TeamPicker.standardLess(x.name, y.name)
    end function

    function standardLess(a as string, b as string) as boolean
        x = TeamPicker.sortKey(a)
        y = TeamPicker.sortKey(b)
        i = 1
        j = 1
        while i <= Len(x) and j <= Len(y)
            cx = Asc(Mid(x, i, 1))
            cy = Asc(Mid(y, j, 1))
            if TeamPicker.isDigit(cx) and TeamPicker.isDigit(cy)
                endX = TeamPicker.digitsEnd(x, i)
                endY = TeamPicker.digitsEnd(y, j)
                numberX = Val(Mid(x, i, endX - i), 10)
                numberY = Val(Mid(y, j, endY - j), 10)
                if numberX <> numberY then return numberX < numberY
                i = endX
                j = endY
            else
                if cx <> cy then return cx < cy
                i++
                j++
            end if
        end while
        if Len(x) - i <> Len(y) - j then return Len(x) - i < Len(y) - j
        return a < b
    end function

    function digitsEnd(text as string, start as integer) as integer
        i = start
        while i <= Len(text) and TeamPicker.isDigit(Asc(Mid(text, i, 1)))
            i++
        end while
        return i
    end function

    function isDigit(code as integer) as boolean
        return code >= 48 and code <= 57
    end function

    ' Lowercase, Latin accents dropped ("San José" sorts as "san jose").
    function sortKey(text as string) as string
        lowered = LCase(text)
        result = ""
        for i = 1 to Len(lowered)
            code = Asc(Mid(lowered, i, 1))
            if code < 128
                result += Chr(code)
            else
                result += TeamPicker.unaccented(code)
            end if
        end for
        return result
    end function

    function unaccented(code as integer) as string
        groups = [["a", [192, 193, 194, 195, 196, 197, 224, 225, 226, 227, 228, 229]], ["c", [199, 231]], ["e", [200, 201, 202, 203, 232, 233, 234, 235]], ["i", [204, 205, 206, 207, 236, 237, 238, 239]], ["n", [209, 241]], ["o", [210, 211, 212, 213, 214, 216, 242, 243, 244, 245, 246, 248]], ["u", [217, 218, 219, 220, 249, 250, 251, 252]], ["y", [221, 253, 255]]]
        for each group in groups
            for each known in group[1]
                if code = known then return group[0]
            end for
        end for
        return Chr(code)
    end function

    function isText(value as dynamic) as boolean
        kind = LCase(type(value))
        return kind = "string" or kind = "rostring"
    end function

end namespace
