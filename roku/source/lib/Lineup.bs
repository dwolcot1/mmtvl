' The Live TV lineup (M12 step 8): a port of MMTVL's ChannelLineup (IPTV/Sources/ChannelPreferences.swift:52-125)
' and ChannelList.guideGroups / channels(in:of:) (IPTV/Sources/Channel.swift:99-123): what every Live TV list
' shows after favorites and hiding (the guide's groups and rows, zapping). Pure functions, no nodes, so the scene
' can build it again when the preferences change. Linear in the number of channels.
'
' Shapes:
'   Lineup.build(channels, prefs, liveTeamGames = [], upcomingGames = []) -> lineup
'     channels       M3U.makeChannels' channels, playlist order; from step 21 also antenna channels, marked
'                    source: "antenna" and with guideNumber ("5.1"). Others have no source.
'     prefs          SettingsStore's prefs { favorites, hiddenChannels, hiddenGroups, teams }; a missing field or
'                    one that isn't a list reads as [] (ChannelPreferences' tolerant decoding).
'     liveTeamGames  channel ids of the picked teams' live games, in TeamMatcher's order (TeamsTask, step 18).
'     upcomingGames  TeamsTask's upcoming games, soonest first: [{ channelID, programme, label }] (step 18).
'   lineup: plain data (safe in a node field):
'     groups                  "Favorites" when its list isn't empty, "My Teams" whenever a channel is visible,
'                             then guideGroups(visibleChannels): "Antenna", "All Channels", the playlist's groups.
'     visibleChannels         playlist order, without hidden channels and hidden groups.
'     favorites               prefs.favorites order, visible only: the saved favorites (never the team games).
'     favoritesGroupChannels  the guide's Favorites group: teams first, then favorites not already listed.
'     movableFavorites        favorites without the team games (Move Up/Down steps among these).
'     teams                   liveTeamGames, visible only, first of each id: My Teams' live channels.
'     upcomingTeamGames       upcomingGames on visible channels, in order, at most maxUpcomingTeamGames:
'                             [{ channel, programme, label }]. Only the guide's My Teams rows: never zapped through,
'                             never in Favorites (M7l 8c). Hidden channels go before the cap, as ChannelLineup.
'
' Ids and group names compare case-sensitively, as in Swift.
namespace Lineup

    const favoritesGroup = "Favorites"
    const teamsGroup = "My Teams"
    ' A remembered lastGroup of "Teams" (MMTVL before M7l 8c) reads as "My Teams".
    const legacyTeamsGroup = "Teams"
    const allChannelsGroup = "All Channels"
    const antennaGroup = "Antenna"
    ' M7l 8c: at most this many upcoming games in My Teams (ChannelLineup.maxUpcomingTeamGames).
    const maxUpcomingTeamGames = 30

    function build(channels as object, prefs as dynamic, liveTeamGames = [] as object, upcomingGames = [] as object) as object
        if type(prefs) <> "roAssociativeArray" then prefs = {}
        hiddenChannels = Lineup.textSet(prefs.hiddenChannels)
        hiddenGroups = Lineup.textSet(prefs.hiddenGroups)
        visible = []
        byID = {}
        byID.SetModeCaseSensitive()
        for each channel in channels
            if not hiddenChannels.DoesExist(channel.id) and not hiddenGroups.DoesExist(channel.group)
                visible.Push(channel)
                if not byID.DoesExist(channel.id) then byID[channel.id] = channel
            end if
        end for
        saved = Lineup.pick(prefs.favorites, byID)
        liveGames = Lineup.pick(liveTeamGames, byID)
        teamIDs = {}
        teamIDs.SetModeCaseSensitive()
        for each channel in liveGames
            teamIDs[channel.id] = true
        end for
        movable = []
        for each channel in saved
            if not teamIDs.DoesExist(channel.id) then movable.Push(channel)
        end for
        favoritesList = []
        favoritesList.Append(liveGames)
        favoritesList.Append(movable)

        upcoming = []
        if type(upcomingGames) = "roArray"
            for each game in upcomingGames
                if upcoming.Count() >= Lineup.maxUpcomingTeamGames then exit for
                if type(game) = "roAssociativeArray"
                    if Lineup.isText(game.channelID) and type(game.programme) = "roAssociativeArray"
                        channel = byID[game.channelID]
                        if channel <> invalid
                            label = game.label
                            if not Lineup.isText(label) then label = ""
                            upcoming.Push({ channel: channel, programme: game.programme, label: label })
                        end if
                    end if
                end if
            end for
        end if

        names = []
        if favoritesList.Count() > 0 then names.Push(Lineup.favoritesGroup)
        if visible.Count() > 0 then names.Push(Lineup.teamsGroup)
        names.Append(Lineup.guideGroups(visible))
        return {
            groups: names,
            visibleChannels: visible,
            favorites: saved,
            favoritesGroupChannels: favoritesList,
            movableFavorites: movable,
            teams: liveGames,
            upcomingTeamGames: upcoming
        }
    end function

    ' Step 21 (D37): the playlist's part and the antenna's as one channel list, with the guide's and My Teams'
    ' fields: the playlist's channels as they are, then the antenna's numbered after them (MMTVL L2). Each part:
    ' { channels, matchFields, teamFields } (lists, [] when missing). Run off the render thread (PlaylistTask), since
    ' it copies the antenna's channels and is linear in both. { channels, matchFields, teamFields, playlistCount }.
    function mergeParts(playlistSide as dynamic, antennaSide as dynamic) as object
        first = Lineup.listIn(playlistSide, "channels")
        merged = []
        merged.Append(first)
        for each channel in Lineup.listIn(antennaSide, "channels")
            copy = {}
            for each field in channel
                copy[field] = channel[field]
            end for
            copy.number = merged.Count() + 1
            merged.Push(copy)
        end for
        fields = []
        fields.Append(Lineup.listIn(playlistSide, "matchFields"))
        fields.Append(Lineup.listIn(antennaSide, "matchFields"))
        teams = []
        teams.Append(Lineup.listIn(playlistSide, "teamFields"))
        teams.Append(Lineup.listIn(antennaSide, "teamFields"))
        return { channels: merged, matchFields: fields, teamFields: teams, playlistCount: first.Count() }
    end function

    ' The playlist's part of a merged list (its first count entries of each list), for a merge with a new antenna
    ' part that doesn't load the playlist again.
    function playlistPart(merged as object, count as integer) as object
        result = {}
        for each name in ["channels", "matchFields", "teamFields"]
            whole = Lineup.listIn(merged, name)
            part = []
            last = count
            if last > whole.Count() then last = whole.Count()
            for i = 0 to last - 1
                part.Push(whole[i])
            end for
            result[name] = part
        end for
        return result
    end function

    ' D37: what a new antenna lineup answer changes, from the last answer's keys and the new ones ({ matchKey,
    ' payloadKey }, AntennaLineup.setKeys): merge (the scene's channels take the new antenna part) when the payload
    ' key differs; rematch (the guides match again) only when the match key does.
    function antennaChange(previous as object, answer as object) as object
        return { merge: Lineup.textOr(previous.payloadKey) <> Lineup.textOr(answer.payloadKey), rematch: Lineup.textOr(previous.matchKey) <> Lineup.textOr(answer.matchKey) }
    end function

    ' D37 (round 2): what follows a PlaylistTask that ended (answered, or given up by the watchdog): "merge" when a
    ' merge waits (mergePending) or the antenna part changed since the task was given it (taskRevision, -1 after a
    ' stopped merge); else "load" when a playlist load waits; else "". The launch waits while a merge runs or waits
    ' (launchWaits).
    function afterTask(mergePending as boolean, taskRevision as integer, antennaRevision as integer, loadPending as boolean) as string
        if mergePending or taskRevision <> antennaRevision then return "merge"
        if loadPending then return "load"
        return ""
    end function

    function launchWaits(mergeRunning as boolean, mergePending as boolean) as boolean
        return mergeRunning or mergePending
    end function

    ' A PlaylistTask stopped (a new playlist, Remove Live TV Source, an import): nothing waits for it any more, and a
    ' stopped merge is made again by the next task that ends (taskRevision -1), unless the caller merges itself.
    ' { mergePending, taskRevision }.
    function afterStop(wasMerge as boolean, taskRevision as integer) as object
        if wasMerge then return { mergePending: false, taskRevision: -1 }
        return { mergePending: false, taskRevision: taskRevision }
    end function

    function textOr(value as dynamic) as string
        if Lineup.isText(value) then return value
        return ""
    end function

    function listIn(part as dynamic, name as string) as object
        if type(part) <> "roAssociativeArray" then return []
        value = part[name]
        if type(value) = "roArray" then return value
        return []
    end function

    ' Favorites (team games first), My Teams' live channels, All Channels, or a group's visible channels; [] for a
    ' group the lineup doesn't have.
    function channelsIn(current as object, group as dynamic) as object
        if not Lineup.isText(group) then return []
        if group = Lineup.favoritesGroup then return current.favoritesGroupChannels
        if group = Lineup.teamsGroup then return current.teams
        if not Lineup.contains(current.groups, group) then return []
        return Lineup.channelsInGroup(group, current.visibleChannels)
    end function

    ' A remembered group name as the lineup knows it: "Teams" is "My Teams", unless the playlist has a "Teams" group.
    function resolvedGroup(current as object, name as dynamic) as dynamic
        if not Lineup.isText(name) then return name
        if name <> Lineup.legacyTeamsGroup or Lineup.contains(current.groups, Lineup.legacyTeamsGroup) then return name
        return Lineup.teamsGroup
    end function

    function isVisible(current as object, id as string) as boolean
        for each channel in current.visibleChannels
            if channel.id = id then return true
        end for
        return false
    end function

    ' ChannelList.guideGroups (M7j L3): "Antenna" (when a channel's group is "Antenna"), then "All Channels" when
    ' that and the other groups make more than one group, then the other groups in first-appearance order.
    function guideGroups(channels as object) as object
        others = []
        hasAntenna = false
        for each name in Lineup.groupsOf(channels)
            if name = Lineup.antennaGroup then hasAntenna = true else others.Push(name)
        end for
        total = others.Count()
        if hasAntenna then total = total + 1
        result = []
        if hasAntenna then result.Push(Lineup.antennaGroup)
        if total > 1 then result.Push(Lineup.allChannelsGroup)
        result.Append(others)
        return result
    end function

    ' ChannelList.channels(in:of:): every channel for "All Channels" (the playlist's, then the antenna's, as
    ' given), else that group's channels in order; in "Antenna", the antenna channels first, then a playlist group
    ' of that name.
    function channelsInGroup(group as string, channels as object) as object
        if group = Lineup.allChannelsGroup then return channels
        inGroup = []
        later = []
        isAntennaGroup = group = Lineup.antennaGroup
        for each channel in channels
            if channel.group = group
                if isAntennaGroup and not Lineup.isAntenna(channel) then later.Push(channel) else inGroup.Push(channel)
            end if
        end for
        inGroup.Append(later)
        return inGroup
    end function

    ' Distinct groups in first-appearance order (ChannelList.groups; the same as M3U.groups, kept here so the
    ' lineup doesn't need the parser loaded).
    function groupsOf(channels as object) as object
        seen = {}
        seen.SetModeCaseSensitive()
        result = []
        for each channel in channels
            if not seen.DoesExist(channel.group)
                seen[channel.group] = true
                result.Push(channel.group)
            end if
        end for
        return result
    end function

    ' The number shown: the tuner's GuideNumber for antenna channels ("5.1"), else the channel's number.
    function displayNumber(channel as object) as string
        if Lineup.isAntenna(channel)
            if Lineup.isText(channel.guideNumber) then return channel.guideNumber
        end if
        return channel.number.ToStr()
    end function

    function isAntenna(channel as object) as boolean
        source = channel.source
        if not Lineup.isText(source) then return false
        return source = "antenna"
    end function

    ' The channels for ids, in order, each id once, visible ones only (byID: visible channels by id).
    function pick(ids as dynamic, byID as object) as object
        result = []
        if type(ids) <> "roArray" then return result
        seen = {}
        seen.SetModeCaseSensitive()
        for each id in ids
            if Lineup.isText(id)
                if not seen.DoesExist(id)
                    seen[id] = true
                    channel = byID[id]
                    if channel <> invalid then result.Push(channel)
                end if
            end if
        end for
        return result
    end function

    ' A case-sensitive set of the strings in value ({} when it isn't a list).
    function textSet(value as dynamic) as object
        result = {}
        result.SetModeCaseSensitive()
        if type(value) <> "roArray" then return result
        for each item in value
            if Lineup.isText(item) then result[item] = true
        end for
        return result
    end function

    function contains(list as object, value as string) as boolean
        for each item in list
            if item = value then return true
        end for
        return false
    end function

    function isText(value as dynamic) as boolean
        kind = type(value)
        return kind = "String" or kind = "roString"
    end function

end namespace
