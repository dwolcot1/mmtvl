' Channel ↔ guide matching (M12 step 9): a port of MMTVL's EPGMatcher (MMTVL/IPTV/EPG/EPGMatcher.swift, D26),
' with the same rules in the same order. Exact rules only; nothing is fuzzy. Pure functions, no nodes.
' tests/fixtures/matches.golden.json, written by MMTVL's own code, is the contract (GuideGoldenTests).
'
' Shapes:
'   channels  M3U.makeChannels' channels: { id, name (as shown, after feedName), tvgID, tvgName, … }. An antenna
'             channel (id "antenna:<GuideNumber>", step 21) is overridden by its id, any other by its name.
'   sources   [{ sourceID, channels: [{ id, names }] }] in priority order: XMLTVScan.channelList of each guide.
'   overrides { key: EPG id or "" (no guide) }, keys and values in any case (SettingsStore keeps keys lowercased).
'   EPGMatcher.match(channels, sources, overrides) -> { channel id: { guide: <0-based index>, sourceID, epgID } }
'   EPGMatcher.matchOne(channels, epgChannels, overrides) -> { channel id: epgID }, one guide (MMTVL's importer).
' Rule by rule, then guide by guide:
'   1. An override under the channel's own key (antenna id, else name), then its name, then its tvg-id, ignoring
'      case. "" means no guide; a target counts only when some guide has it (the first that does), else the
'      next rules run.
'   2. The tvg-id equals a guide channel id, ignoring case: the first guide that has it.
'   3. The normalized tvg-name, then the normalized name, equals a normalized display-name: per name, the
'      first guide with it; within a guide the first channel with that normalized name.
' normalize folds case and diacritics (Foundation's folding, from a table generated on the Mac by
' tools/gen-epg-fold.swift: every BMP code point as MMTVL folds it after a letter, so a combining mark is dropped),
' turns "&" into " and " and "+" into " plus ",
' splits on anything that isn't a letter or number, drops hd, fhd, uhd, sd, 4k and hevc, and joins the rest.
' Outside the BMP, code points from U+1F000 to U+1FAFF (emoji and other pictographs) separate and the rest
' count as letters (an approximation; MMTVL's names rarely have any).
namespace EPGMatcher

    ' Lowercase and case-sensitive sets and maps throughout: BrightScript AAs ignore key case by default.
    function newSet() as object
        set = {}
        set.SetModeCaseSensitive()
        return set
    end function

    ' The regexes and (on first need) the fold table, made once per run of matching.
    function newNormalizer() as object
        return {
            nonASCII: Unicode.newNonASCIIFinder(),
            ' ASCII that isn't a lowercase letter or digit (after LCase, so A–Z can't occur).
            separator: CreateObject("roRegex", "[\x00-\x2F\x3A-\x60\x7B-\x7F]+", ""),
            dropped: { "hd": true, "fhd": true, "uhd": true, "sd": true, "4k": true, "hevc": true },
            mappings: invalid,
            drops: invalid,
            separators: invalid
        }
    end function

    ' MMTVL's EPGMatcher.normalize: the tokens, joined.
    function normalize(text as string, normalizer = invalid as dynamic) as string
        return EPGMatcher.rawTokens(text, normalizer).Join("")
    end function

    ' MMTVL's EPGMatcher.tokens (M6b L7): normalize's tokens, de-duplicated keeping the first occurrence.
    function tokens(text as string, normalizer = invalid as dynamic) as object
        seen = EPGMatcher.newSet()
        result = []
        for each token in EPGMatcher.rawTokens(text, normalizer)
            if not seen.DoesExist(token)
                seen[token] = true
                result.Push(token)
            end if
        end for
        return result
    end function

    function rawTokens(text as string, normalizer = invalid as dynamic) as object
        n = normalizer
        if n = invalid then n = EPGMatcher.newNormalizer()
        folded = text
        if n.nonASCII.IsMatch(folded) then folded = EPGMatcher.foldNonASCII(folded, n)
        folded = LCase(folded).Replace("&", " and ").Replace("+", " plus ")
        result = []
        for each token in n.separator.Split(folded)
            if token <> "" and not n.dropped.DoesExist(token) then result.Push(token)
        end for
        return result
    end function

    ' Every non-ASCII character folded as Swift folds it after a letter: a mapping, nothing (a combining mark), a
    ' space (a separator), or itself. ASCII is left for rawTokens.
    function foldNonASCII(text as string, n as object) as string
        if n.mappings = invalid then EPGMatcher.loadFoldTable(n)
        parts = []
        count = Len(text)
        for i = 1 to count
            piece = Mid(text, i, 1)
            code = Asc(piece)
            if code >= 128
                mapped = n.mappings[piece]
                if mapped <> invalid
                    piece = mapped
                else if code > 65535
                    if code >= 126976 and code <= 129791 then piece = " "
                else if EPGMatcher.inRanges(code, n.drops)
                    piece = ""
                else if EPGMatcher.inRanges(code, n.separators)
                    piece = " "
                end if
            end if
            parts.Push(piece)
        end for
        return parts.Join("")
    end function

    ' Whether code is in one of ranges ({ starts, ends }, sorted, not overlapping): a binary search.
    function inRanges(code as integer, ranges as object) as boolean
        starts = ranges.starts
        low = 0
        high = starts.Count()
        ' The last range starting at or before code.
        while low < high
            middle = (low + high) \ 2
            if starts[middle] <= code then low = middle + 1 else high = middle
        end while
        if low = 0 then return false
        return code <= ranges.ends[low - 1]
    end function

    sub loadFoldTable(n as object)
        mappings = EPGMatcher.newSet()
        table = EPGMatcher.foldMappings()
        cursor = 1
        length = Len(table)
        while cursor <= length
            code = EPGMatcher.hexValue(Mid(table, cursor, 4))
            count = Val(Mid(table, cursor + 4, 1), 10)
            out = ""
            for i = 0 to count - 1
                out += Chr(EPGMatcher.hexValue(Mid(table, cursor + 5 + i * 4, 4)))
            end for
            mappings[Chr(code)] = out
            cursor += 5 + count * 4
        end while
        n.mappings = mappings
        n.drops = EPGMatcher.parseRanges(EPGMatcher.foldDrops())
        n.separators = EPGMatcher.parseRanges(EPGMatcher.foldSeparators())
    end sub

    ' "SSSSEEEE…" (hex) → { starts, ends }.
    function parseRanges(text as string) as object
        starts = []
        ends = []
        cursor = 1
        length = Len(text)
        while cursor <= length
            starts.Push(EPGMatcher.hexValue(Mid(text, cursor, 4)))
            ends.Push(EPGMatcher.hexValue(Mid(text, cursor + 4, 4)))
            cursor += 8
        end while
        return { starts: starts, ends: ends }
    end function

    function hexValue(hex as string) as integer
        return Val(hex, 16)
    end function

    ' The key an override is saved under (Match Guide, MMTVL's Channel.overrideKey): an antenna channel's id
    ' (names repeat on the tuner, M7j L12), else the name as shown.
    function overrideKey(channel as object) as string
        if Left(channel.id, 8) = "antenna:" then return channel.id
        return channel.name
    end function

    ' One guide, as MMTVL's importer matches: { channel id: epgID }.
    function matchOne(channels as object, epgChannels as object, overrides as object) as object
        result = EPGMatcher.newSet()
        matches = EPGMatcher.match(channels, [{ sourceID: "", channels: epgChannels }], overrides)
        for each id in matches
            result[id] = matches[id].epgID
        end for
        return result
    end function

    ' Every guide in priority order: { channel id: { guide, sourceID, epgID } } for the channels with a guide.
    function match(channels as object, sources as object, overrides as object) as object
        n = EPGMatcher.newNormalizer()
        finder = n.nonASCII
        indexes = []
        for each source in sources
            ids = EPGMatcher.newSet()
            byName = EPGMatcher.newSet()
            for each epg in source.channels
                epgID = Unicode.lower(epg.id, finder)
                ids[epgID] = true
                for each displayName in epg.names
                    key = EPGMatcher.normalize(displayName, n)
                    if key <> "" and not byName.DoesExist(key) then byName[key] = epgID
                end for
            end for
            indexes.Push({ sourceID: source.sourceID, ids: ids, byName: byName })
        end for

        lowerOverrides = EPGMatcher.newSet()
        if overrides <> invalid
            ' Sorted, so that keys differing only in case resolve the same way every time (the last wins).
            keys = []
            for each key in overrides
                keys.Push(key)
            end for
            keys.Sort()
            for each key in keys
                target = overrides[key]
                if LCase(type(target)) = "string" or LCase(type(target)) = "rostring"
                    lowerOverrides[Unicode.lower(key, finder)] = Unicode.lower(target, finder)
                end if
            end for
        end if

        result = EPGMatcher.newSet()
        for each channel in channels
            ref = EPGMatcher.matchChannel(channel, indexes, lowerOverrides, n)
            if ref <> invalid then result[channel.id] = ref
        end for
        return result
    end function

    ' One channel's guide, or invalid.
    function matchChannel(channel as object, indexes as object, lowerOverrides as object, n as object) as dynamic
        finder = n.nonASCII
        ' 1. Overrides.
        target = lowerOverrides[Unicode.lower(EPGMatcher.overrideKey(channel), finder)]
        if target = invalid then target = lowerOverrides[Unicode.lower(channel.name, finder)]
        if target = invalid and channel.tvgID <> invalid then target = lowerOverrides[Unicode.lower(channel.tvgID, finder)]
        if target <> invalid
            if target = "" then return invalid
            ref = EPGMatcher.firstSource(indexes, target)
            if ref <> invalid then return ref
        end if
        ' 2. tvg-id.
        if channel.tvgID <> invalid
            ref = EPGMatcher.firstSource(indexes, Unicode.lower(channel.tvgID, finder))
            if ref <> invalid then return ref
        end if
        ' 3. Normalized names: the tvg-name, then the name.
        candidates = []
        if channel.tvgName <> invalid then candidates.Push(channel.tvgName)
        candidates.Push(channel.name)
        for each candidate in candidates
            key = EPGMatcher.normalize(candidate, n)
            if key <> ""
                for i = 0 to indexes.Count() - 1
                    epgID = indexes[i].byName[key]
                    if epgID <> invalid then return { guide: i, sourceID: indexes[i].sourceID, epgID: epgID }
                end for
            end if
        end for
        return invalid
    end function

    function firstSource(indexes as object, epgID as string) as dynamic
        for i = 0 to indexes.Count() - 1
            if indexes[i].ids.DoesExist(epgID) then return { guide: i, sourceID: indexes[i].sourceID, epgID: epgID }
        end for
        return invalid
    end function

