{
  "rootDir": ".",
  "files": [
    "manifest",
    "source/lib/**/*",
    {
      "src": "components/theme/Theme.bs",
      "dest": "source/theme/Theme.bs"
    },
    {
      "src": "components/probes/ProbeKit.bs",
      "dest": "source/probes/ProbeKit.bs"
    },
    {
      "src": "tests/local/**/*.bs",
      "dest": "source/localtests"
    },
    {
      "src": "tests/fixtures/**/*",
      "dest": "fixtures"
    },
    "data/**/*",
    {
      "src": "../MMTVL/IPTV/Teams/college-teams.json",
      "dest": "data/college-teams.json"
    }
  ],
  "stagingDir": "out/local-staging",
  "retainStagingDir": true,
  "createPackage": false,
  "plugins": [
    "@rokucommunity/bslint"
  ]
}
