{
  "rootDir": ".",
  "files": [
    "manifest",
    "source/**/*",
    "components/**/*",
    "images/**/*",
    "data/**/*",
    "licenses/**/*",
    {
      "src": "../MMTVL/IPTV/Teams/college-teams.json",
      "dest": "data/college-teams.json"
    },
    {
      "src": "out/probe-assets/*",
      "dest": "probes"
    }
  ],
  "stagingDir": "out/staging",
  "retainStagingDir": true,
  "createPackage": true,
  "outFile": "out/mmtvl-live-tv.zip",
  "autoImportComponentScript": true,
  "plugins": [
    "@rokucommunity/bslint"
  ]
}
