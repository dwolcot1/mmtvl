<?xml version="1.0" encoding="utf-8" ?>
<!-- Loads the playlist off the render thread (M12 step 8). Set playlistURL and prefs, then control = "run". The
     task sets result once: { ok: true, host, channels, lineup, guideURLs } or { ok: false, host, status }, where
     status is the text to show ("Couldn't load the playlist (<host>)", or without "(<host>)" when the URL shows no host). On failure the scene keeps the channels it
     has. Step 9 (security L-5): the result also has matchFields (GuideSources.matchFields of the channels: what the
     guide task matches with) and channelsKey (GuideSources.channelsKey of those), made here, off the render
     thread. channels are M3U.makeChannels'; lineup is Lineup.build(channels, prefs, teamIDs, upcomingGames); guideURLs
     are the playlist's url-tvg guides that URLPolicy allows with the playlist as the referrer. Step 18: also
     teamFields, the channels as TeamsTask reads them ([{ id, name, group }]: no URL). Logs show the host only (L6). -->
<component name="PlaylistTask" extends="Task">
    <interface>
        <field id="playlistURL" type="string" />
        <field id="prefs" type="assocarray" />
        <!-- Step 18: My Teams' last results (TeamsTask's liveIDs and upcoming), for the lineup. -->
        <field id="teamIDs" type="array" />
        <field id="upcomingGames" type="array" />
        <!-- Step 21 (D37): the antenna's part { channels, matchFields, teamFields }; the result is the playlist's
             channels then the antenna's (Lineup.mergeParts), with the lineup, fields and key over both, and
             playlistCount. mergeOnly: no download; base is the scene's merged lists and count (its playlist part). -->
        <field id="antenna" type="assocarray" />
        <field id="mergeOnly" type="boolean" value="false" />
        <field id="base" type="assocarray" />
        <field id="result" type="assocarray" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/source/lib/Log.bs" />
    <script type="text/brighterscript" uri="pkg:/source/lib/Unicode.bs" />
    <script type="text/brighterscript" uri="pkg:/source/lib/M3U.bs" />
    <script type="text/brighterscript" uri="pkg:/source/lib/URLPolicy.bs" />
    <script type="text/brighterscript" uri="pkg:/source/lib/Lineup.bs" />
    <script type="text/brighterscript" uri="pkg:/source/lib/Refresh.bs" />
    <script type="text/brighterscript" uri="pkg:/source/lib/SettingsStore.bs" />
    <script type="text/brighterscript" uri="pkg:/source/lib/GuideSources.bs" />
</component>
