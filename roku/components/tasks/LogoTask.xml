<?xml version="1.0" encoding="utf-8" ?>
<!-- Channel logos into cachefs: (M12 step 12, L5; L7 as amended: logos on by default everywhere, Settings → Device
     turns them off). One task for the app's life, started by the scene: the guide's channel cells and the player's
     banner ask for a logo by setting request, and show the cached file when ready names it; nothing on screen ever
     loads a logo URL. Each logo: URLPolicy.allows with the playlist as the referrer (as url-tvg guides: a public
     playlist can't point the Roku at a LAN host), http(s), the CA bundle for https, at most LogoCache.maximumBytes,
     LogoCache.timeoutSeconds, then the address reached is checked (URLPolicy.allowsPeer). A logo that failed isn't
     tried again until the app restarts. Requests wait last in, first out (the rows just scrolled to come first), at
     most LogoCache.maximumQueue, each path once (LogoCache's queue; every pending request is taken in before the
     next download). Logs show hosts and counts only (L6). -->
<component name="LogoTask" extends="Task">
    <interface>
        <!-- The playlist's URL, the referrer for the logo check. Set by the scene before control = "run" and on
             each playlist change (security L-3: another URL-bearing field, on a node outside the scene tree). -->
        <field id="playlistURL" type="string" />
        <!-- In: { url, path }, path = LogoCache.path(url) (anything else is refused). alwaysNotify: every set is a
             request. Step 22: { clear: true } empties the queue (a memory alert turned the logos off); each path
             dropped is answered as not loaded. -->
        <field id="request" type="assocarray" alwaysNotify="true" />
        <!-- Out: { path, ok } once per request that was tried (ok: path now holds the logo), and { path, ok: false }
             for one dropped from the full queue (not remembered as failed: it may be asked for again). -->
        <field id="ready" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/source/lib/Log.bs" />
    <script type="text/brighterscript" uri="pkg:/source/lib/URLPolicy.bs" />
    <script type="text/brighterscript" uri="pkg:/source/lib/Refresh.bs" />
    <script type="text/brighterscript" uri="pkg:/source/lib/LogoCache.bs" />
</component>
