' MatchGuideTask (fields in MatchGuideTask.xml). m.waiting holds the newest request not yet served.

' MMTVL's suggest(for:in:limit:) default.
const suggestionLimit = 30

sub init()
    m.top.functionName = "runMatchGuide"
end sub

sub runMatchGuide()
    port = CreateObject("roMessagePort")
    m.top.observeField("request", port)
    m.normalizer = EPGMatcher.newNormalizer()
    m.waiting = invalid
    while true
        if m.waiting = invalid then takeRequest(Wait(0, port))
        msg = port.GetMessage()
        while msg <> invalid
            takeRequest(msg)
            msg = port.GetMessage()
        end while
        request = m.waiting
        m.waiting = invalid
        if request <> invalid then serve(request)
    end while
end sub

sub takeRequest(msg as dynamic)
    if type(msg) <> "roSGNodeEvent" then return
    data = msg.getData()
    if type(data) = "roAssociativeArray"
        if type(data.channel) = "roAssociativeArray" then m.waiting = data
    end if
end sub

sub serve(request as object)
    channel = request.channel
    try
        #if DEBUG
            timer = CreateObject("roTimespan")
        #end if
        data = invalid
        holder = m.top.guideHolder
        if holder <> invalid then data = holder.matchData
        ' Step 21: an antenna channel gets the antenna guide's suggestions first (MMTVL M7j L12).
        offered = EPGSuggester.suggestions(channel, data, suggestionLimit, m.normalizer)
        suggestions = offered.suggestions
        options = MatchGuide.options(channel, data, request.overrides, suggestions, m.normalizer.nonASCII)
        #if DEBUG
            guideCount = offered.guideCount
            Log.info("Guide", "Match Guide: " + options.candidates.Count().ToStr() + " candidates from " + guideCount.ToStr() + " guide(s) in " + timer.TotalMilliseconds().ToStr() + " ms")
        #end if
        m.top.answer = { serial: request.serial, channelID: channel.id, ok: true, options: options }
    catch e
        ' Never the exception's text: its number only.
        number = "?"
        if type(e) = "roAssociativeArray"
            if e.number <> invalid then number = e.number.ToStr()
        end if
        Log.error("Guide", "Match Guide's options failed (error " + number + ")")
        m.top.answer = { serial: request.serial, channelID: channel.id, ok: false, options: { choice: { kind: "automatic" }, current: invalid, candidates: [] } }
    end try
end sub
