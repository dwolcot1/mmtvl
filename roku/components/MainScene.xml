<?xml version="1.0" encoding="utf-8" ?>
<!-- The screen router (M12). Step 2: the app's name and version. Step 8: loads the settings and the playlist
     (PlaylistTask) at launch, then every 15 minutes when stale, and shows the playlist's status. Step 9: after
     each playlist load and on the 15-minute tick, reads the guides (GuideTask) when one is due (12 h) or the
     guide sources changed. Screens come with steps 10-13 and read the fields below. Step 11: the player
     (PlayerScreen) and the screen router: at launch, once the playlist has answered, the last channel full screen
     if the playlist has it, else the guide; the player's zaps, Replay and Back; the last channel and recents saved
     in state; on a Low Roku's first launch, the low-memory notice over whatever opened first. Until steps 12 and
     13 build them, the guide and Settings → Device are placeholders here (guidePlaceholder, settingsPlaceholder),
     which those steps replace. Back never leaves the app (D49): the scene handles every key that reaches it. -->
<component name="MainScene" extends="Scene">
    <interface>
        <!-- Lineup.build's result for the last playlist that loaded (kept when a later load fails). -->
        <field id="lineup" type="assocarray" />
        <!-- The playlist's url-tvg guides, as URLPolicy allows them (for the guide task, step 9). -->
        <field id="playlistGuideURLs" type="array" />
        <!-- "" after a load, else what to show: "Couldn't load the playlist (<host>)", or without "(<host>)" when there is none. -->
        <field id="playlistStatus" type="string" />
        <!-- Step 9, Settings → Guides: one row per guide in priority order, no URLs (security L-3):
             { index, host, status, problem, matched, fromPlaylist, stale } (GuideFetch.statusRows). Kept when a
             guide task fails. -->
        <field id="guideStatuses" type="array" />
        <!-- "" or a note on the last guide run ("Memory guard inactive: …"). -->
        <field id="guideNote" type="string" />
        <!-- QA-M2 / security M-2 of step 9: the finished GuideTask that holds the programmes in its guideData field
             (GuideFetch.guideData's shape, see GuideFetch.bs: { windowStart, windowEnd, programmeCount, matches,
             guides: [{ programmes, channels }] }; read with GuidePipeline.programmesFor(data, channelID)). The scene
             never copies or relays them. Step 12: when guideRevision changes, read guideHolder.guideData once
             with a plain field get (one copy, in the screen's own logic) and keep it in the screen's m; never
             MoveFromField (it would empty the holder for other readers), never read it per row. invalid until a
             run finishes. -->
        <field id="guideHolder" type="node" />
        <!-- Goes up by 1 each time guideHolder and guideStatuses are replaced; observe this. -->
        <field id="guideRevision" type="integer" value="0" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/source/lib/Log.bs" />
    <script type="text/brighterscript" uri="pkg:/source/lib/SettingsStore.bs" />
    <script type="text/brighterscript" uri="pkg:/source/lib/Refresh.bs" />
    <script type="text/brighterscript" uri="pkg:/source/lib/GuideSources.bs" />
    <!-- Step 10: the Roku look (colours, fonts, sizes, 9-patches); the screens of steps 11-13 read it. -->
    <script type="text/brighterscript" uri="pkg:/components/theme/Theme.bs" />
    <!-- Step 11: launch routing, zapping, recents and the low-memory notice. -->
    <script type="text/brighterscript" uri="pkg:/source/lib/Lineup.bs" />
    <script type="text/brighterscript" uri="pkg:/source/lib/PlayerKeys.bs" />
    <script type="text/brighterscript" uri="pkg:/source/lib/PlayerSession.bs" />
    <script type="text/brighterscript" uri="pkg:/source/lib/URLPolicy.bs" />
    <script type="text/brighterscript" uri="pkg:/source/lib/Capabilities.bs" />
    <script type="text/brighterscript" uri="pkg:/source/lib/LowMemoryNotice.bs" />
    <children>
        <Poster id="background" />
        <!-- Shown once a channel plays; it stays under the guide (still playing) until Back returns to it. -->
        <PlayerScreen id="player" visible="false" />
        <!-- Step 12 replaces this with the guide (GuideScreen). Until then: the app's name, version and playlist
             status; OK plays (the playing channel, else the first visible one), Back returns to the playing channel. -->
        <Group id="guidePlaceholder">
            <Poster id="guideBackground" />
            <Label id="title" text="MMTVL Live TV" />
            <Label id="version" />
            <Label id="status" />
            <Label id="guideHint" text="The guide comes with step 12 · OK: play · Back: the playing channel" />
        </Group>
        <!-- Step 13 replaces this with Settings → Device. Until then the notice's Open Settings comes here; Back or
             OK returns to the screen it came from. -->
        <Group id="settingsPlaceholder" visible="false">
            <Poster id="settingsBackground" />
            <Label id="settingsTitle" text="Settings → Device" />
            <Label id="settingsHint" text="Settings come with step 13 · Back: return" />
        </Group>
    </children>
</component>
