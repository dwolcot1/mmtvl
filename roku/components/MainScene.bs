sub init()
    m.theme = Theme.make()
    styleScreens()
    versionText = appVersionText()
    Log.info("App", "Showing " + versionText)
    ' Step 11: the screens. m.screen is "guide", "player" or "settings" (step 13); m.currentChannel the playing
    ' channel (M3U.makeChannels' shape) or invalid; m.launchPending until the first playlist answer decides what
    ' opens (PlayerSession.launchTarget).
    m.screen = "guide"
    m.settingsReturn = "guide"
    m.currentChannel = invalid
    m.lineup = invalid
    m.notice = invalid
    m.launchPending = true
    ' Step 21: the launch target opens once both the playlist and the antenna have answered.
    m.playlistAnswered = false
    m.channels = []
    ' Step 21 (D37): m.channels, m.guideChannelFields and m.teamFields are the playlist's part (its first
    ' m.playlistCount entries) then the antenna's, merged by PlaylistTask (off the render thread).
    m.playlistCount = 0
    m.teamFields = []
    m.fs = CreateObject("roFileSystem")
    m.player = m.top.findNode("player")
    m.player.observeField("action", "onPlayerAction")
    m.player.observeField("failed", "updatePlayback")
    ' Step 21: a Video error's numbers, for the antenna diagnosis.
    m.player.observeField("failure", "onPlayerFailure")
    #if DEBUG
        ' M12 L8 (step 13): DEBUG builds open the Probes screen from Settings → About (three Replays). Release
        ' builds (bs_const DEBUG=false) have none of this, and no probe files (bsconfig.release.json).
        m.probes = invalid
    #end if
    m.store = SettingsStore.load(SettingsStore.deviceRegistry())
    ' L7: once per launch; the low-memory notice and Settings → Device read it.
    m.caps = Capabilities.detectDevice()
    m.player.channelUpMovesUpList = m.store.settings.channelUpMovesUpList
    ' Step 12: the guide, the channel menu, the logos and the idle return.
    m.menu = m.top.findNode("channelMenu")
    m.menu.observeField("choice", "onMenuChoice")
    m.menu.observeField("input", "noteInput")
    m.menuOpen = false
    m.menuContext = invalid
    m.playerLogoPath = ""
    m.logoTask = CreateObject("roSGNode", "LogoTask")
    m.logoTask.playlistURL = m.store.source
    m.logoTask.observeField("ready", "onLogoReady")
    m.logoTask.control = "run"
    m.guide = m.top.findNode("guide")
    m.guide.version = versionText
    m.guide.settings = SettingsStore.guideSettings(m.store.settings)
    m.guide.logoTask = m.logoTask
    m.guide.observeField("action", "onGuideAction")
    m.guide.observeField("input", "noteInput")
    m.lastInputAt = invalid
    m.idleTimer = m.top.findNode("idleTimer")
    m.idleTimer.observeField("fire", "onIdle")
    ' Step 13: Settings. m.keyboard is the open StandardKeyboardDialog (invalid when none) and m.keyboardField what
    ' it edits ("playlist" or "guide"). m.playlistLoadedAt is the last playlist load's wall-clock time (for "Updated
    ' 6:12 PM"), m.guideStatusByID the last guide run's GuideFetch.statusRows by cache id. m.deferredLaunchID: the
    ' last channel, when the first playlist answer came while Settings showed (PlayerSession.launchRoute); it plays
    ' when Settings closes. m.prefsRevision goes up with every prefs save, and m.playlistPrefsRevision is the one the
    ' running PlaylistTask was given (QA 4: a lineup built from older prefs is built again).
    m.settings = m.top.findNode("settings")
    m.settings.observeField("action", "onSettingsAction")
    m.keyboard = invalid
    m.keyboardField = ""
    m.playlistLoadedAt = invalid
    m.guideStatusByID = {}
    m.deferredLaunchID = ""
    m.prefsRevision = 0
    m.playlistPrefsRevision = 0
    ' Step 14: Import from MMTVL. m.importView is the confirm screen while an import is open, m.importTask the
    ' running fetch, m.importBundle the validated bundle waiting for Replace Settings (the only copy of its URLs
    ' outside the store; dropped when the import closes).
    m.importView = invalid
    m.importTask = invalid
    m.importBundle = invalid
    m.importWatchdog = CreateObject("roSGNode", "Timer")
    m.importWatchdog.duration = 2 * ImportBundle.fetchTimeoutSeconds
    m.importWatchdog.repeat = false
    m.importWatchdog.observeField("fire", "onImportWatchdog")
    startTeams()
    startSearch()
    startMatchGuide()
    startAntenna()
    info = CreateObject("roAppInfo")
    m.versionShort = info.GetValue("major_version") + "." + info.GetValue("minor_version")
    m.buildNumber = info.GetValue("build_version")
    updatePlayback()
    openGuide(false)
    showLowMemoryNoticeIfDue()
    startPlaylist()
end sub

' The background, from Theme.bs (step 10). The guide and Settings draw themselves (steps 12, 13).
sub styleScreens()
    canvas = m.theme.canvas
    poster = m.top.findNode("background")
    poster.uri = m.theme.images.background
    poster.loadDisplayMode = "scaleToFill"
    poster.width = canvas.width
    poster.height = canvas.height
end sub

' M12 step 8: the settings, then the playlist at launch and on a 15-minute timer (D40). The channels stay in m, so
' the lineup can be built again when the preferences change; a failed load keeps them.
sub startPlaylist()
    m.channels = []
    m.playlistCount = 0
    m.teamFields = []
    ' Step 21: a merge-only PlaylistTask is running (D37); a merge or a load asked for while a task runs.
    m.playlistTaskIsMerge = false
    m.mergePending = false
    m.playlistLoadPending = false
    m.lastPlaylistLoad = invalid
    m.playlistTask = invalid
    m.refreshTimer = CreateObject("roSGNode", "Timer")
    m.refreshTimer.duration = Refresh.intervalSeconds
    m.refreshTimer.repeat = true
    m.refreshTimer.observeField("fire", "onRefreshTick")
    m.refreshTimer.control = "start"
    ' QA-2, security L-5: a task that never sets its result is given up after twice its own timeout.
    m.playlistWatchdog = CreateObject("roSGNode", "Timer")
    m.playlistWatchdog.duration = Refresh.playlistWatchdogSeconds
    m.playlistWatchdog.repeat = false
    m.playlistWatchdog.observeField("fire", "onPlaylistWatchdog")
    m.playlistHost = ""
    startGuides()
    loadPlaylist()
    ' Step 21: the tuners and their lineups, on the playlist's cadence.
    loadAntenna(false)
end sub

' The 15-minute tick: the playlist when stale; the guides now if no playlist load started, else after it.
sub onRefreshTick()
    refreshPlaylistIfStale()
    if m.playlistTask = invalid then refreshGuideIfDue()
end sub

' The timer's check, and (step 12) the guide's when it opens: a load when there are no channels or the last load
' is more than 10 minutes old (Refresh.isDue, on UpTime, which no clock change moves).
sub refreshPlaylistIfStale()
    if m.playlistCount = 0 or Refresh.isDue(m.lastPlaylistLoad, UpTime(0), Refresh.playlistMaxAgeSeconds)
        loadPlaylist()
    end if
    refreshAntennaIfStale()
end sub

' One load at a time (MMTVL skips a refresh while one runs). Without a playlist URL there's nothing to load.
sub loadPlaylist()
    if m.playlistTask <> invalid
        ' Step 21: a merge (D37) is quick; the load follows it.
        if m.playlistTaskIsMerge then m.playlistLoadPending = true
        return
    end if
    url = m.store.source
    if url = ""
        ' QA-1: the field too, for the screens that read it.
        m.top.playlistStatus = "No Live TV source yet"
        showPlaylistStatus(m.top.playlistStatus)
        m.playlistAnswered = true
        resolveLaunch()
        return
    end if
    m.playlistHost = Log.host(url)
    ' Step 12: the logos' referrer (LogoTask's URLPolicy check).
    m.logoTask.playlistURL = url
    if m.channels.Count() = 0 then showPlaylistStatus("Loading channels…")
    m.playlistTask = newPlaylistTask()
    m.playlistTask.playlistURL = url
    m.playlistTaskIsMerge = false
    m.playlistTask.control = "run"
    m.playlistWatchdog.control = "start"
    refreshSettings()
end sub

' A PlaylistTask with what both kinds of run need: the prefs and My Teams' results for the lineup, and (step 21)
' the antenna's part to merge after the playlist's.
function newPlaylistTask() as object
    task = CreateObject("roSGNode", "PlaylistTask")
    task.prefs = m.store.prefs
    m.playlistPrefsRevision = m.prefsRevision
    ' Step 18: the lineup carries My Teams' last results; newer ones that arrive meanwhile rebuild it.
    task.teamIDs = m.teamIDs
    task.upcomingGames = m.upcomingGames
    m.playlistTeamsRevision = m.teamsRevision
    task.antenna = antennaPart()
    m.playlistAntennaRevision = m.antennaRevision
    task.observeField("result", "onPlaylistResult")
    return task
end function

' Step 21 (D37): the antenna's part changed: PlaylistTask merges it with the playlist's part it has, without loading
' the playlist again (or after the run going now).
sub startMerge()
    if m.playlistTask <> invalid
        m.mergePending = true
        return
    end if
    m.mergePending = false
    task = newPlaylistTask()
    task.mergeOnly = true
    task.base = { channels: m.channels, matchFields: m.guideChannelFields, teamFields: m.teamFields, count: m.playlistCount }
    m.playlistTask = task
    m.playlistTaskIsMerge = true
    task.control = "run"
    m.playlistWatchdog.control = "start"
end sub

function antennaPart() as object
    return { channels: m.antenna.channels, matchFields: m.antenna.matchFields, teamFields: m.antenna.teamFields }
end function

' The task didn't answer in time: drop it (the next refresh may start another) and say so, with the host only.
sub onPlaylistWatchdog()
    task = m.playlistTask
    if task = invalid then return
    task.unobserveField("result")
    task.control = "stop"
    m.playlistTask = invalid
    if m.playlistTaskIsMerge
        ' Step 21: the next antenna or playlist answer merges again.
        m.playlistTaskIsMerge = false
        ' The next task to end merges again (its antenna revision reads as old).
        m.playlistAntennaRevision = -1
        ' A merge asked for meanwhile waits for that next task too (not restarted here, which could loop every
        ' watchdog period), so the launch opens now with the channels there are.
        m.mergePending = false
        Log.error("Antenna", "No answer from the channel merge; keeping the channels there are")
        resolveLaunch()
        if m.playlistLoadPending
            m.playlistLoadPending = false
            loadPlaylist()
        end if
        return
    end if
    Log.error("IPTV", "Playlist from " + m.playlistHost + " failed: no answer from the loader")
    m.top.playlistStatus = Log.withHost("Couldn't load the playlist", m.playlistHost)
    showPlaylistStatus(m.top.playlistStatus)
    m.playlistAnswered = true
    ' Round 2: a merge the load held back starts now (the launch opens after it).
    afterPlaylistTask()
    resolveLaunch()
    refreshSettings()
end sub

sub onPlaylistResult()
    task = m.playlistTask
    if task = invalid then return
    task.unobserveField("result")
    m.playlistTask = invalid
    m.playlistWatchdog.control = "stop"
    wasMerge = m.playlistTaskIsMerge
    m.playlistTaskIsMerge = false
    result = task.result
    if type(result) <> "roAssociativeArray" then return
    if wasMerge
        if result.ok = true then applyMergedChannels(result)
        afterPlaylistTask()
        resolveLaunch()
        refreshGuideIfDue()
        return
    end if
    if result.ok = true
        m.lastPlaylistLoad = UpTime(0)
        m.playlistLoadedAt = CreateObject("roDateTime").AsSeconds()
        m.top.playlistGuideURLs = result.guideURLs
        applyMergedChannels(result)
        m.top.playlistStatus = ""
        loaded = result.playlistCount.ToStr() + " channels"
        if result.host <> "" then loaded += " from " + result.host
        showPlaylistStatus(loaded)
    else
        ' The last channel list stays (MMTVL keeps playlistChannels on a failed refresh).
        m.top.playlistStatus = result.status
        showPlaylistStatus(result.status)
    end if
    updatePlayback()
    m.playlistAnswered = true
    resolveLaunch()
    afterPlaylistTask()
    ' As MMTVL's refreshIfStale: the channels first, then the guides (with the last channels after a failure).
    refreshGuideIfDue()
    refreshSettings()
end sub

' Step 21 (D37): the merged lists and the lineup PlaylistTask built (the playlist's part then the antenna's): only
' assignments here (security L-5 of step 9), except the lineup again when the prefs or My Teams changed meanwhile
' (QA 4).
sub applyMergedChannels(result as object)
    m.channels = result.channels
    m.playlistCount = result.playlistCount
    m.guideChannelFields = result.matchFields
    m.teamFields = result.teamFields
    m.guideState.channelsKey = result.channelsKey
    if m.prefsRevision = m.playlistPrefsRevision and m.teamsRevision = m.playlistTeamsRevision
        m.lineup = result.lineup
        m.top.lineup = result.lineup
        m.guide.lineup = result.lineup
        if m.searchOpen then pushSearchChannels()
    else
        ' QA 4: Groups or Hidden Channels changed while the task ran on the prefs it was given (step 18: or My
        ' Teams' results did).
        rebuildLineup()
    end if
    ' Step 18: My Teams with the new channels.
    m.teamsTask.channels = result.teamFields
    requestTeams()
    updatePlayback()
    refreshSettings()
end sub

' Step 21: what waited for the task that just ended: a merge for a newer antenna part, then a playlist load.
sub afterPlaylistTask()
    nextStep = Lineup.afterTask(m.mergePending, m.playlistAntennaRevision, m.antennaRevision, m.playlistLoadPending)
    if nextStep = "merge"
        m.mergePending = true
        startMerge()
    else if nextStep = "load"
        m.playlistLoadPending = false
        loadPlaylist()
    end if
end sub

' M12 step 9: the guides. m.guideState is GuideSources.isRunDue's state: lastKey, fetchedAt, failures and
' lastChannelsKey come from the last run that answered (all invalid until then, so the first playlist load starts a
' run, which reuses fresh cachefs: files: a relaunch doesn't download them again); channelsKey is the current
' channel set's hash and m.guideChannelFields the fields the task matches (both from PlaylistTask), channelRunAt
' when a run last started for a channel change. Times are wall-clock seconds. No URL is kept in m.guideState.
sub startGuides()
    m.guideTask = invalid
    ' Security M-3: a task the watchdog gave up on, until its state reads "stop" or "done".
    m.abandonedGuideTask = invalid
    m.abandonedSince = invalid
    m.abandonedLogged = false
    m.guideChannelFields = []
    m.guideState = { lastKey: invalid, fetchedAt: invalid, failures: invalid, channelsKey: invalid, lastChannelsKey: invalid, channelRunAt: invalid, failedRunAt: invalid }
    m.guideRunChannelsKey = invalid
    ' Step 13: what Settings asked of the guide runs (GuideRuns: pending, force, deletePending).
    m.guideRuns = GuideRuns.newState()
    ' Step 20: whether the running (or last) guide run was a rematch (cachedOnly), for GuideRuns.runFailed.
    m.guideRunCachedOnly = false
    m.guideWatchdog = CreateObject("roSGNode", "Timer")
    m.guideWatchdog.duration = GuideSources.watchdogSeconds
    m.guideWatchdog.repeat = false
    m.guideWatchdog.observeField("fire", "onGuideWatchdog")
end sub

' One guide run at a time, only with channels to match (as MMTVL), when GuideSources.isRunDue says so: no run yet,
' the sources changed, a guide is due (12 h) and not waiting after a failure, or the channel set changed (at most
' once an hour; after a failed run, "first" and "channels" wait an hour). Never while a task the watchdog gave up
' on is still alive, for at most twice the watchdog (then that task is let go, so a stuck one can't block guide runs
' until a relaunch). Every run reads all guides (from cachefs: where fresh). The URLs stay in this function's
' locals and the task's playlistGuideURLs field.
' Step 13 (GuideRuns): a check while a task is busy marks a run pending, checked again as soon as it answers or is
' let go; Remove Live TV Source's delete happens first, once no task is alive; Refresh Now forces a run.
sub refreshGuideIfDue()
    busy = m.guideTask <> invalid
    if not busy and m.abandonedGuideTask <> invalid
        if isFinishedTask(m.abandonedGuideTask)
            releaseAbandonedGuideTask()
        else if UpTime(0) - m.abandonedSince > 2 * GuideSources.watchdogSeconds
            Log.warn("Guide", "The old guide task still hasn't stopped; no longer waiting for it")
            releaseAbandonedGuideTask()
        else
            if not m.abandonedLogged
                m.abandonedLogged = true
                Log.warn("Guide", "Waiting for the old guide task to stop")
            end if
            busy = true
        end if
    end if
    ' Step 21 (D38, security L-1): not while an AntennaTask, running or given up on, may be writing SiliconDust's
    ' guide file, which every run reads.
    if GuideRuns.antennaBusy(m.antennaGuideDownloading, abandonedAntennaState()) then busy = true
    gated = GuideRuns.gate(m.guideRuns, busy)
    m.guideRuns = gated.runs
    if not gated.go then return
    if gated.deleteFirst then deleteGuideFiles()
    urls = m.top.playlistGuideURLs
    if type(urls) <> "roArray" then urls = []
    sources = GuideSources.chooseSources(m.store.guides, urls, m.store.settings.usePlaylistGuide, m.store.source)
    now = CreateObject("roDateTime").AsSeconds()
    hasChannels = m.channels.Count() > 0
    verdict = invalid
    if hasChannels and not m.guideRuns.force then verdict = GuideSources.isRunDue(sources, m.guideState, now)
    ' QA of step 20: a failed rematch is tried again once the failure wait is over.
    chosen = GuideRuns.choose(m.guideRuns, hasChannels, verdict, GuideRuns.isWaitingAfterFailure(m.guideState.failedRunAt, now))
    m.guideRuns = chosen.runs
    if not chosen.run then return
    ' Refresh Now: every guide is downloaded again (MMTVL's "Downloads the playlist and the guides again now"):
    ' their download times and failure waits are forgotten, so GuideTask fetches them all.
    if chosen.forgetTimes then forgetGuideTimes(sources)
    if chosen.reason = "channels" then m.guideState.channelRunAt = now
    Log.info("Guide", "Reading the guides (" + chosen.reason + ")")
    m.guideRunChannelsKey = m.guideState.channelsKey
    task = CreateObject("roSGNode", "GuideTask")
    task.channels = m.guideChannelFields
    ' QA-M1: the url-tvg list goes in the task's own field, set just before it runs (no getScene() in the task).
    task.playlistGuideURLs = urls
    task.expectedGuides = sources.Count()
    ' Step 20: Match Guide's rematch reads the files there are and downloads nothing.
    task.cachedOnly = chosen.cachedOnly
    m.guideRunCachedOnly = chosen.cachedOnly
    task.observeField("result", "onGuideResult")
    m.guideTask = task
    task.control = "run"
    m.guideWatchdog.control = "start"
    refreshSettings()
end sub

' Refresh Now: no run is alive (refreshGuideIfDue starts one only then), so nothing reads these files meanwhile.
sub forgetGuideTimes(sources as object)
    times = m.guideState.fetchedAt
    failures = m.guideState.failures
    for each source in sources
        paths = GuideSources.cachePaths(source.url)
        m.fs.Delete(paths.time)
        m.fs.Delete(paths.fail)
        if type(times) = "roAssociativeArray" then times.Delete(paths.id)
        if type(failures) = "roAssociativeArray" then failures.Delete(paths.id)
    end for
end sub

function isFinishedTask(task as object) as boolean
    state = LCase(task.state)
    return state = "stop" or state = "done"
end function

' The task didn't answer in time (security M-3): ask it to give up, keep the guide there is, and start no other
' run until its state reads "stop" or "done".
sub onGuideWatchdog()
    task = m.guideTask
    if task = invalid then return
    task.unobserveField("result")
    task.cancel = true
    task.control = "stop"
    task.playlistGuideURLs = []
    m.guideTask = invalid
    m.guideState.failedRunAt = CreateObject("roDateTime").AsSeconds()
    m.guideRuns = GuideRuns.runFailed(m.guideRuns, m.guideRunCachedOnly)
    Log.error("Guide", "No answer from the guide task; keeping the last guide")
    if not isFinishedTask(task)
        m.abandonedGuideTask = task
        m.abandonedSince = UpTime(0)
        m.abandonedLogged = false
        task.observeField("state", "onAbandonedGuideTaskState")
    end if
    ' QA 3: Settings' requests aren't dropped. While the task is still alive the check only marks them pending;
    ' the delete waits until it reads stop or done (onAbandonedGuideTaskState).
    afterGuideRun()
end sub

sub onAbandonedGuideTaskState()
    task = m.abandonedGuideTask
    if task = invalid then return
    if not isFinishedTask(task) then return
    releaseAbandonedGuideTask()
    refreshGuideIfDue()
    ' Step 21: an antenna guide download that waited for this task.
    antennaGuideMayGo()
end sub

sub releaseAbandonedGuideTask()
    m.abandonedGuideTask.unobserveField("state")
    m.abandonedGuideTask = invalid
end sub

' A run that answered replaces the statuses, and its task becomes the programmes' holder (guideHolder; the
' previous holder is let go). A failed one ({ ok: false }: a crash or a cancel) keeps them, and records the failed
' run's time (GuideSources.isRunDue's failedRunAt), so a run that keeps failing isn't started at every tick.
sub onGuideResult()
    task = m.guideTask
    if task = invalid then return
    task.unobserveField("result")
    m.guideTask = invalid
    m.guideWatchdog.control = "stop"
    task.playlistGuideURLs = []
    result = task.result
    ok = false
    if type(result) = "roAssociativeArray" then ok = result.ok = true
    if not ok
        m.guideState.failedRunAt = CreateObject("roDateTime").AsSeconds()
        m.guideRuns = GuideRuns.runFailed(m.guideRuns, m.guideRunCachedOnly)
        Log.warn("Guide", "The guide run failed; keeping the last guide")
        afterGuideRun()
        return
    end if
    m.guideState.failedRunAt = invalid
    m.top.guideHolder = task
    m.top.guideStatuses = result.statuses
    m.top.guideNote = result.note
    m.guideState.fetchedAt = result.fetchedAt
    m.guideState.failures = result.failures
    m.guideState.lastKey = result.sourcesKey
    m.guideState.lastChannelsKey = m.guideRunChannelsKey
    m.top.guideRevision = m.top.guideRevision + 1
    ' Step 12: the guide screen is the reader that keeps the data (GuideReader); the banner gets the playing channel's
    ' list from it. Step 18: TeamsTask reads it too, per match.
    m.guide.guideHolder = task
    m.guide.guideRevision = m.top.guideRevision
    ' Step 18: My Teams with the new guide.
    m.teamsTask.guideHolder = task
    requestTeams()
    ' Step 19: Search's title index is built again from this guide the next time Search needs it.
    if m.searchTask <> invalid
        m.searchTask.guideHolder = task
        m.searchTask.guideRevision = m.top.guideRevision
    end if
    ' Step 20: Match Guide reads the new run's matches and channel lists.
    if m.matchTask <> invalid then m.matchTask.guideHolder = task
    pushProgrammes()
    m.guideStatusByID = statusesByID(result.sourcesKey, result.statuses)
    ' Step 21: the antenna guide's line for Settings and its index for Match Guide's labels.
    m.antennaGuideRow = result.antenna
    m.guideAntennaIndex = result.antennaIndex
    afterGuideRun()
end sub

' Step 13: Settings → Guides' lines, by cache id: the run's sourcesKey names its guides in the order of its status
' rows ("p<id>" or "t<id>", GuideSources.sourcesKey), so a guide moved or added since still finds its own row.
function statusesByID(key as dynamic, statuses as dynamic) as object
    byID = {}
    if not PlayerSession.isText(key) or type(statuses) <> "roArray" then return byID
    parts = key.Split(",")
    for i = 0 to parts.Count() - 1
        if i < statuses.Count() and Len(parts[i]) > 1 then byID[Mid(parts[i], 2)] = statuses[i]
    end for
    return byID
end function

' After a guide run answered, failed or was given up on: what Settings asked for meanwhile (GuideRuns.checkAgain:
' a delete, then a pending or forced run, which GuideSources.isRunDue still decides), then Settings' lines.
sub afterGuideRun()
    if GuideRuns.checkAgain(m.guideRuns) then refreshGuideIfDue()
    ' Step 21 (D38): an antenna guide download that waited for this run.
    antennaGuideMayGo()
    refreshSettings()
end sub

' Step 12: in the guide's info area while there are no channels.
sub showPlaylistStatus(text as string)
    m.guide.status = text
end sub

' "Version <major>.<minor> Build <build>", from the manifest.
function appVersionText() as string
    info = CreateObject("roAppInfo")
    return "Version " + info.GetValue("major_version") + "." + info.GetValue("minor_version") + " Build " + info.GetValue("build_version")
end function


' --- step 11: screens, the player, the notice -------------------------------------------------------------------

' The first playlist answer (loaded, failed, timed out, or no source at all) decides what opens: the last channel
' full screen if the playlist has it, else the guide (MMTVL's LiveTVModel.open). Not when a channel already plays
' (OK in the guide while the playlist loaded). Step 14: it waits while the import confirm shows.
sub resolveLaunch()
    if not m.launchPending then return
    ' Step 21: and the antenna's first answer (its watchdog gives one), so a last antenna channel plays at launch;
    ' whichever answers second opens it.
    if not m.playlistAnswered or not m.antennaAnswered then return
    ' D37: and the merge of the antenna's channels that answer started.
    if Lineup.launchWaits(m.playlistTaskIsMerge, m.mergePending) then return
    ' Step 14: not under an open import (a cold launch with a contentId): Cancel resolves it, Replace loads anew.
    if m.importView <> invalid then return
    m.launchPending = false
    if m.currentChannel <> invalid then return
    target = PlayerSession.launchTarget(m.channels, m.store.state.lastChannelID)
    route = PlayerSession.launchRoute(target, m.screen)
    if route.show = ""
        ' QA 1: Settings (or its keyboard) stays; the launch target waits for Back.
        m.settingsReturn = route.settingsReturn
        m.deferredLaunchID = route.deferredID
        Log.info("Live TV", "Settings is open; the " + target.screen + " opens when it closes")
        return
    end if
    Log.info("Live TV", "Opening the " + target.screen)
    if route.show = "player" then playChannel(target.channel) else openGuide(false)
end sub

' Plays a channel full screen, remembers it in state (last channel, recents) and gives the player Replay's target,
' the channel's programmes and its cached logo.
sub playChannel(channel as object)
    m.currentChannel = channel
    ' Step 21: a channel chosen anew may be retried once again (retryAntennaChannel sets this after its retry).
    m.antennaRetriedID = ""
    saveState(PlayerSession.stateAfterPlaying(m.store.state, channel.id))
    m.player.previousChannelID = PlayerKeys.previousChannelID(m.store.state.recentChannelIDs, channel.id)
    item = PlayerSession.playerItem(channel, playerLogo(channel))
    ' Step 21, MMTVL's tunerBudgetProblem: the app's other antenna streams (none: one Video, which this replaces).
    if PlayerSession.tunerBudgetProblem(channel, []) <> ""
        Log.info("Antenna", "Antenna tuners busy: this app holds them all")
        item.refusal = PlayerSession.busyText(channel.tunerCount)
    end if
    m.player.channel = item
    pushProgrammes()
    showScreen("player")
    updatePlayback()
end sub

' MMTVL's watch: the playing channel goes full screen without a reconnect (with its banner); another plays.
sub watch(id as dynamic)
    channel = PlayerSession.channelByID(m.channels, id)
    if channel = invalid then return
    if m.currentChannel <> invalid and channel.id = m.currentChannel.id and isPlaying()
        returnToPlayer()
    else
        playChannel(channel)
    end if
end sub

sub returnToPlayer()
    showScreen("player")
    m.player.control = "showBanner"
end sub

' A refused save (registry full, a write failed) is logged by the store; the session keeps the new state in memory,
' so Replay and the notice still work until the next save.
sub saveState(state as object)
    result = SettingsStore.save(m.store, "state", state)
    if not result.ok then m.store.state = SettingsStore.normalize("state", state)
end sub

' The playing channel's programmes for the banner: one list, copied from the guide screen (the reader that keeps the
' guide data, step 12; TeamsTask's copy lasts one match).
sub pushProgrammes()
    if m.currentChannel = invalid then return
    list = m.guide.callFunc("programmesFor", m.currentChannel.id)
    if type(list) <> "roArray" then list = []
    m.player.programmes = list
end sub

' The banner's logo: the cached file when LogoTask has it, else "" and a request (onLogoReady sets it). Only with
' Channel Logos on (L7 as amended); LogoTask checks the URL (URLPolicy.allows with the playlist as the referrer).
function playerLogo(channel as object) as string
    m.playerLogoPath = ""
    url = LogoCache.wanted(channel, m.store.settings)
    if url = "" then return ""
    cached = LogoCache.path(url)
    m.playerLogoPath = cached
    if m.fs.Exists(cached) then return cached
    m.logoTask.request = { url: url, path: cached }
    return ""
end function

sub onLogoReady()
    ready = m.logoTask.ready
    if type(ready) <> "roAssociativeArray" then return
    if not PlayerSession.isTrue(ready.ok) or not PlayerSession.isText(ready.path) then return
    if ready.path <> "" and ready.path = m.playerLogoPath then m.player.logo = ready.path
end sub

function isPlaying() as boolean
    return m.currentChannel <> invalid and not m.player.failed
end function

' What Back in the guide and its preview need (LiveTVModel.canReturnToChannel): a channel to go back to, playing or
' (failed or stopped) still in the playlist.
sub updatePlayback()
    hasChannel = m.currentChannel <> invalid
    playing = isPlaying()
    canReturn = playing
    if hasChannel and not playing then canReturn = PlayerSession.channelByID(m.channels, m.currentChannel.id) <> invalid
    m.guide.playback = { hasChannel: hasChannel, canReturn: canReturn, isPlaying: playing }
end sub

sub onPlayerAction()
    action = m.player.action
    if type(action) <> "roAssociativeArray" then return
    kind = action.type
    if kind = "zap"
        if m.currentChannel = invalid or m.lineup = invalid then return
        list = PlayerKeys.zapList(m.lineup, m.store.state.lastGroup, m.currentChannel)
        target = PlayerKeys.zapTarget(list, m.currentChannel.id, action.step)
        if target <> invalid then playChannel(target)
    else if kind = "previousChannel"
        target = PlayerSession.channelByID(m.channels, action.channelID)
        if target <> invalid then playChannel(target)
    else if kind = "openGuide"
        openGuide(true)
    else if kind = "openChannelMenu"
        openChannelMenu(action.channelID, "")
    end if
end sub

' --- step 12: the guide, the channel menu, favorites and hidden channels, the idle return -----------------------

' The guide on the remembered group and the playing channel (MMTVL's openGuide). refreshFirst: also the playlist when
' stale (step 8's decision: the guide asks for it when it opens; not at launch, which has just loaded it).
sub openGuide(refreshFirst as boolean)
    if refreshFirst then refreshPlaylistIfStale()
    channelID = ""
    if m.currentChannel <> invalid then channelID = m.currentChannel.id
    m.guide.callFunc("open", { lastGroup: m.store.state.lastGroup, channelID: channelID })
    showScreen("guide")
    noteInput()
end sub

sub onGuideAction()
    action = m.guide.action
    if type(action) <> "roAssociativeArray" then return
    kind = action.type
    if kind = "play"
        watch(action.channelID)
    else if kind = "channelMenu"
        openChannelMenu(action.channelID, action.group)
    else if kind = "groupChanged"
        state = {}
        state.Append(m.store.state)
        state.lastGroup = action.group
        saveState(state)
    else if kind = "togglePause"
        if m.currentChannel <> invalid then m.player.control = "togglePause"
    else if kind = "returnToChannel"
        returnToChannel(PlayerSession.isTrue(action.reload))
    else if kind = "openSearch"
        openSearch()
    else if kind = "openTeamPicker"
        openTeamPicker()
    else if kind = "openSettings"
        openSettings("root")
    end if
end sub

' M7m L2 (D49): full screen on the playing channel without a reconnect; else the current channel again (a failed
' one retries). GuideKeys only asks when there is one to return to.
sub returnToChannel(reload as boolean)
    if m.currentChannel = invalid then return
    if not reload
        returnToPlayer()
        return
    end if
    channel = PlayerSession.channelByID(m.channels, m.currentChannel.id)
    if channel <> invalid then playChannel(channel)
end sub

' The channel menu over the guide (group: its selected group) or the player (group ""), focused on row focus.
sub openChannelMenu(id as dynamic, group as dynamic, focus = 0 as integer)
    channel = PlayerSession.channelByID(m.channels, id)
    if channel = invalid then return
    if not PlayerSession.isText(group) then group = ""
    ' Step 18: the team rows already in, when the menu opens again on the same channel (after Move Up/Down).
    sides = invalid
    if m.menuContext <> invalid
        if m.menuContext.channelID = channel.id then sides = m.menuContext.teamSides
    end if
    m.menuContext = { channelID: channel.id, group: group, teamSides: sides, teamSerial: -1 }
    rows = ChannelMenu.items(menuItemsContext())
    subtitle = ""
    list = m.guide.callFunc("programmesFor", channel.id)
    current = BannerText.nowNext(list, CreateObject("roDateTime").AsSeconds()).now
    if current <> invalid
        if PlayerSession.isText(current.title) then subtitle = current.title
    end if
    if sides = invalid then requestMenuTeams(channel, current)
    name = ""
    if PlayerSession.isText(channel.name) then name = channel.name
    m.menu.menu = ChannelMenu.make(Lineup.displayNumber(channel) + "  " + name, subtitle, rows, focus, m.theme.layout.liveMenuVisibleRows)
    m.menu.visible = true
    m.menuOpen = true
    focusCurrent()
    noteInput()
end sub

function menuItemsContext() as object
    id = m.menuContext.channelID
    teamItems = []
    if m.menuContext.teamSides <> invalid then teamItems = MyTeams.menuItems(MyTeams.menuTeams(m.menuContext.teamSides, m.store.prefs.teams), m.store.prefs.teams, id)
    matchValue = MatchGuide.rowValue(m.guide.callFunc("matchFor", id), guideLabels())
    return { channelID: id, isFavorite: ChannelMenu.isFavorite(m.store.prefs, id), group: m.menuContext.group, movableIDs: movableIDs(), teamItems: teamItems, matchValue: matchValue }
end function

function movableIDs() as object
    ids = []
    if m.lineup = invalid then return ids
    for each channel in m.lineup.movableFavorites
        ids.Push(channel.id)
    end for
    return ids
end function

sub closeChannelMenu()
    m.menu.visible = false
    m.menuOpen = false
    m.menuContext = invalid
    ' Step 20: a Match Guide still loading never opens after this, and its parent menu is let go.
    m.matchPending = invalid
    m.matchParent = invalid
    focusCurrent()
end sub

' MMTVL's perform for the channel menu: Watch; Add/Remove Favorites and Hide Channel save and close; Move Up/Down
' save and keep the menu open on the same row (or the one now in its place, M6b L8).
sub onMenuChoice()
    choice = m.menu.choice
    if type(choice) <> "roAssociativeArray" or m.menuContext = invalid then return
    ' Step 20: Match Guide's own menu (in the same view): Back or * goes back to the channel menu (D49).
    if isMatchGuideMenu()
        if choice.outcome = "choose" then applyGuideMatch(choice.action) else backToChannelMenu()
        return
    end if
    if choice.outcome <> "choose"
        closeChannelMenu()
        return
    end if
    chosen = choice.action
    kind = chosen.type
    if kind = "openMatchGuide"
        openMatchGuide(chosen.channelID)
    else if kind = "watch"
        closeChannelMenu()
        watch(chosen.channelID)
    else if kind = "moveFavorite"
        if chosen.step < 0 then itemID = "moveUp" else itemID = "moveDown"
        index = ChannelMenu.focusAfterMove(ChannelMenu.items(menuItemsContext()), itemID, 0)
        context = m.menuContext
        applyPrefs(chosen)
        rows = ChannelMenu.items(menuItemsContext())
        openChannelMenu(context.channelID, context.group, ChannelMenu.focusAfterMove(rows, itemID, index))
    else
        applyPrefs(chosen)
        closeChannelMenu()
        ' Step 18: a team added or removed (IPTVLibrary.setTeamPicked: the newest update decides).
        if kind = "toggleTeam" then requestTeams()
    end if
end sub

' Favorites and hidden channels: saved in prefs (SettingsStore), then the lineup is built again (Lineup.build) and
' the guide keeps its group and row. A refused save keeps the change for this session (logged by the store).
sub applyPrefs(chosen as object)
    prefs = ChannelMenu.prefsAfter(m.store.prefs, chosen, movableIDs())
    result = SettingsStore.save(m.store, "prefs", prefs)
    if not result.ok then m.store.prefs = SettingsStore.normalize("prefs", prefs)
    m.prefsRevision = m.prefsRevision + 1
    rebuildLineup()
end sub

' The lineup from the channels and the saved prefs (Lineup.build); the guide keeps its group and row.
sub rebuildLineup()
    built = Lineup.build(m.channels, m.store.prefs, m.teamIDs, m.upcomingGames)
    m.lineup = built
    m.top.lineup = built
    m.guide.lineup = built
    ' Step 19: an open Search searches the channels shown now.
    if m.searchOpen then pushSearchChannels()
end sub

' D51: any key or focus move in the guide or the menu, and opening the guide.
sub noteInput()
    m.lastInputAt = UpTime(0)
    m.idleTimer.control = "stop"
    m.idleTimer.duration = m.theme.timing.guideIdleReturn
    m.idleTimer.control = "start"
end sub

sub onIdle()
    limit = m.theme.timing.guideIdleReturn
    now = UpTime(0)
    if not GuideIdle.isDue(m.lastInputAt, now, limit)
        ' The timer ran a little early: wait out the rest.
        if Refresh.isNumber(m.lastInputAt)
            m.idleTimer.duration = limit - (now - m.lastInputAt)
            m.idleTimer.control = "start"
        end if
        return
    end if
    ' Step 20: a Match Guide still loading counts as an open menu (MMTVL cancels it), so it can't open after this.
    result = GuideIdle.outcome({ screen: m.screen, menuOpen: m.menuOpen or m.matchPending <> invalid, pickerOpen: m.pickerOpen, searchOpen: m.searchOpen, isPlaying: isPlaying() })
    if result.closeMenu then closeChannelMenu()
    if result.closePicker then closeTeamPicker()
    if result.closeSearch then closeSearch()
    if result.returnToChannel then returnToPlayer()
    if result.changed then Log.info("Live TV", "No input for a while: back to the video")
end sub

' --- screens and focus ------------------------------------------------------------------------------------------

' The player plays on under the guide, in the guide's preview place (and under Settings, which covers it).
sub showScreen(name as string)
    m.screen = name
    m.player.preview = name <> "player"
    m.player.visible = m.currentChannel <> invalid
    m.guide.visible = name = "guide"
    m.settings.visible = name = "settings"
    focusCurrent()
end sub

' The keyboard (the scene's dialog keeps its focus), the import confirm (step 14), the notice, then (DEBUG) the Probes screen, then the channel
' menu, then the screen.
sub focusCurrent()
    if m.keyboard <> invalid then return
    if m.importView <> invalid
        m.importView.setFocus(true)
        return
    end if
    if m.notice <> invalid
        m.notice.setFocus(true)
        return
    end if
    #if DEBUG
        if m.probes <> invalid
            m.probes.setFocus(true)
            return
        end if
    #end if
    if m.searchOpen
        m.search.callFunc("takeFocus")
    else if m.pickerOpen
        m.picker.setFocus(true)
    else if m.menuOpen
        m.menu.setFocus(true)
    else if m.screen = "player"
        m.player.setFocus(true)
    else if m.screen = "guide"
        m.guide.callFunc("takeFocus")
    else if m.screen = "settings"
        m.settings.callFunc("takeFocus")
    else
        m.top.setFocus(true)
    end if
end sub

' L7 as amended 2026-11-21: on a Low Roku, once, over whatever opens first.
sub showLowMemoryNoticeIfDue()
    if not LowMemoryNotice.shouldShow(m.caps, m.store.state, m.store.settings) then return
    m.notice = CreateObject("roSGNode", "LowMemoryNoticeView")
    m.notice.items = LowMemoryNotice.items(m.store.settings)
    m.notice.observeField("choice", "onNoticeChoice")
    m.top.appendChild(m.notice)
    Log.info("App", "Showing the low-memory notice")
    focusCurrent()
end sub

' OK or Open Settings: remembered in state, so it never shows again.
sub onNoticeChoice()
    if m.notice = invalid then return
    choice = m.notice.choice
    m.notice.unobserveField("choice")
    m.top.removeChild(m.notice)
    m.notice = invalid
    saveState(LowMemoryNotice.dismissedState(m.store.state))
    Log.info("App", "Low-memory notice answered: " + choice)
    if choice = "openSettings" then openDeviceSettings() else focusCurrent()
end sub

' The low-memory notice's Open Settings: Settings → Device (step 13).
sub openDeviceSettings()
    openSettings("device")
end sub

' Keys that reach the scene (the guide, the player, Settings, the menu and the notice handle theirs, and the
' keyboard is the system's). Every key is handled, so Back never leaves the app (D49, L4); only Roku's Home does.
function onKeyEvent(key as string, press as boolean) as boolean
    ' None should get here; DEBUG builds say which did.
    if press then Log.info("App", "Key " + key + " reached the scene")
    return true
end function

' --- step 13: Settings -----------------------------------------------------------------------------------------

' Settings on its root or on Device, over the screen it came from (Back on the root returns there).
sub openSettings(page as string)
    if m.menuOpen then closeChannelMenu()
    ' Step 18: Live TV → My Teams' league pages need the catalog.
    requestTeamCatalog()
    if m.screen <> "settings" then m.settingsReturn = m.screen
    m.settings.callFunc("open", { page: page })
    updateSettingsModel()
    showScreen("settings")
end sub

sub closeSettings()
    back = PlayerSession.returnFromSettings(m.settingsReturn, m.deferredLaunchID, m.channels, m.currentChannel <> invalid)
    m.deferredLaunchID = ""
    if back.playID <> ""
        playChannel(PlayerSession.channelByID(m.channels, back.playID))
        return
    end if
    showScreen(back.screen)
    if back.screen = "guide" then noteInput()
    ' D44: a retry that waited while Settings showed.
    if m.antennaRetry <> invalid then retryAntennaChannel(m.antennaRetry.minSerial)
end sub

' While Settings shows, after anything its pages show changed.
sub refreshSettings()
    if m.screen = "settings" then updateSettingsModel()
end sub

' What Settings shows (SettingsStatus.make): hosts, labels, counts and status lines; never a URL.
sub updateSettingsModel()
    urls = m.top.playlistGuideURLs
    if type(urls) <> "roArray" then urls = []
    updated = {}
    times = m.guideState.fetchedAt
    if type(times) = "roAssociativeArray"
        for each id in times
            updated[id] = clockText(times[id])
        end for
    end if
    m.settings.model = SettingsStatus.make({
        store: m.store,
        channels: m.channels,
        playlistGuideURLs: urls,
        playlist: { loading: m.playlistTask <> invalid, status: m.top.playlistStatus, updated: clockText(m.playlistLoadedAt) },
        guideStatuses: m.guideStatusByID,
        guideUpdated: updated,
        guideLoading: m.guideTask <> invalid,
        caps: m.caps,
        inflateEnabled: GuideSources.inflateEnabled,
        playlistChannelCount: m.playlistCount,
        antenna: antennaSettingsInput(),
        antennaPlaysMPEG2: AntennaConfig.playMPEG2,
        version: m.versionShort,
        build: m.buildNumber
    })
end sub

' "6:12 PM" for wall-clock seconds, in local time; "" for none.
function clockText(seconds as dynamic) as string
    if not Refresh.isNumber(seconds) then return ""
    date = CreateObject("roDateTime")
    date.FromSeconds(Int(seconds))
    date.ToLocalTime()
    return BannerText.clock({ hours: date.GetHours(), minutes: date.GetMinutes() })
end function

' A row's action (SettingsPages' list); then Settings is shown again with what changed.
sub onSettingsAction()
    action = m.settings.action
    if type(action) <> "roAssociativeArray" then return
    kind = action.type
    #if DEBUG
        ' L8: three Replays on Settings → About.
        if kind = "openProbes"
            openProbes()
            return
        end if
    #end if
    if kind = "close"
        closeSettings()
        return
    else if kind = "editURL"
        openKeyboard(action.field)
        return
    else if kind = "toggle"
        toggleSetting(action.setting)
    else if kind = "moveGuide"
        if PlayerSession.isText(action.id) and Refresh.isNumber(action.step) then saveGuides(SettingsEdits.moveGuide(m.store.guides, action.id, action.step))
    else if kind = "removeGuide"
        if PlayerSession.isText(action.id) then saveGuides(SettingsEdits.removeGuide(m.store.guides, action.id))
    else if kind = "toggleGroupHidden"
        if PlayerSession.isText(action.name) then savePrefs(SettingsEdits.groupToggled(m.store.prefs, action.name))
    else if kind = "unhideChannel"
        if PlayerSession.isText(action.id) then savePrefs(SettingsEdits.channelShown(m.store.prefs, action.id))
    else if kind = "toggleTeam"
        if PlayerSession.isText(action.teamID) then toggleTeam(action.teamID)
    else if kind = "findTuners"
        findTuners()
    else if kind = "refresh"
        refreshNow()
    else if kind = "removeSource"
        removeSource()
    end if
    updateSettingsModel()
end sub

sub settingsMessage(kind as string, text as string)
    m.settings.message = { kind: kind, text: text }
end sub

' Every Settings change saves at once (SettingsStore.save, all or nothing). A refused save (too large, no space,
' a failed write) changes nothing and says so in Settings' band.
function saveSetting(key as string, value as dynamic) as boolean
    result = SettingsStore.save(m.store, key, value)
    if not result.ok then settingsMessage("band", result.message)
    return result.ok
end function

' Channel Up goes to the player at once; Channel Logos to the guide (it draws its rows again) and the banner; the
' guide source starts a guide run.
sub toggleSetting(name as dynamic)
    if not PlayerSession.isText(name) then return
    if not saveSetting("settings", SettingsEdits.settingToggled(m.store.settings, name)) then return
    Log.info("Settings", "Changed " + name)
    if name = "channelUpMovesUpList" then m.player.channelUpMovesUpList = m.store.settings.channelUpMovesUpList
    if name = "channelLogos"
        m.guide.settings = SettingsStore.guideSettings(m.store.settings)
        if m.currentChannel <> invalid then m.player.logo = playerLogo(m.currentChannel)
    end if
    if name = "usePlaylistGuide" then guidesChanged()
    ' Step 18 (MMTVL's applyTeamMatchOptions): TeamsTask builds the index for the new options, then matches.
    if name = "teamMatchInitials" or name = "teamMatchNicknames" then requestTeams()
    ' Step 21 (MMTVL's applyAntenna, applyAntennaGuide).
    if name = "antennaEnabled" or name = "antennaGuide" then antennaSettingsChanged()
end sub

sub saveGuides(guides as object)
    if saveSetting("guides", guides) then guidesChanged()
end sub

' Step 9's note: m.store now holds the new guides (or guide source), so the next run reads the same set the task
' does (it loads the registry). A run starts now, or as soon as the one going answers.
sub guidesChanged()
    m.guideRuns = GuideRuns.sourcesChanged(m.guideRuns)
    refreshGuideIfDue()
end sub

' Groups and hidden channels: the lineup is built again (the guide keeps its group and row).
sub savePrefs(prefs as object)
    if not saveSetting("prefs", prefs) then return
    m.prefsRevision = m.prefsRevision + 1
    rebuildLineup()
end sub

' "Change Playlist URL…" and "Add Guide…": Roku's keyboard as the scene's dialog. It starts empty: the saved URL is
' never shown (M6b L2), and Roku's mobile app can type or paste into it (unverified).
sub openKeyboard(field as dynamic)
    if m.keyboard <> invalid then return
    if field <> "playlist" and field <> "guide" and field <> "antennaAddress" then return
    dialog = CreateObject("roSGNode", "StandardKeyboardDialog")
    if field = "antennaAddress"
        ' Step 21: it starts empty too; the saved address is never shown.
        dialog.title = "Tuner Address"
        dialog.message = ["Type the HDHomeRun's IP address on your network, like 192.168.1.20. Choose OK with nothing typed to forget it."]
    else if field = "playlist"
        dialog.title = "Playlist URL"
        dialog.message = ["Type the M3U address of your playlist, starting with http:// or https://."]
    else
        dialog.title = "Add Guide"
        dialog.message = ["Type the address of an XMLTV guide, starting with http:// or https://."]
    end if
    dialog.buttons = ["OK", "Cancel"]
    dialog.observeField("buttonSelected", "onKeyboardButton")
    dialog.observeField("wasClosed", "onKeyboardClosed")
    m.keyboard = dialog
    m.keyboardField = field
    m.top.dialog = dialog
end sub

' OK takes the text (and clears it from the dialog); either button closes the keyboard.
sub onKeyboardButton()
    dialog = m.keyboard
    if dialog = invalid then return
    chosen = dialog.buttonSelected
    typed = ""
    if chosen = 0 then typed = dialog.text
    dialog.text = ""
    field = m.keyboardField
    dialog.close = true
    if chosen = 0
        if field = "antennaAddress" then applyTypedTunerAddress(typed) else applyTypedURL(field, typed)
    end if
end sub

sub onKeyboardClosed()
    dialog = m.keyboard
    if dialog = invalid then return
    dialog.unobserveField("buttonSelected")
    dialog.unobserveField("wasClosed")
    dialog.text = ""
    m.keyboard = invalid
    m.keyboardField = ""
    focusCurrent()
end sub

' A typed address: checked as PlaylistTask and GuideTask check typed URLs (SettingsEdits.checkURL: URLPolicy.allows
' with no referrer); a refused one says why on its row. Logs show the host only (L6).
sub applyTypedURL(field as string, typed as string)
    checked = SettingsEdits.checkURL(typed)
    typed = ""
    if not checked.ok
        settingsMessage(field, checked.message)
        return
    end if
    host = Log.host(checked.url)
    if field = "playlist"
        if not saveSetting("source", checked.url) then return
        settingsMessage("playlist", "")
        Log.info("Settings", "Playlist set to " + host)
        changePlaylist()
    else
        added = SettingsEdits.addGuide(m.store.guides, checked.url)
        if not added.ok
            settingsMessage("guide", added.message)
            return
        end if
        if not saveSetting("guides", added.guides) then return
        settingsMessage("guide", "")
        Log.info("Settings", "Guide added from " + host)
        guidesChanged()
    end if
    checked.url = ""
    updateSettingsModel()
end sub

' A new playlist (MMTVL's setPlaylistURL): the old channels go, and the new list loads now; its guides follow
' (a changed channel set reruns the match at once, not after the hourly wait).
sub changePlaylist()
    stopPlaylistTask()
    m.guideState.channelRunAt = invalid
    m.top.playlistGuideURLs = []
    m.playlistLoadedAt = invalid
    m.lastPlaylistLoad = invalid
    forgetTeamResults()
    ' Step 21: the antenna's channels stay (antenna-sized work only).
    applyAntennaOnly()
    updatePlayback()
    ' QA 2: a guide run going now is for the old playlist; another follows it (after the new channels arrive).
    m.guideRuns = GuideRuns.sourcesChanged(m.guideRuns)
    m.playlistAnswered = false
    loadPlaylist()
end sub

sub stopPlaylistTask()
    m.playlistLoadPending = false
    task = m.playlistTask
    if task = invalid then return
    ' Step 21: nothing waits for a stopped task; a stopped merge is made again by the next task that ends (round 2:
    ' mergePending clears, so the launch never waits for a merge that won't come).
    stopped = Lineup.afterStop(m.playlistTaskIsMerge, m.playlistAntennaRevision)
    m.mergePending = stopped.mergePending
    m.playlistAntennaRevision = stopped.taskRevision
    m.playlistTaskIsMerge = false
    task.unobserveField("result")
    task.control = "stop"
    m.playlistTask = invalid
    m.playlistWatchdog.control = "stop"
end sub

' MMTVL's Refresh Now: the playlist and every guide downloaded again now (the guides after the playlist, which then
' calls refreshGuideIfDue; a load already going does the same).
sub refreshNow()
    Log.info("Settings", "Refresh Now")
    m.guideRuns = GuideRuns.refreshNow(m.guideRuns)
    ' Step 21: the tuners' lineups now, and SiliconDust's guide unless it was downloaded or tried in the last hour.
    loadAntenna(true)
    if m.store.source = ""
        refreshGuideIfDue()
        return
    end if
    if m.playlistTask = invalid
        m.lastPlaylistLoad = invalid
        loadPlaylist()
    end if
end sub

' MMTVL's Remove Live TV Source: the addresses are forgotten, the channels and the downloaded guides go, and the
' playing channel stops. The other settings (favorites, hidden channels, state) are kept, as MMTVL's.
sub removeSource()
    ' QA 5: both addresses in one save, all or nothing.
    result = SettingsStore.saveMany(m.store, { guides: [], source: "" })
    if not result.ok
        settingsMessage("band", result.message)
        return
    end if
    Log.info("Settings", "Live TV source removed")
    stopPlaylistTask()
    if m.currentChannel <> invalid
        m.player.control = "stop"
        m.currentChannel = invalid
        m.player.visible = false
    end if
    m.top.playlistGuideURLs = []
    m.playlistLoadedAt = invalid
    m.lastPlaylistLoad = invalid
    m.logoTask.playlistURL = ""
    m.top.playlistStatus = "No Live TV source yet"
    showPlaylistStatus(m.top.playlistStatus)
    forgetTeamResults()
    ' Step 21: the antenna's channels stay (MMTVL's Remove Live TV Source forgets the playlist only).
    applyAntennaOnly()
    updatePlayback()
    forgetGuides()
end sub

' The downloaded guides and their results go (GuideRuns.removeSource): now, or once no guide task is alive to read
' or write them, before any newer run (refreshGuideIfDue's gate).
sub forgetGuides()
    m.guideRuns = GuideRuns.removeSource(m.guideRuns)
    refreshGuideIfDue()
end sub

' Only from refreshGuideIfDue's gate (no task alive). The pending and forced runs stay asked for (QA 2).
sub deleteGuideFiles()
    Log.info("Guide", "Deleting the downloaded guides")
    directory = GuideSources.cacheDirectory
    if m.fs.Exists(directory)
        for each name in m.fs.GetDirectoryListing(directory)
            m.fs.Delete(directory + "/" + name)
        end for
    end if
    m.guideStatusByID = {}
    m.antennaGuideRow = invalid
    m.guideAntennaIndex = invalid
    ' As after a launch: no run has answered. The current channel set (from the last playlist load) stays.
    m.guideState = { lastKey: invalid, fetchedAt: invalid, failures: invalid, channelsKey: m.guideState.channelsKey, lastChannelsKey: invalid, channelRunAt: invalid, failedRunAt: invalid }
    m.top.guideHolder = invalid
    m.top.guideStatuses = []
    m.top.guideNote = ""
    m.top.guideRevision = m.top.guideRevision + 1
    m.guide.guideHolder = invalid
    m.guide.guideRevision = m.top.guideRevision
    m.teamsTask.guideHolder = invalid
    if m.searchTask <> invalid
        m.searchTask.guideHolder = invalid
        m.searchTask.guideRevision = m.top.guideRevision
    end if
    requestTeams()
end sub

' --- step 14: Import from MMTVL ------------------------------------------------------------------------------

' main's request (a cold launch's or roInput's contentId, already parsed): the confirm screen opens over everything
' while ImportTask fetches. The field is cleared at once. One import at a time: another request while one is open is
' ignored (the script's offer can't be used twice anyway).
sub onImportRequest()
    request = m.top.importRequest
    if type(request) <> "roAssociativeArray" then return
    if request.Count() = 0 then return
    m.top.importRequest = {}
    if m.importView <> invalid
        Log.info("Import", "An import is already open; ignoring another")
        return
    end if
    checked = ImportBundle.checkRequest(request)
    if not checked.ok
        Log.warn("Import", "Refused an import request (" + checked.reason + ")")
        return
    end if
    Log.info("Import", "Getting the settings from " + checked.host)
    ' The keyboard is the scene's dialog, drawn over everything: it closes first (onKeyboardClosed clears it).
    if m.keyboard <> invalid then m.keyboard.close = true
    m.importView = CreateObject("roSGNode", "ImportConfirmView")
    m.importView.state = { kind: "loading" }
    m.importView.observeField("choice", "onImportChoice")
    m.top.appendChild(m.importView)
    task = CreateObject("roSGNode", "ImportTask")
    task.request = { host: checked.host, port: checked.port, secret: checked.secret }
    task.observeField("result", "onImportResult")
    m.importTask = task
    task.control = "run"
    m.importWatchdog.control = "start"
    focusCurrent()
end sub

sub onImportResult()
    task = m.importTask
    if task = invalid then return
    task.unobserveField("result")
    m.importTask = invalid
    m.importWatchdog.control = "stop"
    result = task.result
    task.result = {}
    if m.importView = invalid then return
    if type(result) <> "roAssociativeArray" then result = { ok: false, reason: "crash" }
    if result.ok = true and type(result.bundle) = "roAssociativeArray"
        ' Checked again here: the scene writes only what ImportBundle.validate passes.
        checked = ImportBundle.validate(result.bundle)
        if checked.ok
            m.importBundle = checked.bundle
            m.importView.state = { kind: "confirm", rows: ImportBundle.summaryRows(m.importBundle, importLastChannelLabel(m.importBundle.lastChannelID)) }
            return
        end if
        importFailed(checked.reason)
        return
    end if
    reason = "crash"
    if PlayerSession.isText(result.reason) then reason = result.reason
    importFailed(reason)
end sub

sub importFailed(reason as string)
    Log.warn("Import", "Import not used (" + reason + ")")
    m.importBundle = invalid
    if m.importView <> invalid then m.importView.state = { kind: "failed", message: ImportBundle.message(reason) }
end sub

sub onImportWatchdog()
    task = m.importTask
    if task = invalid then return
    task.unobserveField("result")
    task.control = "stop"
    m.importTask = invalid
    Log.error("Import", "No answer from the import task")
    importFailed("timeout")
end sub

' The confirm screen's "Last channel": the channel's number and name when the current playlist has it (an import
' usually brings the same playlist), else its id without the kind.
function importLastChannelLabel(id as string) as string
    channel = PlayerSession.channelByID(m.channels, id)
    number = ""
    if channel <> invalid then number = Lineup.displayNumber(channel)
    return ImportBundle.channelLabel(id, channel, number)
end function

' Replace Settings, Cancel (also Back), or OK on a failure.
sub onImportChoice()
    view = m.importView
    if view = invalid then return
    choice = view.choice
    if choice = "replace" and m.importBundle <> invalid
        result = SettingsStore.replaceAll(m.store, m.importBundle)
        m.importBundle = invalid
        if not result.ok
            Log.warn("Import", "Import not saved")
            view.state = { kind: "failed", message: result.message }
            return
        end if
        closeImport()
        applyImportedSettings()
        return
    end if
    if choice = "cancel" then Log.info("Import", "Import cancelled; nothing changed")
    closeImport()
    ' A launch that waited for the import (resolveLaunch) opens now, if the playlist has answered.
    if m.playlistTask = invalid then resolveLaunch()
end sub

sub closeImport()
    task = m.importTask
    if task <> invalid
        task.unobserveField("result")
        task.control = "stop"
        m.importTask = invalid
        m.importWatchdog.control = "stop"
    end if
    m.importBundle = invalid
    if m.importView <> invalid
        m.importView.unobserveField("choice")
        m.top.removeChild(m.importView)
        m.importView = invalid
    end if
    focusCurrent()
end sub

' After Replace Settings (m.store already holds the import): the playing channel stops, every screen gets the new
' settings, and the new playlist loads (changePlaylist), its guides after it; when it answers, what a launch opens
' opens (resolveLaunch: the imported last channel, else the guide; it waits while Settings shows).
sub applyImportedSettings()
    Log.info("Import", "Settings replaced; loading the new playlist")
    if m.menuOpen then closeChannelMenu()
    if m.pickerOpen then closeTeamPicker()
    if m.currentChannel <> invalid
        m.player.control = "stop"
        m.currentChannel = invalid
        m.player.visible = false
    end if
    m.player.channelUpMovesUpList = m.store.settings.channelUpMovesUpList
    m.guide.settings = SettingsStore.guideSettings(m.store.settings)
    m.logoTask.playlistURL = m.store.source
    m.prefsRevision = m.prefsRevision + 1
    m.deferredLaunchID = ""
    m.launchPending = true
    if m.screen = "player" then showScreen("guide")
    ' Without a playlist there are no channels for the old guides: they go, as Remove Live TV Source's.
    if m.store.source = "" then forgetGuides()
    antennaSettingsChanged()
    changePlaylist()
    if m.screen = "guide" then openGuide(false)
    refreshSettings()
end sub

' --- step 18: My Teams --------------------------------------------------------------------------------------------

' TeamsTask for the app's life, the 5-minute tick (IPTVLibrary.teamsRefreshInterval) and Choose Teams. m.teamIDs and
' m.upcomingGames are the newest match's (the lineup's), m.teamsKey what they were last set from, m.teamsRevision
' goes up with each change (a PlaylistTask that ran on older ones rebuilds the lineup).
sub startTeams()
    m.teamIDs = []
    m.upcomingGames = []
    m.teamsKey = teamsKeyOf([], [])
    m.teamsRevision = 0
    m.playlistTeamsRevision = 0
    m.teamRequests = MyTeams.newRequests()
    m.teamCatalog = invalid
    m.catalogAsked = false
    m.teamsTask = CreateObject("roSGNode", "TeamsTask")
    m.teamsTask.observeField("matchAnswer", "onMatchAnswer")
    m.teamsTask.observeField("menuAnswer", "onMenuAnswer")
    m.teamsTask.observeField("searchAnswer", "onTeamSearchAnswer")
    m.teamsTask.observeField("catalog", "onTeamCatalog")
    ' Teams picked: the task makes the catalogs and the index at launch; none picked: when first needed.
    prepare = {}
    if m.store.prefs.teams.Count() > 0 then prepare = teamOptions()
    m.teamsTask.prepareIndex = prepare
    m.teamsTask.control = "run"
    m.teamsTimer = CreateObject("roSGNode", "Timer")
    m.teamsTimer.duration = Refresh.teamsIntervalSeconds
    m.teamsTimer.repeat = true
    m.teamsTimer.observeField("fire", "requestTeams")
    m.teamsTimer.control = "start"
    m.picker = m.top.findNode("teamPicker")
    m.picker.observeField("toggle", "onPickerToggle")
    m.picker.observeField("closed", "closeTeamPicker")
    m.picker.observeField("input", "noteInput")
    m.pickerOpen = false
end sub

function teamOptions() as object
    return { initials: PlayerSession.isTrue(m.store.settings.teamMatchInitials), nicknames: PlayerSession.isTrue(m.store.settings.teamMatchNicknames) }
end function

' A match for the current picks and options; it supersedes any older one (TeamsTask: the newest wins).
sub requestTeams()
    serial = MyTeams.nextSerial(m.teamRequests, "match")
    m.teamsTask.request = { kind: "match", serial: serial, picked: m.store.prefs.teams, options: teamOptions() }
end sub

' The channel menu's teams for one channel: its game entry's, else those of the programme on now (only what
' TeamMatcher reads of it).
sub requestMenuTeams(channel as object, current as dynamic)
    programme = invalid
    if type(current) = "roAssociativeArray"
        programme = {}
        for each field in ["start", "stop", "title", "subtitle", "category", "summary"]
            if current[field] <> invalid then programme[field] = current[field]
        end for
    end if
    serial = MyTeams.nextSerial(m.teamRequests, "menu")
    m.menuContext.teamSerial = serial
    m.teamsTask.request = { kind: "menu", serial: serial, channel: { id: channel.id, name: channel.name, group: channel.group }, programme: programme, options: teamOptions() }
end sub

' Each kind has its own field (fix 2 of step 18's QA), so two answers set close together are both seen.
sub onMatchAnswer()
    answer = m.teamsTask.matchAnswer
    if not MyTeams.isNewest(m.teamRequests, answer) then return
    if not PlayerSession.isTrue(answer.ok) or answer.kind <> "match" then return
    key = teamsKeyOf(answer.liveIDs, answer.upcoming)
    if key = m.teamsKey then return
    m.teamsKey = key
    m.teamIDs = answer.liveIDs
    m.upcomingGames = answer.upcoming
    m.teamsRevision = m.teamsRevision + 1
    rebuildLineup()
end sub

sub onMenuAnswer()
    answer = m.teamsTask.menuAnswer
    if not MyTeams.isNewest(m.teamRequests, answer) then return
    if not PlayerSession.isTrue(answer.ok) or answer.kind <> "menu" then return
    if not m.menuOpen or m.menuContext = invalid then return
    if m.menuContext.channelID <> answer.channelID or m.menuContext.teamSerial <> answer.serial then return
    m.menuContext.teamSides = answer.sides
    showMenuRows()
end sub

' The open menu's rows again (the team rows came), on the row focused now, by id: the view holds the live focus.
sub showMenuRows()
    m.menu.callFunc("replaceItems", { items: ChannelMenu.items(menuItemsContext()) })
end sub

' No channels (a new playlist, Remove Live TV Source): My Teams is empty until the next match. The match serial moves
' on, so a match still running for the old playlist is never used.
sub forgetTeamResults()
    MyTeams.nextSerial(m.teamRequests, "match")
    m.teamsTask.channels = []
    m.teamIDs = []
    m.upcomingGames = []
    m.teamsKey = teamsKeyOf([], [])
    m.teamsRevision = m.teamsRevision + 1
end sub

' What a match set, to tell whether a new answer changes anything (MMTVL sets the group only on a change).
function teamsKeyOf(ids as object, upcoming as object) as string
    return FormatJson({ ids: ids, upcoming: upcoming })
end function

' A team added or removed (Choose Teams, Settings): saved in prefs in the order added, the lineup built again, and a
' match for the new picks.
sub toggleTeam(teamID as string)
    prefs = ChannelMenu.prefsAfter(m.store.prefs, { type: "toggleTeam", teamID: teamID }, [])
    if m.screen = "settings"
        if not saveSetting("prefs", prefs) then return
    else
        result = SettingsStore.save(m.store, "prefs", prefs)
        if not result.ok then m.store.prefs = SettingsStore.normalize("prefs", prefs)
    end if
    m.prefsRevision = m.prefsRevision + 1
    rebuildLineup()
    requestTeams()
    if m.pickerOpen then m.picker.picked = m.store.prefs.teams
    if m.searchOpen then m.search.picked = m.store.prefs.teams
end sub

' The slim catalog, asked for once (Settings or Choose Teams opening); after a failure, again at the next open
' (Settings and Choose Teams show "Loading teams…" meanwhile).
sub requestTeamCatalog()
    if m.teamCatalog <> invalid or m.catalogAsked then return
    m.catalogAsked = true
    m.settings.teamCatalog = {}
    m.picker.catalog = {}
    m.teamsTask.request = { kind: "catalog" }
end sub

' Read once (a field read copies it); Settings and Choose Teams each get it once. A failed one ({ ok: false }) shows
' "Teams couldn't be loaded" there, and the next open asks again.
sub onTeamCatalog()
    if m.teamCatalog <> invalid then return
    catalog = m.teamsTask.catalog
    if type(catalog) <> "roAssociativeArray" then return
    if not PlayerSession.isTrue(catalog.ok) or type(catalog.leagues) <> "roArray"
        m.catalogAsked = false
        m.settings.teamCatalog = { failed: true }
        m.picker.catalog = { failed: true }
        return
    end if
    m.teamCatalog = catalog
    m.settings.teamCatalog = catalog
    m.picker.catalog = catalog
end sub

' MMTVL's openTeamPicker: only from the guide; focus stays on My Teams' Choose Teams row under it.
sub openTeamPicker()
    if m.screen <> "guide" then return
    requestTeamCatalog()
    m.picker.callFunc("open")
    m.picker.picked = m.store.prefs.teams
    m.picker.visible = true
    m.pickerOpen = true
    focusCurrent()
    noteInput()
end sub

sub closeTeamPicker()
    if not m.pickerOpen then return
    m.picker.visible = false
    m.pickerOpen = false
    focusCurrent()
end sub

sub onPickerToggle()
    toggle = m.picker.toggle
    if type(toggle) <> "roAssociativeArray" then return
    if PlayerSession.isText(toggle.teamID) then toggleTeam(toggle.teamID)
end sub

' --- step 19: Search ------------------------------------------------------------------------------------------

' Search over the guide (SearchView), opened from the guide's Search row. SearchTask (channels, programmes) is made when
' Search first opens and kept for the app's life; TeamsTask answers the teams. m.searchSerial is the newest serial
' used (a session's first, then each query sent; it never goes back), and answers for any other are dropped (the view
' checks too).
sub startSearch()
    m.search = m.top.findNode("search")
    m.search.observeField("query", "onSearchQuery")
    m.search.observeField("choice", "onSearchChoice")
    m.search.observeField("closed", "closeSearch")
    m.search.observeField("input", "noteInput")
    m.searchOpen = false
    m.searchTask = invalid
    m.searchSerial = 0
end sub

' MMTVL's openSearch, from the guide only (the Search row); the guide stays under it, on its Search row.
sub openSearch()
    if m.screen <> "guide" or m.searchOpen then return
    if m.searchTask = invalid
        m.searchTask = CreateObject("roSGNode", "SearchTask")
        m.searchTask.guideHolder = m.top.guideHolder
        m.searchTask.guideRevision = m.top.guideRevision
        m.searchTask.observeField("answer", "onSearchAnswer")
        m.searchTask.control = "run"
    end if
    pushSearchChannels()
    ' The channel names and the title index (SearchTask), and the team entries (TeamsTask), while the user types.
    m.searchTask.request = { kind: "prepare" }
    m.teamsTask.request = { kind: "search", serial: -1, text: "" }
    ' Serials keep increasing across sessions: an answer from an earlier Search is never taken for this one's.
    m.searchSerial = m.searchSerial + 1
    m.search.callFunc("open", { serial: m.searchSerial })
    m.search.picked = m.store.prefs.teams
    m.search.visible = true
    m.searchOpen = true
    focusCurrent()
    noteInput()
end sub

' The lineup's visible channels, as Search shows them (no URL).
sub pushSearchChannels()
    shown = []
    if m.lineup <> invalid
        for each channel in m.lineup.visibleChannels
            shown.Push({ id: channel.id, name: channel.name, number: Lineup.displayNumber(channel), group: channel.group })
        end for
    end if
    m.searchTask.channels = shown
end sub

sub closeSearch()
    if not m.searchOpen then return
    m.search.visible = false
    m.searchOpen = false
    focusCurrent()
end sub

' Typing paused: both Tasks get the newest text.
sub onSearchQuery()
    query = m.search.query
    if type(query) <> "roAssociativeArray" or not m.searchOpen then return
    m.searchSerial = query.serial
    m.searchTask.request = { kind: "query", serial: query.serial, text: query.text }
    m.teamsTask.request = { kind: "search", serial: query.serial, text: query.text }
end sub

' SearchTask's channels and programmes; the programmes' titles come from the guide screen (one call per answer).
sub onSearchAnswer()
    answer = m.searchTask.answer
    if type(answer) <> "roAssociativeArray" or not m.searchOpen then return
    if answer.serial <> m.searchSerial then return
    ' A failed part still answers (no results), so the screen stops saying "Searching…".
    if not PlayerSession.isTrue(answer.ok)
        m.search.answer = { serial: answer.serial, part: "guide", ok: false, channels: [], programmes: [] }
        return
    end if
    hits = answer.programmes
    if type(hits) <> "roArray" then hits = []
    details = m.guide.callFunc("programmeDetails", hits)
    programmes = []
    if type(details) = "roArray"
        for i = 0 to hits.Count() - 1
            if i < details.Count()
                if type(details[i]) = "roAssociativeArray"
                    hit = hits[i]
                    hit.title = details[i].title
                    hit.subtitle = details[i].subtitle
                    programmes.Push(hit)
                end if
            end if
        end for
    end if
    m.search.answer = { serial: answer.serial, part: "guide", ok: true, channels: answer.channels, programmes: programmes }
end sub

sub onTeamSearchAnswer()
    answer = m.teamsTask.searchAnswer
    if type(answer) <> "roAssociativeArray" or not m.searchOpen then return
    if answer.serial <> m.searchSerial then return
    if not PlayerSession.isTrue(answer.ok)
        m.search.answer = { serial: answer.serial, part: "teams", ok: false, teams: [] }
        return
    end if
    m.search.answer = { serial: answer.serial, part: "teams", ok: true, teams: answer.teams }
end sub

' MMTVL's choose: a channel or a programme on now plays; a later programme shows in the guide at its start. A team is
' added or removed and Search stays open.
sub onSearchChoice()
    choice = m.search.choice
    if type(choice) <> "roAssociativeArray" or not m.searchOpen then return
    kind = choice.type
    if kind = "toggleTeam"
        if PlayerSession.isText(choice.teamID) then toggleTeam(choice.teamID)
    else if kind = "watch"
        closeSearch()
        watch(choice.channelID)
    else if kind = "showInGuide"
        closeSearch()
        m.guide.callFunc("focusChannel", { channelID: choice.channelID, start: choice.start })
        focusCurrent()
    end if
end sub

#if DEBUG
    ' The probes play their own video: the player stops first.
    sub openProbes()
        if m.menuOpen then closeChannelMenu()
        if m.pickerOpen then closeTeamPicker()
        if m.searchOpen then closeSearch()
        m.player.control = "stop"
        m.currentChannel = invalid
        m.player.visible = false
        updatePlayback()
        m.probes = CreateObject("roSGNode", "ProbesScreen")
        m.probes.observeField("closed", "onProbesClosed")
        m.top.appendChild(m.probes)
        focusCurrent()
    end sub

    sub onProbesClosed()
        if m.probes = invalid then return
        m.probes.unobserveField("closed")
        m.top.removeChild(m.probes)
        m.probes = invalid
        focusCurrent()
    end sub
#end if

' --- step 20: Match Guide --------------------------------------------------------------------------------------

sub startMatchGuide()
    m.matchTask = invalid
    m.matchSerial = 0
    ' { serial, channelID, screen } while Match Guide's options load; the channel menu it came from, while the
    ' options load and Match Guide is open ({ channelID, group, teamSides }).
    m.matchPending = invalid
    m.matchParent = invalid
    m.unicodeFinder = Unicode.newNonASCIIFinder()
end sub

' Whether the open menu is Match Guide's (the channel menu's context has no kind).
function isMatchGuideMenu() as boolean
    if m.menuContext = invalid then return false
    kind = m.menuContext.kind
    if not PlayerSession.isText(kind) then return false
    return kind = "matchGuide"
end function

' Each guide's short label, by the index the last guide run gave it (MatchGuide.labels; no URL leaves here).
function guideLabels() as object
    urls = m.top.playlistGuideURLs
    if type(urls) <> "roArray" then urls = []
    sources = GuideSources.chooseSources(m.store.guides, urls, m.store.settings.usePlaylistGuide, m.store.source)
    ' Step 21: the antenna guide's "HDHomeRun" at the index the last run gave it.
    return MatchGuide.withAntennaLabel(MatchGuide.labels(m.guideState.lastKey, sources), m.guideAntennaIndex)
end function

' MMTVL's openMatchGuide: the channel menu closes and Match Guide opens once its options load (nothing shows
' meanwhile); the channel menu is kept to go back to.
sub openMatchGuide(id as dynamic)
    channel = PlayerSession.channelByID(m.channels, id)
    context = m.menuContext
    if channel = invalid or context = invalid
        closeChannelMenu()
        return
    end if
    parent = { channelID: channel.id, group: context.group, teamSides: context.teamSides }
    closeChannelMenu()
    m.matchParent = parent
    if m.matchTask = invalid
        m.matchTask = CreateObject("roSGNode", "MatchGuideTask")
        m.matchTask.guideHolder = m.top.guideHolder
        m.matchTask.observeField("answer", "onMatchGuideAnswer")
        m.matchTask.control = "run"
    end if
    m.matchSerial = m.matchSerial + 1
    m.matchPending = { serial: m.matchSerial, channelID: channel.id, screen: m.screen }
    m.matchTask.request = { serial: m.matchSerial, channel: { id: channel.id, name: channel.name, tvgID: channel.tvgID, tvgName: channel.tvgName }, overrides: m.store.overrides }
end sub

' The options came: Match Guide opens, unless something else opened or the screen changed meanwhile (MMTVL's
' guard: not over Choose Teams, Search or another menu, and in the same mode).
sub onMatchGuideAnswer()
    answer = m.matchTask.answer
    pending = m.matchPending
    if type(answer) <> "roAssociativeArray" or pending = invalid then return
    if answer.serial <> pending.serial then return
    m.matchPending = invalid
    parent = m.matchParent
    blocked = m.menuOpen or m.pickerOpen or m.searchOpen or m.keyboard <> invalid or m.importView <> invalid or m.notice <> invalid
    if blocked or m.screen <> pending.screen or (m.screen <> "guide" and m.screen <> "player") or parent = invalid
        m.matchParent = invalid
        return
    end if
    channel = PlayerSession.channelByID(m.channels, pending.channelID)
    if channel = invalid
        m.matchParent = invalid
        return
    end if
    name = ""
    if PlayerSession.isText(channel.name) then name = channel.name
    built = MatchGuide.menu(name, channel.id, answer.options, guideLabels())
    shown = ChannelMenu.make(built.title, "", built.items, built.focusedIndex, m.theme.layout.liveMenuVisibleRows)
    shown.wide = true
    shown.note = ""
    m.menuContext = { channelID: channel.id, group: parent.group, kind: "matchGuide", teamSides: invalid, teamSerial: -1 }
    m.menu.menu = shown
    m.menu.visible = true
    m.menuOpen = true
    focusCurrent()
    noteInput()
end sub

' M7m L3: Back from Match Guide goes back to the channel menu, focused on its Match Guide row.
sub backToChannelMenu()
    parent = m.matchParent
    m.matchParent = invalid
    if parent = invalid
        closeChannelMenu()
        return
    end if
    m.menuContext = { channelID: parent.channelID, group: parent.group, teamSides: parent.teamSides, teamSerial: -1 }
    focus = ChannelMenu.focusAfterMove(ChannelMenu.items(menuItemsContext()), "matchGuide", 0)
    openChannelMenu(parent.channelID, parent.group, focus)
end sub

' MMTVL's setGuideMatch: the overrides saved (the channel's keys out, then its choice under its overrideKey), then
' matched again from the guide files there are, downloading nothing (GuideRuns' rematch). A refused save (L5: under
' 4 KB left, or too large; or more matches than the store keeps) keeps Match Guide open with the message.
sub applyGuideMatch(chosen as dynamic)
    if type(chosen) <> "roAssociativeArray" then return
    channel = PlayerSession.channelByID(m.channels, chosen.channelID)
    if channel = invalid or type(chosen.choice) <> "roAssociativeArray"
        closeChannelMenu()
        return
    end if
    overrides = MatchGuide.overridesAfter(m.store.overrides, channel, chosen.choice, m.unicodeFinder)
    if MatchGuide.tooMany(overrides)
        Log.warn("Guide", "Match Guide not saved: more guide matches than the store keeps")
        m.menu.callFunc("showNote", { text: MatchGuide.tooManyMessage })
        return
    end if
    saved = SettingsStore.save(m.store, "overrides", overrides)
    if not saved.ok
        m.menu.callFunc("showNote", { text: saved.message })
        return
    end if
    if not MatchGuide.isApplied(m.store.overrides, channel, chosen.choice, m.unicodeFinder)
        Log.warn("Guide", "Match Guide's choice wasn't kept by the store")
        m.menu.callFunc("showNote", { text: SettingsStore.saveFailedMessage })
        return
    end if
    Log.info("Guide", "Match Guide: " + chosen.choice.kind + " saved; matching again from the guides there are")
    closeChannelMenu()
    m.guideRuns = GuideRuns.overridesChanged(m.guideRuns)
    refreshGuideIfDue()
end sub

' --- step 21: the antenna ----------------------------------------------------------------------------------------

' AntennaTask per request (like PlaylistTask): discovery and the lineups on the playlist's cadence (at launch, the
' 15-minute tick when 10 minutes old, the guide opening, Refresh Now, Find Tuners, a setting change), answered first
' (lineupResult, D36), then SiliconDust's guide in the same run when due (result); and the diagnosis of a failed
' antenna stream. m.antenna holds the last answer's antenna part and Settings' counts: no DeviceID, DeviceAuth or
' address (the task keeps those); the channels' stream URLs are on the tuner, like the playlist's in the lineup.
sub startAntenna()
    m.antenna = newAntennaState()
    m.antennaTask = invalid
    m.antennaSerial = 0
    ' Round 2: the running refresh's serial; answers from any other run are ignored.
    m.antennaTaskSerial = -1
    ' D37: goes up with each new antenna part; PlaylistTask merges the newest.
    m.antennaRevision = 0
    m.playlistAntennaRevision = 0
    ' The launch waits for the first lineup answer only while the antenna is on.
    m.antennaAnswered = not m.store.settings.antennaEnabled
    ' D38: the running task may write the guide file; one the watchdog gave up on, while alive, and whether it may.
    m.antennaGuideDownloading = false
    m.abandonedAntennaTask = invalid
    m.abandonedAntennaWantedGuide = false
    ' D38: a run asked for while one runs (manual: Refresh Now), a guide download that had to wait for a guide run,
    ' and Find Tuners for the next run.
    m.antennaPending = { run: false, manual: false }
    m.antennaGuidePending = { wanted: false, manual: false }
    m.antennaFindWanted = false
    m.antennaRunIsFind = false
    m.antennaGuideOutcome = invalid
    m.antennaGuideRow = invalid
    m.guideAntennaIndex = invalid
    ' MMTVL's mayRetry: a failed antenna channel is tried once more after a search or a lineup read.
    ' D43: { id, minSerial } of the retry a diagnosis asked for, or invalid.
    m.antennaRetry = invalid
    m.antennaRetriedID = ""
    m.antennaDiagnosis = invalid
    m.antennaWatchdog = CreateObject("roSGNode", "Timer")
    m.antennaWatchdog.repeat = false
    m.antennaWatchdog.observeField("fire", "onAntennaWatchdog")
end sub

function newAntennaState() as object
    return { channels: [], devices: [], matchFields: [], teamFields: [], matchKey: "", payloadKey: "", leftOut: 0, mpeg2Hidden: 0, typedProblem: "", lineupFailed: 0, lastLoad: invalid, misses: 0, findLine: "" }
end function

sub refreshAntennaIfStale()
    if not m.store.settings.antennaEnabled then return
    if m.antenna.lastLoad = invalid or Refresh.isDue(m.antenna.lastLoad, UpTime(0), Refresh.playlistMaxAgeSeconds) then loadAntenna(false)
end sub

' One AntennaTask refresh at a time: one asked for meanwhile runs after it (D38). SiliconDust's guide is asked for
' when Guide from SiliconDust is on and nothing can be reading or writing its file (GuideRuns.antennaMayDownload);
' otherwise the download waits for that (antennaGuideMayGo). The task decides whether it's due.
sub loadAntenna(manual as boolean)
    settings = m.store.settings
    if not settings.antennaEnabled then return
    if m.antennaTask <> invalid
        m.antennaPending.run = true
        if manual then m.antennaPending.manual = true
        return
    end if
    wantsGuide = false
    if settings.antennaGuide
        if GuideRuns.antennaMayDownload(m.guideTask <> invalid, m.abandonedGuideTask <> invalid, abandonedAntennaState())
            wantsGuide = true
            m.antennaGuidePending = { wanted: false, manual: false }
        else
            m.antennaGuidePending.wanted = true
            if manual then m.antennaGuidePending.manual = true
        end if
    end if
    m.antennaGuideDownloading = wantsGuide
    m.antennaRunIsFind = m.antennaFindWanted
    m.antennaFindWanted = false
    m.antennaSerial = m.antennaSerial + 1
    task = CreateObject("roSGNode", "AntennaTask")
    m.antennaTaskSerial = m.antennaSerial
    task.request = { kind: "refresh", serial: m.antennaSerial, typed: settings.antennaAddress, mpeg2: m.caps.mpeg2 and AntennaConfig.playMPEG2, guide: wantsGuide, manual: manual, guideHours: m.caps.guideHours, previous: m.antenna.channels }
    task.observeField("lineupResult", "onAntennaLineup")
    task.observeField("result", "onAntennaResult")
    m.antennaTask = task
    ' Discovery (1.5 s, then hdhomerun.local's 2 s) and the lineups (5 s each); then antennaGuideWatchdogSeconds.
    m.antennaWatchdog.duration = 90
    m.antennaWatchdog.control = "start"
    task.control = "run"
    refreshSettings()
end sub

' The download's worst case, plus room: the XMLTV's 180 s; the JSON's 12 pages of 30 s, after up to 16 tuners'
' discover.json (2 s each) (security L-1: above about 507 s).
function antennaGuideWatchdogSeconds() as integer
    if AntennaConfig.guideFormat = "json" then return 600
    return 300
end function

' A guide download that waited (a guide run, or an abandoned task) may go now.
sub antennaGuideMayGo()
    if not m.antennaGuidePending.wanted or m.antennaTask <> invalid then return
    if not GuideRuns.antennaMayDownload(m.guideTask <> invalid, m.abandonedGuideTask <> invalid, abandonedAntennaState()) then return
    manual = m.antennaGuidePending.manual
    loadAntenna(manual)
end sub

' { alive, wantedGuide } for an AntennaTask the watchdog or a setting gave up on, else invalid.
function abandonedAntennaState() as dynamic
    task = m.abandonedAntennaTask
    if task = invalid then return invalid
    return { alive: not isFinishedTask(task), wantedGuide: m.abandonedAntennaWantedGuide }
end function

' Security L-1: a task given up on may still write the guide file: kept until its state reads stop or done.
sub abandonAntennaTask(task as object)
    task.unobserveField("lineupResult")
    task.unobserveField("result")
    task.control = "stop"
    if not isFinishedTask(task) and m.antennaGuideDownloading
        if m.abandonedAntennaTask <> invalid then m.abandonedAntennaTask.unobserveField("state")
        m.abandonedAntennaTask = task
        m.abandonedAntennaWantedGuide = true
        task.observeField("state", "onAbandonedAntennaTaskState")
    end if
    m.antennaGuideDownloading = false
end sub

sub onAbandonedAntennaTaskState()
    task = m.abandonedAntennaTask
    if task = invalid then return
    if not isFinishedTask(task) then return
    task.unobserveField("state")
    m.abandonedAntennaTask = invalid
    m.abandonedAntennaWantedGuide = false
    refreshGuideIfDue()
    antennaGuideMayGo()
end sub

sub onAntennaWatchdog()
    task = m.antennaTask
    if task = invalid then return
    m.antennaTask = invalid
    Log.error("Antenna", "No answer from the antenna task; keeping the antenna channels there are")
    abandonAntennaTask(task)
    m.antennaAnswered = true
    resolveLaunch()
    antennaRunEnded()
end sub

' D36: the lineup's answer, before any download: the channels, the launch, a waiting retry. The watchdog now waits for
' the download.
sub onAntennaLineup()
    task = m.antennaTask
    if task = invalid then return
    answer = task.lineupResult
    ' Round 2: only the tracked run's own answer.
    if not isTrackedAnswer(answer) then return
    task.unobserveField("lineupResult")
    if m.store.settings.antennaEnabled
        if PlayerSession.isTrue(answer.ok) then applyAntennaLineup(answer)
    end if
    if m.antennaGuideDownloading
        m.antennaWatchdog.control = "stop"
        m.antennaWatchdog.duration = antennaGuideWatchdogSeconds()
        m.antennaWatchdog.control = "start"
    end if
    m.antennaAnswered = true
    resolveLaunch()
    ' D43: a retry waits for a lineup answer from a run that started after its diagnosis.
    retryAntennaChannel(answer.serial)
    refreshSettings()
end sub

function isTrackedAnswer(answer as dynamic) as boolean
    if type(answer) <> "roAssociativeArray" then return false
    if not Refresh.isNumber(answer.serial) then return false
    return answer.serial = m.antennaTaskSerial
end function

sub onAntennaResult()
    task = m.antennaTask
    if task = invalid then return
    if not isTrackedAnswer(task.result) then return
    task.unobserveField("lineupResult")
    task.unobserveField("result")
    m.antennaTask = invalid
    m.antennaWatchdog.control = "stop"
    result = task.result
    if type(result) = "roAssociativeArray" and m.store.settings.antennaEnabled
        guide = result.guide
        if type(guide) = "roAssociativeArray"
            if PlayerSession.isTrue(guide.ran)
                m.antennaGuideOutcome = { ran: true, ok: PlayerSession.isTrue(guide.ok), message: guide.message }
                if PlayerSession.isTrue(guide.ok) then m.guideRuns = GuideRuns.overridesChanged(m.guideRuns)
            end if
        end if
    end if
    m.antennaGuideDownloading = false
    if not m.antennaAnswered
        m.antennaAnswered = true
        resolveLaunch()
    end if
    antennaRunEnded()
end sub

' After the download (or the watchdog): the guide runs that waited, a run asked for meanwhile, Settings.
sub antennaRunEnded()
    m.antennaRunIsFind = false
    refreshGuideIfDue()
    if m.antennaPending.run
        manual = m.antennaPending.manual
        m.antennaPending = { run: false, manual: false }
        loadAntenna(manual)
    else
        antennaGuideMayGo()
    end if
    refreshSettings()
end sub

' A lineup answer. No tuner answering once keeps the channels (a tuner missing for one search, as when it reboots);
' twice in a row, they go. D37: a changed payload (a stream URL, a tuner count) merges the new antenna part into
' m.channels off the render thread; a changed id/name set also rematches the guides (GuideRuns' rematch: nothing is
' downloaded again).
sub applyAntennaLineup(answer as object)
    a = m.antenna
    a.lastLoad = UpTime(0)
    devices = listOr(answer.devices)
    previousCount = a.devices.Count()
    a.devices = devices
    a.typedProblem = answer.typedProblem
    if devices.Count() = 0 and a.channels.Count() > 0 and a.misses = 0
        a.misses = 1
        ' MMTVL's noneAnswered: the tuners known before didn't answer this search.
        if m.antennaRunIsFind then a.findLine = "No HDHomeRun answered"
        Log.info("Antenna", "No tuner answered; keeping its channels until the next search")
        return
    end if
    if devices.Count() = 0 then a.misses = a.misses + 1 else a.misses = 0
    ' D42: Find Tuners' line is its own run's; a change in the tuners found clears an older one.
    if m.antennaRunIsFind
        a.findLine = antennaFindLine(devices.Count())
    else if devices.Count() <> previousCount
        a.findLine = ""
    end if
    a.leftOut = answer.leftOut
    a.mpeg2Hidden = answer.mpeg2Hidden
    a.lineupFailed = answer.lineupFailed
    change = Lineup.antennaChange({ matchKey: a.matchKey, payloadKey: a.payloadKey }, answer)
    if change.merge
        a.channels = listOr(answer.channels)
        a.matchFields = listOr(answer.matchFields)
        a.teamFields = listOr(answer.teamFields)
        a.payloadKey = PlayerSession.textOr(answer.payloadKey)
        m.antennaRevision = m.antennaRevision + 1
        startMerge()
    end if
    if change.rematch
        a.matchKey = PlayerSession.textOr(answer.matchKey)
        m.guideRuns = GuideRuns.overridesChanged(m.guideRuns)
    end if
end sub

function listOr(value as dynamic) as object
    if type(value) = "roArray" then return value
    return []
end function

' MMTVL's antennaFindLine.
function antennaFindLine(count as integer) as string
    if count = 1 then return "Found 1 tuner"
    if count > 1 then return "Found " + count.ToStr() + " tuners"
    return "No HDHomeRun found on this network"
end function

' The playlist gone (Change Playlist URL, Remove Live TV Source): the antenna's part alone, made here (antenna-sized:
' at most its few hundred channels), until the next load merges again.
sub applyAntennaOnly()
    merged = Lineup.mergeParts({}, antennaPart())
    m.mergePending = false
    m.playlistAntennaRevision = m.antennaRevision
    m.channels = merged.channels
    m.playlistCount = 0
    m.guideChannelFields = merged.matchFields
    m.teamFields = merged.teamFields
    if merged.matchFields.Count() = 0 then m.guideState.channelsKey = invalid else m.guideState.channelsKey = GuideSources.channelsKey(merged.matchFields)
    m.teamsTask.channels = merged.teamFields
    rebuildLineup()
    updatePlayback()
    if merged.channels.Count() > 0 then requestTeams()
end sub

' Use Antenna or Guide from SiliconDust changed (Settings or an import). Off: the channels go (and the launch no
' longer waits); on: a search now. Either way the guides match again. Turning the guide off forgets when it's next
' due, so turning it on downloads it (MMTVL: due again once it's back; the hour's limit still holds).
sub antennaSettingsChanged()
    settings = m.store.settings
    m.antennaGuideOutcome = invalid
    if not settings.antennaGuide or not settings.antennaEnabled
        m.fs.Delete(AntennaConfig.guideDuePath)
        m.antennaGuidePending = { wanted: false, manual: false }
    end if
    if not settings.antennaEnabled
        task = m.antennaTask
        if task <> invalid
            m.antennaTask = invalid
            m.antennaWatchdog.control = "stop"
            abandonAntennaTask(task)
        end if
        m.antennaPending = { run: false, manual: false }
        m.antennaAnswered = true
        hadChannels = m.antenna.channels.Count() > 0
        m.antenna = newAntennaState()
        if hadChannels
            m.antennaRevision = m.antennaRevision + 1
            startMerge()
        end if
        resolveLaunch()
    else
        ' Round 2: a launch (an import's) waits for the antenna's lineup again, as at init.
        if m.launchPending then m.antennaAnswered = false
        loadAntenna(false)
    end if
    m.guideRuns = GuideRuns.overridesChanged(m.guideRuns)
    refreshGuideIfDue()
end sub

' Find Tuners: a search now, or right after the one going (D38); its line is that search's.
sub findTuners()
    if not m.store.settings.antennaEnabled then return
    m.antenna.findLine = ""
    m.antennaFindWanted = true
    loadAntenna(false)
end sub

' The keyboard's text for Settings → Antenna → Address: "" forgets it; else a LAN IPv4 literal only
' (SettingsEdits.checkTunerAddress; AntennaTask checks it again). Never logged or shown.
sub applyTypedTunerAddress(typed as string)
    checked = SettingsEdits.checkTunerAddress(typed, URLPolicy.deviceAddresses())
    typed = ""
    if not checked.ok
        settingsMessage("antennaAddress", checked.message)
        return
    end if
    settings = SettingsEdits.copied(m.store.settings)
    settings.antennaAddress = checked.address
    if not saveSetting("settings", settings) then return
    settingsMessage("antennaAddress", "")
    if checked.address = "" then Log.info("Settings", "Tuner address forgotten") else Log.info("Settings", "Tuner address set")
    m.antenna.typedProblem = ""
    loadAntenna(false)
    updateSettingsModel()
end sub

' What Settings → Antenna shows (SettingsStatus.antennaOf's input): names, models, counts and lines only.
' "Searching…" (D42) only for Find Tuners' own search, or while no tuner is known.
function antennaSettingsInput() as object
    settings = m.store.settings
    updated = ""
    times = invalid
    if m.fs.Exists(AntennaConfig.guideTimePath) then times = ReadAsciiFile(AntennaConfig.guideTimePath)
    if PlayerSession.isText(times)
        seconds = Val(times.Trim(), 10)
        if seconds > 0 then updated = clockText(Int(seconds))
    end if
    searching = m.antennaTask <> invalid and (m.antennaRunIsFind or m.antennaFindWanted or m.antenna.devices.Count() = 0)
    return {
        enabled: settings.antennaEnabled,
        guideOn: settings.antennaGuide,
        searching: searching,
        devices: m.antenna.devices,
        channelCount: m.antenna.channels.Count(),
        leftOut: m.antenna.leftOut,
        mpeg2Hidden: m.antenna.mpeg2Hidden,
        lineupFailed: m.antenna.lineupFailed,
        typedProblem: m.antenna.typedProblem,
        addressSet: settings.antennaAddress <> "",
        findLine: m.antenna.findLine,
        guide: { row: m.antennaGuideRow, outcome: m.antennaGuideOutcome, updated: updated, loading: m.antennaTask <> invalid and m.antennaGuideDownloading and m.antennaGuideRow = invalid }
    }
end function

' --- step 21: a failed antenna stream -----------------------------------------------------------------------------

' The player's Video error on an antenna channel: AntennaTask asks the tuner why (status.json, lineup_status.json;
' no tuner taken) and the error panel says it (MMTVL L9). A stall (no picture) asks too, with no numbers.
sub onPlayerFailure()
    failure = m.player.failure
    if type(failure) <> "roAssociativeArray" then failure = {}
    diagnoseAntennaChannel(failure.httpStatus, failure.tunerError)
end sub

sub diagnoseAntennaChannel(httpStatus as dynamic, tunerError as dynamic)
    channel = m.currentChannel
    if channel = invalid or not Lineup.isAntenna(channel) then return
    if m.antennaDiagnosis <> invalid then m.antennaDiagnosis.unobserveField("result")
    task = CreateObject("roSGNode", "AntennaTask")
    m.antennaSerial = m.antennaSerial + 1
    task.request = { kind: "diagnose", serial: m.antennaSerial, channelID: channel.id, url: channel.url, tunerCount: channel.tunerCount, httpStatus: httpStatus, tunerError: tunerError, codecUnknown: PlayerSession.isTrue(channel.codecUnknown), mpeg2: m.caps.mpeg2 and AntennaConfig.playMPEG2 }
    task.observeField("result", "onAntennaDiagnosis")
    m.antennaDiagnosis = task
    task.control = "run"
end sub

sub onAntennaDiagnosis()
    task = m.antennaDiagnosis
    if task = invalid then return
    task.unobserveField("result")
    m.antennaDiagnosis = invalid
    result = task.result
    if type(result) <> "roAssociativeArray" then return
    if not PlayerSession.isTrue(result.ok) or m.currentChannel = invalid then return
    if result.channelID <> m.currentChannel.id or not m.player.failed then return
    m.player.errorMessage = result.message
    ' MMTVL's diagnose: the tuner not answering (a search) or the channel gone from it (the lineup again), once.
    problem = result.problem
    if (problem = "unreachable" or problem = "unknownChannel") and m.antennaRetriedID <> result.channelID
        ' D43: the run that starts now (or after the one going) is the first that can see the new address.
        m.antennaRetry = { id: result.channelID, minSerial: m.antennaSerial + 1 }
        loadAntenna(false)
    end if
end sub

' D35, D43, D44: after the search or lineup read asked for by onAntennaDiagnosis answered (a lineup answer from a
' run that started after it), the channel is played again in place (PlayerSession.retryAction: the player wherever
' it shows, full screen or in the guide's preview; the screen never changes), with the antenna part's fresh copy
' (its new address, if it moved), when it still fails. Under Settings it waits for closeSettings.
sub retryAntennaChannel(answerSerial as dynamic)
    retry = m.antennaRetry
    if retry = invalid then return
    fresh = PlayerSession.channelByID(m.antenna.channels, retry.id)
    decision = PlayerSession.retryAction(retry, m.currentChannel, m.player.failed, fresh, m.screen, answerSerial)
    if decision.keep then return
    m.antennaRetry = invalid
    if not decision.replay then return
    Log.info("Antenna", "Trying the antenna channel once more")
    m.currentChannel = fresh
    m.antennaRetriedID = decision.channelID
    m.player.channel = PlayerSession.playerItem(fresh, playerLogo(fresh))
    updatePlayback()
end sub
